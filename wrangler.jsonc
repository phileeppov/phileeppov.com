// Config for Workers Builds: the name is the existing Worker, static assets are dist/.
// Values match the Cloudflare dashboard as of 20.10.2026, so deploys from GitHub change nothing there.
{
  "name": "phileeppov",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker handles only /api/* (the form and the /glass event counter); everything else is served from static assets and _redirects without invoking it.
    "run_worker_first": ["/api/*"]
  },
  // Form emails go only to the verified Email Routing address.
  "send_email": [{ "name": "MAIL", "destination_address": "phileeppov@gmail.com" }],
  // /glass event counter (downloads, Share, presets, knobs, links): D1 database glass-events, created 22.10.2026.
  "d1_databases": [
    { "binding": "EVENTS", "database_name": "glass-events", "database_id": "9ea9422c-be05-4e08-89e7-46c2285f28f3" }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "phileeppov.com", "custom_domain": true },
    { "pattern": "www.phileeppov.com", "custom_domain": true }
  ]
}
