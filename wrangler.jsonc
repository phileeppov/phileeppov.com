// Конфиг для Workers Builds: имя — существующий Worker, статика — dist/.
// Значения повторяют панель Cloudflare на 20.10.2026, чтобы деплой из GitHub ничего в ней не менял.
{
  "name": "phileeppov",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker отвечает только за форму; всё остальное — статика и _redirects без него.
    "run_worker_first": ["/api/*"]
  },
  // Письма с формы — только на подтверждённый адрес Email Routing.
  "send_email": [{ "name": "MAIL", "destination_address": "phileeppov@gmail.com" }],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "phileeppov.com", "custom_domain": true },
    { "pattern": "www.phileeppov.com", "custom_domain": true }
  ]
}
