---
// The passage: the pages of the site are one object you move through, not four documents. A link opens the next page
// as a disc of emerald glass growing from the arrow that was pressed; going back closes the page into the same arrow.
// Cross-document View Transitions (Chromium, Safari 18.2+; elsewhere the page simply changes).
//
// The disc: the new page is the old snapshot's replacement inside a growing circle (clip-path on the transition's own
// pseudo-elements). It comes out of the arrow at the size of the brand's lens, stays there a moment, so the glass is
// seen as a thing, then opens. Its rim is cut like the stone on the arrow (src/scripts/emerald.js): a clear table in the
// middle and three steps round it, each a band of glass that pushes the page under it out by its own amount, the outer
// step the most, so the letters break at every junction. Each step is a copy of the page, scaled about the origin and
// masked to its ring. The glass is the stone's own colour (the same absorption, Beer-Lambert through the thickness of
// each step), the steps carry the bright and dark bands of the room round the stone, the hall of mirrors, and only the
// outer step parts the colours, by as little as beryl does: a warm and a cool copy a pixel apart, softened, never red
// and blue. The spectrum falls on the surface beside it, a soft arc on the side away from the light, never a ring. The
// stone on the pressed arrow is lifted out of the old page and held over the change, then settles.
//
// Only where heavy effects run (wide screen, fine pointer, hover, no reduced motion). Anywhere else that has the
// transitions: a 160ms cross-fade. Reduced motion: no transition at all.
//
// The script is inline and in the head: "pagereveal" fires before the new page's first frame, so its listener has to
// be there before the body is parsed. The link with blocking="render" holds that first frame until the footer is
// parsed, so the page the disc reveals (and its copies in the rim) is the whole page.
---

<link rel="expect" href="#site-end" blocking="render" />
<script is:inline>
  (() => {
    const HEAVY = "(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)";
    const KEY = "passage:";
    // Opening: out of the arrow to the lens, held there, then open. Going back: in from the far corner to the lens,
    // held, then folded into the arrow. In ms.
    const GROW = 150, HOLD = 90, SWEEP = 380;
    const SHUT = 300, REST = 90, FOLD = 150;
    const LENS = [96, 110]; // px, the radius the disc holds as a lens (the brand's lens is 100), drifting a little
    // The steps, from the edge in: where each begins and ends (fractions of the rim), how far it moves the page at the
    // edge (px), how thick the glass is there (the stone's units). The outer step is the thickest and bends the most.
    const STEPS = [
      { f: [0, 0.3], a: 24, d: 0.3, split: 1 },
      { f: [0.3, 0.64], a: 14, d: 0.17 },
      { f: [0.64, 1], a: 6, d: 0.08 },
    ];
    const DEEP = 0.7; // the dark streaks: where a facet sends back the stone's own depth
    // The stone's absorption per channel (emerald.js: red goes fast, blue a little faster than green).
    const SIG = [3.4, 0.62, 1.15];
    const srgb = (l) => Math.round(255 * (l <= 0.0031308 ? 12.92 * l : 1.055 * l ** (1 / 2.4) - 0.055));
    const body = (d) => "rgb(" + SIG.map((s) => srgb(Math.exp(-s * d))).join(" ") + ")";

    // A cubic-bezier easing as a function of time, for sampling the frames the disc and its rim share.
    const bezier = (x1, y1, x2, y2) => {
      const c = (a, b, t) => ((1 - 3 * b + 3 * a) * t + (3 * b - 6 * a)) * t * t + 3 * a * t;
      return (x) => {
        let lo = 0, hi = 1, t = x;
        for (let i = 0; i < 24; i++) { t = (lo + hi) / 2; if (c(x1, x2, t) < x) lo = t; else hi = t; }
        return c(y1, y2, t);
      };
    };
    const out3 = (t) => 1 - (1 - t) ** 3;
    const easeSweep = bezier(0.55, 0, 0.25, 1); // the lens lets go, then slows while the rim crosses the last of the screen
    const easeShut = bezier(0.3, 0.1, 0.2, 1); // in from the far corner at once, slowing into the lens
    const easeFold = bezier(0.45, 0, 0.3, 1); // folded into the arrow, so you see it land

    // ---------- the page being left: where the link was pressed ----------
    let origin = null;
    // The point the disc grows from: the arrow, where the emerald stone stands; on the wordmark, its slot. A link that
    // lends itself to another's stone (data-gem-to: a case's picture) opens from that link's arrow.
    const pointOf = (a, e) => {
      if (a.dataset.gemTo) a = document.getElementById(a.dataset.gemTo) || a;
      const g = a.querySelector(".arw") || (a.classList.contains("mark") && a.querySelector("i"));
      if (g) { const r = g.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height * 0.54]; }
      const r = a.getBoundingClientRect();
      if (a.hasAttribute("data-gem")) {
        const L = Math.min(28, parseFloat(getComputedStyle(a).fontSize) * 1.2);
        return [r.right + 4 + L / 2, r.top + r.height * 0.54];
      }
      if (e.detail) return [e.clientX, e.clientY];
      return [r.left + r.width / 2, r.top + r.height / 2];
    };
    addEventListener("click", (e) => {
      const a = e.target.closest && e.target.closest("a[href]");
      origin = a && !a.target ? pointOf(a, e) : null;
      if (origin && e.detail) sessionStorage.setItem(KEY + "ptr", JSON.stringify({ x: e.clientX, y: e.clientY, t: Date.now() }));
    }, true);

    const back = (act) => act && act.navigationType === "traverse" && act.from && act.entry && act.entry.index < act.from.index;

    addEventListener("pageswap", (e) => {
      if (!e.viewTransition) return;
      const act = e.activation;
      if (!back(act) && origin && act && act.entry) {
        const to = new URL(act.entry.url).pathname;
        sessionStorage.setItem(KEY + to, JSON.stringify({ x: origin[0], y: origin[1], sy: scrollY, from: location.pathname }));
      }
      // The stone on the pressed arrow and the cursor are lifted out of the page and held over the change.
      if (matchMedia(HEAVY).matches && !back(act)) {
        for (const c of document.querySelectorAll("canvas[data-layer]")) c.style.viewTransitionName = "pz-" + c.dataset.layer;
      }
    });
    // A page restored from the back-forward cache must not bring the names back into the next passage.
    addEventListener("pageshow", () => {
      for (const c of document.querySelectorAll("canvas[data-layer]")) c.style.viewTransitionName = "";
    });

    // ---------- the page arriving ----------
    addEventListener("pagereveal", (e) => {
      const vt = e.viewTransition;
      if (!vt) return;
      if (!matchMedia(HEAVY).matches) { vt.types.add("pz-plain"); return; }
      const act = typeof navigation !== "undefined" ? navigation.activation : null;
      const closing = back(act);
      // Where it opened: stored under the page the link led to. Going back, that's the page being left.
      const key = closing ? new URL(act.from.url).pathname : location.pathname;
      let o = null;
      try { o = JSON.parse(sessionStorage.getItem(KEY + key) || "null"); } catch {}
      const W = document.documentElement.clientWidth, H = innerHeight;
      let x, y;
      if (o && closing && o.from === location.pathname) { x = o.x; y = o.y + o.sy - scrollY; }
      else if (o && !closing && act && act.from && new URL(act.from.url).pathname === o.from) { x = o.x; y = o.y; }
      else {
        // No pressed point (a page reached another way): from the wordmark's slot.
        const i = document.querySelector(".mark i");
        const r = i ? i.getBoundingClientRect() : { left: 24, top: 16, width: 16, height: 18 };
        x = r.left + r.width / 2; y = r.top + r.height * 0.54;
      }
      x = Math.max(0, Math.min(W, x)); y = Math.max(0, Math.min(H, y));
      const far = Math.max(Math.hypot(x, y), Math.hypot(W - x, y), Math.hypot(x, H - y), Math.hypot(W - x, H - y));
      // The disc stops as soon as the rim and the spectrum are past the farthest corner. The light travels with it:
      // the edge catches it and the spectrum falls ahead of the rim, toward that corner, where the rim stays longest.
      const R = closing ? far + 2 : far + 50;
      const corner = [[0, 0], [W, 0], [0, H], [W, H]].sort((a, b) => Math.hypot(b[0] - x, b[1] - y) - Math.hypot(a[0] - x, a[1] - y))[0];
      const ang = (Math.atan2(corner[0] - x, -(corner[1] - y)) * 180) / Math.PI;
      vt.types.add(closing ? "pz-close" : "pz-open");
      const root = document.documentElement;
      const props = {
        "--pz-x": x + "px", "--pz-y": y + "px", "--pz-r0": closing ? R + "px" : "0px", "--pz-a": ang.toFixed(1) + "deg",
        "--pz-deep": body(DEEP),
      };
      STEPS.forEach((s, i) => { props["--pz-t" + i] = body(s.d); });
      for (const p in props) root.style.setProperty(p, props[p]);

      // The rim: one copy of this page per step (two for the outer one, warm and cool), each pushed out from the
      // origin by its own amount, tinted by the glass, masked to its ring.
      const pz = document.createElement("div");
      pz.className = "pz " + (closing ? "pz-in" : "pz-out");
      pz.setAttribute("aria-hidden", "true");
      pz.inert = true;
      const src = document.querySelectorAll("body > header, body > main, body > footer");
      const copyOf = () => {
        const copy = document.createElement("div");
        copy.className = "pz-copy";
        copy.style.top = -scrollY + "px";
        copy.style.width = W + "px";
        for (const n of src) copy.append(n.cloneNode(true));
        for (const img of copy.querySelectorAll("img")) img.loading = "eager";
        // The copies are pictures only: no ids, nothing the page's own scripts look for (the stamp, the stones).
        for (const n of copy.querySelectorAll("[id]")) n.removeAttribute("id");
        for (const n of copy.querySelectorAll("svg.stamp, script")) n.remove();
        for (const n of copy.querySelectorAll("[data-gem], [data-stamp-host], [data-count]")) { n.removeAttribute("data-gem"); n.removeAttribute("data-stamp-host"); n.removeAttribute("data-count"); }
        return copy;
      };
      const moving = []; // [element, step, part of the colour split]
      STEPS.forEach((s, i) => {
        const st = document.createElement("div");
        st.className = "pz-st pz-s" + i;
        st.style.setProperty("--f0", s.f[0]);
        st.style.setProperty("--f1", s.f[1]);
        for (const part of s.split ? [-1, 1] : [0]) {
          const ch = document.createElement("div");
          ch.className = "pz-ch" + (part < 0 ? " pz-warm" : part > 0 ? " pz-cool" : "");
          ch.append(copyOf());
          st.append(ch);
          moving.push([ch, s, part]);
        }
        const tint = document.createElement("div");
        tint.className = "pz-tint";
        st.append(tint);
        pz.append(st);
      });
      for (const c of ["pz-seams", "pz-hi", "pz-lo"]) {
        const d = document.createElement("div");
        d.className = c;
        pz.append(d);
      }
      // The spectrum lies on the page beside the glass: its own layer, multiplied onto whatever is under it.
      const sp = document.createElement("div");
      sp.className = "pz-spec " + (closing ? "pz-in" : "pz-out");
      sp.setAttribute("aria-hidden", "true");
      document.body.append(pz, sp);

      // The radius at each moment, and from it one set of frames for the disc, the rim, the steps and the colours,
      // so they can't drift apart.
      const T = closing ? SHUT + REST + FOLD : GROW + HOLD + SWEEP;
      const radius = (ms) => {
        if (closing) {
          if (ms < SHUT) return R - (R - LENS[1]) * easeShut(ms / SHUT);
          if (ms < SHUT + REST) return LENS[1] - (LENS[1] - LENS[0]) * ((ms - SHUT) / REST);
          return LENS[0] * (1 - easeFold(Math.min(1, (ms - SHUT - REST) / FOLD)));
        }
        if (ms < GROW) return LENS[0] * out3(ms / GROW);
        if (ms < GROW + HOLD) return LENS[0] + (LENS[1] - LENS[0]) * ((ms - GROW) / HOLD);
        return LENS[1] + (R - LENS[1]) * easeSweep(Math.min(1, (ms - GROW - HOLD) / SWEEP));
      };
      const N = Math.round(T / 8);
      const disc = [], rim = [], frames = moving.map(() => []);
      for (let i = 0; i <= N; i++) {
        const t = i / N, r = radius(t * T);
        disc.push({ clipPath: `circle(${r.toFixed(2)}px at ${x}px ${y}px)` });
        // The bands of light turn a little as the stone passes, so the facets read as cut, not painted.
        const turn = (closing ? 1 - t : t) * 26 - 12;
        rim.push({ "--pz-r": r.toFixed(2) + "px", "--pz-turn": turn.toFixed(2) + "deg" });
        const k = Math.max(r, 36);
        moving.forEach(([, s, part], j) => {
          // Beryl's dispersion: the warm copy bends a little less than the cool one.
          const m = Math.min(1.5, 1 + s.a / k) + (part * (s.split || 0)) / k;
          frames[j].push({ transform: `scale(${m.toFixed(5)})` });
        });
      }
      const timing = { duration: T, easing: "linear", fill: "both" };
      vt.ready.then(() => {
        root.animate(disc, { ...timing, pseudoElement: closing ? "::view-transition-old(root)" : "::view-transition-new(root)" });
        pz.animate(rim, timing);
        sp.animate(rim, timing);
        moving.forEach(([el], j) => el.animate(frames[j], timing));
      }).catch(() => {});
      vt.finished.finally(() => {
        pz.remove(); sp.remove();
        for (const p in props) root.style.removeProperty(p);
      });
    });
  })();
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }
  @property --pz-r {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }
  @property --pz-turn {
    syntax: "<angle>";
    inherits: true;
    initial-value: 0deg;
  }

  /* Without the heavy effects: the pages cross-fade, briefly. */
  ::view-transition-group(root) {
    animation-duration: 160ms;
  }

  /* The disc. Its frames come from the script; here only what holds before the first of them. */
  :root:active-view-transition-type(pz-open, pz-close)::view-transition-group(root),
  :root:active-view-transition-type(pz-open, pz-close)::view-transition-old(root),
  :root:active-view-transition-type(pz-open, pz-close)::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  :root:active-view-transition-type(pz-open)::view-transition-new(root) {
    clip-path: circle(0px at var(--pz-x) var(--pz-y));
  }
  :root:active-view-transition-type(pz-close)::view-transition-old(root) {
    z-index: 1;
  }

  /* The rim and the spectrum are layers of their own over both pages, drawn live, not as snapshots. */
  .pz,
  .pz-spec {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    pointer-events: none;
    --pz-r: var(--pz-r0);
    /* The rim: 28px, under a third of the disc while it is still smaller than that. */
    --pz-w: min(28px, var(--pz-r) * 0.3);
  }
  .pz {
    view-transition-name: pz-rim;
  }
  .pz-spec {
    view-transition-name: pz-spec;
  }
  ::view-transition-group(pz-rim),
  ::view-transition-group(pz-spec),
  ::view-transition-new(pz-rim),
  ::view-transition-new(pz-spec) {
    animation: none;
  }
  ::view-transition-group(pz-spec) {
    mix-blend-mode: multiply;
  }

  /* A step: opening, a ring just inside the disc's edge (the new page through the glass); closing, just outside it
     (the page coming back, seen through the glass as the old one shrinks away). Hard at both edges: cut, not blown. */
  .pz-st {
    position: absolute;
    inset: 0;
    overflow: clip;
    isolation: isolate;
    --e0: calc(var(--pz-w) * var(--f0));
    --e1: calc(var(--pz-w) * var(--f1));
  }
  .pz-out .pz-st {
    mask-image: radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) - var(--e1)), #000 calc(var(--pz-r) - var(--e1)), #000 calc(var(--pz-r) - var(--e0) - 0.5px), transparent calc(var(--pz-r) - var(--e0)));
  }
  .pz-in .pz-st {
    mask-image: radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) + var(--e0)), #000 calc(var(--pz-r) + var(--e0) + 0.5px), #000 calc(var(--pz-r) + var(--e1)), transparent calc(var(--pz-r) + var(--e1)));
  }
  /* The outer step is the thickest: what is seen through it is a touch soft. */
  .pz-s0 {
    filter: blur(0.35px);
  }
  /* One copy of the page in a step. In the outer one, a warm and a cool copy, multiplied by complementary colours
     and added back together: where they sit on each other, the page; where they part, a soft warm or cool edge. */
  .pz-ch {
    position: absolute;
    inset: 0;
    isolation: isolate;
    transform-origin: var(--pz-x) var(--pz-y);
    background: var(--color-bg);
    will-change: transform;
  }
  .pz-warm::after,
  .pz-cool::after {
    content: "";
    position: absolute;
    inset: -64px;
    mix-blend-mode: multiply;
  }
  .pz-warm::after {
    background: rgb(255 184 110);
  }
  .pz-cool::after {
    background: rgb(0 71 145);
  }
  .pz-cool {
    mix-blend-mode: plus-lighter;
  }
  /* The copy of the page: laid out as the body is, shifted by the scroll. */
  .pz-copy {
    position: absolute;
    left: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 16px 24px 24px;
  }
  .pz-copy > main {
    flex: 1;
    max-width: none;
  }
  /* The glass: the stone's colour through each step's thickness, a tint on what is behind, never a fill. Over it, the
     room round the stone, carried by the facets: thin bright and dark streaks on each step toward the one light, upper
     left, as on the stones, each step at its own angle, so they break at the junctions. */
  .pz-tint {
    position: absolute;
    inset: -64px;
    mix-blend-mode: multiply;
  }
  .pz-s0 .pz-tint {
    background: var(--pz-t0);
  }
  .pz-s1 .pz-tint {
    background: var(--pz-t1);
  }
  .pz-s2 .pz-tint {
    background: var(--pz-t2);
  }
  .pz-st::before,
  .pz-st::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    --o: 0deg;
  }
  .pz-st::before {
    mix-blend-mode: multiply;
    background: conic-gradient(from calc(var(--pz-turn) + var(--o) + 25deg) at var(--pz-x) var(--pz-y), transparent, var(--pz-deep) 2.4%, transparent 5.4%, transparent 50%, var(--pz-deep) 52%, transparent 54.5%);
  }
  .pz-st::after {
    background: conic-gradient(from calc(var(--pz-turn) + var(--o) - 52deg) at var(--pz-x) var(--pz-y), transparent, rgb(255 255 255 / 0.75) 1.6%, transparent 3.8%, transparent 50%, rgb(255 255 255 / 0.4) 51.4%, transparent 53%);
  }
  .pz-s1::before,
  .pz-s1::after {
    --o: 21deg;
  }
  .pz-s2::before,
  .pz-s2::after {
    --o: -16deg;
  }
  /* The junctions between the steps, 0.5px: dark on the inner side, light on the outer, so the steps read at 1x. */
  .pz-seams,
  .pz-hi,
  .pz-lo {
    position: absolute;
    inset: 0;
  }
  .pz-out .pz-seams {
    background:
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) - var(--pz-w) * 0.3 - 1px), rgb(0 0 0 / 0.14) calc(var(--pz-r) - var(--pz-w) * 0.3 - 0.5px), rgb(255 255 255 / 0.5) calc(var(--pz-r) - var(--pz-w) * 0.3), transparent calc(var(--pz-r) - var(--pz-w) * 0.3 + 0.75px)),
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) - var(--pz-w) * 0.64 - 1px), rgb(0 0 0 / 0.12) calc(var(--pz-r) - var(--pz-w) * 0.64 - 0.5px), rgb(255 255 255 / 0.6) calc(var(--pz-r) - var(--pz-w) * 0.64), transparent calc(var(--pz-r) - var(--pz-w) * 0.64 + 0.75px)),
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) - var(--pz-w) - 1px), rgb(0 0 0 / 0.2) calc(var(--pz-r) - var(--pz-w) - 0.5px), rgb(255 255 255 / 0.5) calc(var(--pz-r) - var(--pz-w)), transparent calc(var(--pz-r) - var(--pz-w) + 0.75px));
  }
  .pz-in .pz-seams {
    background:
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) + var(--pz-w) * 0.3 - 0.75px), rgb(255 255 255 / 0.5) calc(var(--pz-r) + var(--pz-w) * 0.3), rgb(0 0 0 / 0.14) calc(var(--pz-r) + var(--pz-w) * 0.3 + 0.5px), transparent calc(var(--pz-r) + var(--pz-w) * 0.3 + 1px)),
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) + var(--pz-w) * 0.64 - 0.75px), rgb(255 255 255 / 0.6) calc(var(--pz-r) + var(--pz-w) * 0.64), rgb(0 0 0 / 0.12) calc(var(--pz-r) + var(--pz-w) * 0.64 + 0.5px), transparent calc(var(--pz-r) + var(--pz-w) * 0.64 + 1px)),
      radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) + var(--pz-w) - 0.75px), rgb(255 255 255 / 0.5) calc(var(--pz-r) + var(--pz-w)), rgb(0 0 0 / 0.2) calc(var(--pz-r) + var(--pz-w) + 0.5px), transparent calc(var(--pz-r) + var(--pz-w) + 1px));
  }
  /* The edge of the glass, 0.5px: a dark line all round, as every raised thing on the site has, and a soft catch of
     light just inside it on the upper left, where the one light is. */
  .pz-hi {
    mask-image: conic-gradient(from -45deg at var(--pz-x) var(--pz-y), #000, rgb(0 0 0 / 0.4) 7%, transparent 15%, transparent 85%, rgb(0 0 0 / 0.4) 93%, #000);
  }
  .pz-out .pz-hi {
    background: radial-gradient(circle at var(--pz-x) var(--pz-y), transparent calc(var(--pz-r) - 6px), rgb(255 255 255 / 0.9) calc(var(--pz-r) - 1.25px), transparent calc(var(--pz-r) - 0.25px));
