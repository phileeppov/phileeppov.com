    start(1800);

    // The tabs switch between the kinds. With no product yet, the bar asks what it is and the note who it's for; each
    // kind keeps what was typed in it, and only the shown one is sent. The page's own text follows (review:mode).
    // Only the shown kind's fields are in the form.
    const lay = () =>
      root.querySelectorAll<HTMLElement>("[data-for]").forEach((el) => {
        const on = el.dataset.for === mode;
        el.hidden = !on;
        el.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((field) => (field.disabled = !on));
      });
    lay();
    const setMode = (next: Mode) => {
      if (next === mode) return;
      mode = next;
      lay();
      // A message about a field that's gone goes with it.
      root.querySelectorAll<HTMLElement>(".bar .err").forEach((message) => (message.hidden = true));
