      color: var(--ink);
    }
  }
  /* The tab icons: the product's dot, like the logo in the sketch, and a blank page for no product yet. */
  .tab i {
    flex: none;
    width: max(9px, 1cqi);
    height: max(9px, 1cqi);
  }
  .tab .fav {
