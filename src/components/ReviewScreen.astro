---
// The video review form on /review, drawn as the review itself: a screen whose address bar is the link field and whose
// sticky note is "What's stuck?"; under it, the contact field and SEND, like a player's dock. The product sketched in
// the screen follows the link — a website, a Figma file, a GitHub repo, an app, a doc — with the name taken from it.
// The review marks: the ring around what's stuck, the note and the reviewer's camera stay put; point 1 follows the name.
// Two kinds of request, two browser tabs over the address bar: a product that exists, or none yet — then the
// bar asks what it is, the note who it's for, and the sketch is a blank page waiting for the design.
// Copy: questions and states — site.md §1.6; the rest — §8. Submit: src/scripts/review-form.ts → worker/index.js.
---

<div class="review-screen" data-review>
  <form class="device" method="post" action="/api/review" data-review-form>
    <div class="screen" data-screen>
      <!-- The two kinds as browser tabs, sharing the strip like two open tabs do; the other one is a blank page. Once a
           link is in, the first tab takes the product's name, like a tab takes a page's title. -->
      <div class="tabs" role="radiogroup" aria-label="What you're sending">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <label class="tab"><input type="radio" name="mode" value="product" checked autocomplete="off" aria-label="I have a product" /><i class="fav" aria-hidden="true"></i><span data-tab-name>I have a product</span></label>
        <label class="tab"><input type="radio" name="mode" value="scratch" autocomplete="off" /><i class="page" aria-hidden="true"></i><span>No product yet</span></label>
      </div>
      <div class="bar">
        <!-- The address bar is the link field. The question sits in it like "https://" does and folds away once a link
             is in, so the link gets the whole bar. From scratch, it asks what it is instead. -->
        <label class="url" data-field data-for="product">
          <b>What's the link?</b>
          <input
            name="link"
            type="text"
            required
            maxlength="2000"
            autocomplete="url"
            inputmode="url"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="next"
            placeholder="url / Figma / App Store"
          />
          <span class="load" aria-hidden="true"></span>
        </label>
        <label class="url" data-field data-for="scratch" hidden>
          <b>What are you building?</b>
          <input name="what" type="text" required disabled maxlength="500" autocomplete="off" enterkeyhint="next" placeholder="e.g. a booking app for barbers" />
        </label>
        <span class="err" id="review-link-error" data-error-for="link" role="alert" hidden>Paste a link first.</span>
        <span class="err" id="review-what-error" data-error-for="what" role="alert" hidden>Add a few words first.</span>
      </div>
      <div class="sk" data-sk aria-hidden="true"></div>
      <span class="cta" aria-hidden="true"></span>
      <span class="pt" data-pt="1" aria-hidden="true"></span>
      <span class="pt" data-pt="2" aria-hidden="true"></span>
      <svg class="ring" viewBox="0 0 229 100" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M34,66 C16,42 50,10 116,9 C182,8 223,24 220,50 C217,79 168,94 110,93 C54,92 12,79 22,50 C27,36 46,28 66,24" />
      </svg>
      <!-- The sticky note is the "What's stuck?" field, pinned next to the circled button. The field is drawn on the
           note, so it reads as a place to write before anything is typed. From scratch, it asks who it's for. -->
      <div class="note">
        <label data-for="product">
          <b>What's stuck?</b>
          <span class="field"><textarea name="stuck" rows="2" maxlength="500" enterkeyhint="next" placeholder="e.g. people sign up, then leave"></textarea></span>
        </label>
        <label data-for="scratch" hidden>
          <b>Who's it for?</b>
          <span class="field"><textarea name="who" rows="2" maxlength="500" enterkeyhint="next" disabled autocomplete="off" placeholder="e.g. barbers who work alone"></textarea></span>
        </label>
      </div>
      <span class="cam" aria-hidden="true">
        <!-- The smile from the favicon, drawn, so it's the same mark everywhere. -->
        <i>
          <!-- The lids are the eyes closed, while the camera sleeps. -->
          <svg class="smile" viewBox="0 0 64 64"><circle cx="23.5" cy="26" r="3.8" /><circle cx="40.5" cy="26" r="3.8" /><path d="M20.5 37.5 Q32 49.5 43.5 37.5" /><path class="lid" d="M19.8 25.2 Q23.5 29.4 27.2 25.2" /><path class="lid" d="M36.8 25.2 Q40.5 29.4 44.2 25.2" /></svg>
          <!-- After SEND: one emerald sweep around the camera, like a recording starting. -->
          <svg class="rec" viewBox="0 0 100 100"><path pathLength="1" d="M50 2a48 48 0 1 1 0 96a48 48 0 1 1 0-96" /></svg>
        </i>
        <span>Nikita</span>
        <!-- The recording light over the camera, with the time running: the script fills it in. -->
        <b class="tally" data-tally></b>
      </span>
    </div>

    <div class="dock" data-hide-on-sent>
      <label for="review-contact">How do I get back to you?</label>
      <input id="review-contact" name="contact" type="text" required maxlength="200" autocomplete="email" placeholder="email or @telegram" enterkeyhint="send" />
      <span class="err" id="review-contact-error" data-error-for="contact" role="alert" hidden>Add an email or @telegram.</span>
      <button type="submit">SEND</button>
    </div>
    <!-- Bot trap: not rendered, so neither a person nor browser autofill fills it in; bots fill every field. -->
    <input class="trap" name="message" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="t" value="" />
    <p class="below" data-hide-on-sent><span data-for="product">Behind a login? I'll register, or ask for a&nbsp;test&nbsp;account.</span><span data-for="scratch" hidden>Got slides, Figma or Notion? Paste a link after the&nbsp;words, or send it later.</span><br /> Private. Nothing gets posted without your OK.</p>
    <p class="error" data-state="error" role="alert" hidden>That didn't go through. Write to <a href="mailto:nikita@phileeppov.com">nikita@phileeppov.com</a> instead.</p>
    <div class="done" tabindex="-1" aria-live="polite" data-done>
      <p data-state="sent" hidden>Got it. I'll send the review to <span data-contact>[contact]</span>.</p>
      <p data-state="next" hidden>Got it. This week is full, so I'll send the review to <span data-contact>[contact]</span> next week.</p>
      <p data-state="later" hidden>Got it. There's a queue, so I'll send the review to <span data-contact>[contact]</span> the week of <span data-week>[date]</span>.</p>
    </div>
    <!-- No confirmation email goes out, so this is the thread to add slides or a test login after sending. -->
    <p class="done-note" data-show-on-sent hidden>Anything to add? Write to <a href="mailto:nikita@phileeppov.com">nikita@phileeppov.com</a>.</p>
  </form>
</div>

<script>
  import { wireReviewForm } from "../scripts/review-form";
  import { count } from "../scripts/review-count";

  type Mode = "product" | "scratch";
  type Read = { type: "web" | "figma" | "github" | "app" | "doc" | "idea" | "self" | "glass" | "x"; name: string; owner?: string; store?: string };

  // Links to a platform rather than a product: no name to take, so the sketch stays plain.
  const PLATFORMS = /(^|\.)(loom\.com|youtube\.com|youtu\.be|vimeo\.com|dropbox\.com|canva\.com|miro\.com|framer\.com|webflow\.com|linkedin\.com|t\.me)$/;
  // X's own pages, not somebody's: no handle in them. A handle is up to 15 letters, digits and underscores.
  const X_PAGES = /^(i|home|explore|search|settings|notifications|messages|intent|share|hashtag|compose|login|signup|logout|tos|privacy|jobs|download|account|communities)$/i;
  const X_HANDLE = /^\w{1,15}$/;
  const words = (s: string) => {
    try {
      return decodeURIComponent(s).replace(/[-_+]+/g, " ").trim();
    } catch {
      return s.replace(/[-_+]+/g, " ").trim();
    }
  };
  const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);
  const short = (s: string, n = 24) => (s.length > n ? s.slice(0, n - 1).trimEnd() + "…" : s);

  // What the link is, and the product's name in it.
  function read(raw: string): Read {
    const v = raw.trim();
    if (!v) return { type: "web", name: "" };
    let u: URL;
    try {
      u = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
    } catch {
      return { type: "web", name: "" };
    }
    const host = u.hostname.replace(/^www\./, "").toLowerCase();
    const parts = u.pathname.split("/").filter(Boolean);
    if (host.endsWith("figma.com")) return { type: "figma", name: parts[2] ? short(words(parts[2])) : "" };
    if (host === "github.com") return { type: "github", owner: short(parts[0] ?? "", 18), name: short(parts[1] ?? parts[0] ?? "", 20) };
    if (host === "apps.apple.com") {
      const i = parts.indexOf("app");
      return { type: "app", store: "App Store", name: i >= 0 && parts[i + 1] ? short(cap(words(parts[i + 1]).split(" ").slice(0, 3).join(" "))) : "" };
    }
    if (host === "play.google.com") return { type: "app", store: "Google Play", name: short(cap(u.searchParams.get("id")?.split(".").pop() ?? "")) };
    if (host === "testflight.apple.com") return { type: "app", store: "TestFlight", name: "" };
    if (host.endsWith("notion.site") || host.endsWith("notion.so")) {
      const last = parts[parts.length - 1] ?? "";
      return { type: "doc", name: short(cap(words(last.replace(/-?[0-9a-f]{32}$/i, "")))) };
    }
    if (host === "docs.google.com" || host === "drive.google.com") return { type: "doc", name: "" };
    // This very page sent to itself: the screen draws the review page, a review of the review.
    if (host === "phileeppov.com" && parts[0] === "review") return { type: "self", name: "Phileeppov" };
    // The site's other page: /glass draws as itself, the smile under glass.
    if (host === "phileeppov.com" && parts[0] === "glass") return { type: "glass", name: "Glass" };
    // A link to X draws a post, with the handle from the link (x.com/name or x.com/@name); X's other sites (help.x.com),
    // its pages under a language (x.com/en/tos) and its short links (t.co) draw it with none.
    if (/(^|\.)(x|twitter)\.com$/.test(host) || host === "t.co") {
      const handle = (parts[0] ?? "").replace(/^@/, "");
      const own = /^((mobile|m)\.)?(x|twitter)\.com$/.test(host) && X_HANDLE.test(handle) && !X_PAGES.test(handle) && !X_PAGES.test(parts[1] ?? "");
      return { type: "x", name: own ? `@${handle}` : "" };
    }
    if (PLATFORMS.test(host)) return { type: "web", name: "" };
    // A product behind a login usually lives on a subdomain (app.drawline.io): the name is the next part.
    const labels = host.split(".");
    const label = labels.length > 2 && /^(app|my|go|web|dashboard|admin|portal|beta)$/.test(labels[0]) ? labels[1] : labels[0];
    return { type: "web", name: short(cap(label)) };
  }

  // A link has no spaces and a dot in it (or starts with http); anything else is a few words about the product.
  const isLink = (v: string) => /^https?:\/\//i.test(v) || /^[^\s]+\.[^\s]+$/.test(v);
  // From scratch: the words become the name on a blank page, cut at a word so the name never ends mid-word.
  function idea(raw: string): Read {
    const all = raw.trim().replace(/\s+/g, " ");
    let name = "";
    for (const word of all.split(" ")) {
      if (name && name.length + word.length + 1 > 26) return { type: "idea", name: cap(name) + "…" };
      name = name ? `${name} ${word}` : word;
    }
    return { type: "idea", name: cap(short(name, 26)) };
  }

  // The sketch, drawn from a few primitives in cqi so it scales with the screen. Each kind keeps something to circle
  // at the spot where the ring sits. "narrow" is the phone layout: fewer pieces, more height.
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const k = (cls: string, x: number, y: number, w?: number | null, h?: number | null, text = "", size?: number) =>
    `<span class="${cls}" style="left:${x}cqi;top:${y}cqi;${w != null ? `width:${w}cqi;` : ""}${h != null ? `height:${h}cqi;` : ""}${size ? `font-size:${size}cqi;` : ""}">${text}</span>`;
  const bars = (x: number, y: number, ws: number[], gap = 2.4) => ws.map((w, i) => k("t", x, y + i * gap, w)).join("");
  // The /glass icon: the smile from its demo (eyes shut in a grin, a heavy ring), a fainter ring beside it where the
  // glass bends the light, and the sheen over all of it (CSS).
  const GLASS = `<svg viewBox="0 0 64 64"><circle class="bend" cx="33.6" cy="33.2" r="21.4" /><circle cx="32" cy="32" r="20" /><path d="M23.4 29.6q3.3-4.4 6.6 0M34 29.6q3.3-4.4 6.6 0M23.6 36.6q8.4 7.6 16.8 0" /></svg>`;
  // Its controls: a pill track with the knob somewhere along it, as the sliders on /glass.
  const slider = (x: number, y: number, w: number, h: number, at: number) => k("f pill", x, y, w, h) + k("o pill knob", x + at, y, w * 0.3, h);

  function draw(r: Read, narrow: boolean): string {
    const name = esc(r.name);
    if (narrow) {
      switch (r.type) {
        case "figma":
          return [k("grid", 0, 0), k("o", 4, 15, 3.6, 3.6), k("txt", 9.4, 15.2, null, null, name || "", 3), k("o", 4, 21.5, 92, 88),
            name ? k("name", 8, 26, null, null, name, 6.4) : k("t h", 8, 27, 50) + k("t h", 8, 32, 34), bars(8, 38, [56, 48, 34], 3.2)].join("");
        case "github":
          return [k("o", 5, 15.4, 4, 4), k("txt", 11, 15.6, null, null, `${r.owner ? esc(r.owner.toLowerCase()) + " / " : ""}<b>${name || "repo"}</b>`, 3.4),
            k("t", 5, 24, 9), k("t", 17, 24, 9), k("t", 29, 24, 9), k("dark", 5, 26.4, 9, 0.5),
            k("o", 4, 30, 92, 14), ...[0, 1, 2].map((i) => k("o", 7, 32.4 + i * 3.8, 2.2, 2.2) + k("t", 11, 33.2 + i * 3.8, [30, 22, 36][i])),
            k("o", 4, 47, 92, 62), bars(32, 54, [50, 42], 3.6)].join("");
        case "app":
          return [k("f", 5, 15, 13, 13), name ? k("name", 21.5, 16.4, null, null, name, 5.2) : k("t h", 21.5, 17.5, 40),
            k("txt", 21.5, 23.4, null, null, esc(r.store ?? ""), 2.8), bars(5, 33, [70, 56], 3.4), k("o", 4, 47, 92, 62)].join("");
        case "doc":
          return [k("f", 0, 13.2, 100, 8), k("o", 6, 17, 8, 8), name ? k("name", 6, 28, null, null, name, 6.4) : k("t h", 6, 30, 60),
            k("t", 6, 37.5, 10) + k("t", 19, 37.5, 22), k("f", 4, 46, 92, 21)].join("");
        case "self":
          return [k("t", 5, 15, 46), k("t h", 5, 19.5, 74), k("t h", 5, 24, 52), ...[0, 1, 2, 3].map((i) => k("o pill", 5 + i * 15.5, 30, 13.5, 4)),
            k("f dev", 4, 38, 92, 40), k("t", 8, 41.5, 18), k("t", 29, 41.5, 18), k("o pill", 8, 45.5, 84, 5)].join("");
        case "glass":
          return [k("t", 5, 17.6, 14), k("t", 52, 17.6, 14), k("o pill", 72, 15.6, 23, 4.4), k("name", 5.6, 23, null, null, name, 9), k("t", 6, 35, 36),
            k("o pill", 6, 40, 30, 6), k("glass", 52, 23, 40, 40, GLASS), k("dark pill", 6, 95, 70, 6)].join("");
        case "x":
          return [k("o pill", 5, 16, 4.4, 4.4), k("o", 47.8, 16, 4.4, 4.4), k("o pill", 5, 23.4, 8, 8),
            name ? k("txt", 15.6, 24, null, null, `<b>${name}</b>`, 3.4) : k("t", 15.6, 25, 18), k("t", 15.6, 29, 12),
            k("t h", 5, 35, 74), bars(5, 40.6, [86, 78, 44], 3.4), ...[0, 1, 2, 3].map((i) => k("t", 44 + i * 13, 62, 6))].join("");
        case "idea":
          return [k("grid", 0, 0), k("o d", 5, 16, 4.4, 4.4), k("t", 12, 17.8, 14),
            name ? k("name", 5.6, 24, null, null, name, 9) : k("t h d", 6, 26, 62) + k("t h d", 6, 31.5, 40), bars(6, 39, [66, 58, 42], 3.2)].join("");
        default:
          return [k("o", 5, 16, 4.4, 4.4), name ? k("txt", 11.4, 16.2, null, null, name.toLowerCase(), 3.4) : k("t", 12, 17.8, 14),
            name ? k("name", 5.6, 24, null, null, name, 9) : k("t h", 6, 26, 62) + k("t h", 6, 31.5, 40), bars(6, 39, [66, 58, 42], 3.2)].join("");
      }
    }
    switch (r.type) {
      case "figma":
        return [k("grid", 0, 0), k("o", 4, 11.4, 2.4, 2.4), k("txt", 7.6, 11.4, null, null, name || "", 1.9),
          k("t", 70, 12.4, 6), k("t", 78, 12.4, 6), k("o pill", 86, 11, 8, 3), k("t", 4, 16.4, 9), k("o", 3.6, 18, 52, 54),
          name ? k("name", 6.5, 21.4, null, null, name, 4.4) : k("t h", 6.5, 21.5, 30) + k("t h", 6.5, 25.2, 20), bars(6.5, 31, [32, 27, 18]),
          k("o", 6.5, 52, 22, 6.5), k("o", 31, 52, 22, 6.5), k("t", 59, 16.4, 7), k("o", 58.6, 18, 18, 32), bars(60.6, 22, [12, 9, 13, 8], 3),
          k("f", 80, 18, 15, 34), bars(82, 21, [10, 7, 9, 6, 10, 8], 3.4)].join("");
      case "github":
        return [k("o", 5, 10.4, 2.6, 2.6), k("txt", 8.8, 10.3, null, null, `${r.owner ? esc(r.owner.toLowerCase()) + " / " : ""}<b>${name || "repo"}</b>`, 2.3),
          k("o pill", 74, 10, 9, 3.4), k("o pill", 84.6, 10, 9, 3.4), k("t", 5, 16.6, 6), k("t", 13, 16.6, 6), k("t", 21, 16.6, 6), k("t", 29, 16.6, 6), k("dark", 5, 18.4, 6, 0.35),
          k("o", 4, 21, 52, 18.5), ...[0, 1, 2, 3, 4].map((i) => k("o", 6, 23 + i * 3.3, 1.6, 1.6) + k("t", 9, 23.5 + i * 3.3, [14, 10, 18, 12, 9][i]) + k("t", 42, 23.5 + i * 3.3, 10)),
          k("o", 4, 41, 52, 30), bars(24, 45, [28, 24, 30, 18], 2.8), k("t", 60, 21.5, 8), bars(60, 25, [32, 28, 22]),
          k("o pill", 60, 33, 9, 2.8), k("o pill", 70.5, 33, 11, 2.8), k("o pill", 60, 37, 13, 2.8)].join("");
      case "app":
        return [k("o", 3.4, 11.5, 27, 58), k("t", 13, 13, 8), k("t h", 6.5, 18, 18), bars(6.5, 23, [20, 16]), k("f", 6.5, 28.5, 20.6, 12), k("o", 6.5, 51.5, 20.6, 7.5),
          k("f", 36, 13, 9, 9), name ? k("name", 47.4, 13.8, null, null, name, 3.6) : k("t h", 47.4, 14.2, 20),
          k("txt", 47.4, 18.6, null, null, esc(r.store ?? ""), 1.6), k("dark pill", 84, 15.5, 9, 3.6), bars(36, 26, [30, 26]),
          k("f", 60, 32, 10, 20), k("f", 71.6, 32, 10, 20), k("f", 83.2, 32, 10, 20)].join("");
      case "doc":
        return [k("f", 0, 9.6, 100, 6), k("o", 6, 13, 5, 5), name ? k("name", 6, 20, null, null, name, 4.6) : k("t h", 6, 21.5, 34),
          k("t", 6, 27, 6) + k("t", 14, 27, 12), k("t", 6, 29.6, 6) + k("t", 14, 29.6, 9), bars(6, 34, [44, 40]), k("f", 4.6, 39.6, 48, 12.6),
          bars(6, 58, [14]), bars(24, 58, [30]), k("t", 72, 21, 10), bars(72, 24.4, [18, 14, 16, 12], 2.6)].join("");
      case "self":
        return [k("t", 5, 11.4, 22), k("t", 5, 13.4, 14), k("t h", 5, 17, 30), k("t h", 5, 20.6, 22),
          ...[0, 1, 2, 3].map((i) => k("o pill", 5 + i * 7.4, 26, 6.4, 2.4)), k("t", 5, 31, 26), bars(5, 34.4, [28, 22], 2.4),
          k("f dev", 42, 10, 53, 41), k("t", 46, 12.2, 7), k("t", 55, 12.2, 7), k("o pill", 45, 15, 47, 2.8), bars(46, 20.4, [20, 14]),
          k("o", 72, 20, 18, 12), k("f", 58, 31, 12, 6), k("o pill", 87, 34.5, 4.4, 4.4), k("o pill", 43.5, 46.6, 38, 2.8), k("dark pill", 83.5, 46.6, 9.5, 2.8)].join("");
      // /glass: the icon on its stage on the left, the name and the controls on the right, the dark download button last.
      case "glass":
        return [k("t", 5, 11.2, 9), k("t", 66, 11.2, 8), k("o pill", 77, 10, 16, 3.6), k("glass", 18.5, 14.4, 23, 23, GLASS),
          k("name", 58, 15, null, null, name, 4.6), k("t", 58, 22, 22), k("o pill", 58, 25.6, 28.4, 3.6), k("o pill", 87.6, 25.6, 5.4, 3.6),
          slider(58, 31.4, 35, 3.2, 20), slider(58, 35.6, 35, 3.2, 11), slider(58, 39.8, 35, 3.2, 6), k("dark pill", 58, 46, 27, 4.4)].join("");
      // A post on X: the menu down the left (its button is the circled one), the post in the middle column — the
      // handle, the words, a picture, the four actions — and the search and a box of trends on the right.
      case "x":
        return [k("o", 5, 10.4, 2.6, 2.6), ...[0, 1, 2, 3, 4].map((i) => k("o pill", 5.2, 15.6 + i * 4.2, 2.2, 2.2) + k("t", 9, 16.4 + i * 4.2, [7, 9, 6, 8, 6][i])),
          k("o", 23, 9.6, 41, 62), k("o pill", 25.5, 12.2, 3.8, 3.8), name ? k("txt", 30.8, 12.4, null, null, `<b>${name}</b>`, 1.9) : k("t", 30.8, 13.2, 10),
          k("t", 30.8, 15.6, 7), k("t h", 25.5, 19.4, 30), bars(25.5, 23.6, [36, 33, 20], 2.4), k("f", 25.5, 31, 36, 16),
          ...[0, 1, 2, 3].map((i) => k("t", 26.5 + i * 9.4, 50.4, 4)), k("o pill", 67, 10, 26, 3.6), k("o", 67, 16, 26, 25), k("t h", 69.5, 18.6, 13),
          bars(69.5, 23.4, [19, 12, 21, 15, 10], 3.4)].join("");
      // A page that isn't there yet: a canvas, dashed outlines where things will go, the picture to come crossed out
      // like a wireframe, and the words as its name.
      case "idea":
        return [k("grid", 0, 0), k("o d", 5, 10.2, 2.8, 2.8), k("t", 9, 11.2, 7), k("t", 58, 11.2, 5.4), k("t", 65.5, 11.2, 5.4), k("t", 73, 11.2, 5.4),
          k("o d pill", 84, 10, 9, 3.6), name ? k("name", 5.6, 17.6, null, null, name, 6.6) : k("t h d", 6, 19.6, 36) + k("t h d", 6, 23.6, 24),
          bars(6, 30.4, [34, 31, 22]), k("o d x", 58, 19, 35, 29), k("o d", 6, 54, 22, 6.5), k("o d", 31, 54, 22, 6.5)].join("");
      default:
        return [k("o", 5, 10.2, 2.8, 2.8), name ? k("txt", 8.8, 10.1, null, null, name.toLowerCase(), 2.1) : k("t", 9, 11.2, 7),
          k("t", 58, 11.2, 5.4), k("t", 65.5, 11.2, 5.4), k("t", 73, 11.2, 5.4), k("o pill", 84, 10, 9, 3.6),
          name ? k("name", 5.6, 17.6, null, null, name, 6.6) : k("t h", 6, 19.6, 36) + k("t h", 6, 23.6, 24), bars(6, 30.4, [34, 31, 22]),
          k("f", 58, 19, 35, 29), k("o", 6, 54, 22, 6.5), k("o", 31, 54, 22, 6.5)].join("");
    }
  }

  // Where point 2 sits; point 1 follows the end of the name (or the first heading when there is none).
  const POINT2: Record<Read["type"], [number, number] | null> = { web: [56.4, 17.4], figma: [77.6, 16], github: [56.6, 20], app: [57.6, 30.6], doc: [70, 18.6], idea: [56.4, 17.4], self: [39.6, 10.4], glass: [40.2, 13], x: [60, 29.4] };
  // How far right the big name may run on the wide screen, in cqi: up to the next block or point 2, less room for
  // point 1. On the phone the name has its row to itself.
  const ROOM: Record<Read["type"], number> = { web: 49.5, figma: 50, github: 49.5, app: 78, doc: 64, idea: 49.5, self: 38, glass: 88, x: 49.5 };

  const root = document.querySelector<HTMLElement>("[data-review]");
  const screen = root?.querySelector<HTMLElement>("[data-screen]");
  const sk = root?.querySelector<HTMLElement>("[data-sk]");
  const link = root?.querySelector<HTMLInputElement>("input[name=link]");
  const what = root?.querySelector<HTMLInputElement>("input[name=what]");
  const stuck = root?.querySelector<HTMLTextAreaElement>("textarea[name=stuck]");
  const who = root?.querySelector<HTMLTextAreaElement>("textarea[name=who]");
