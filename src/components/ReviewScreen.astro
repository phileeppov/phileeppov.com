      const recheck = () => toNoon() <= 0 && wake();
      ["visibilitychange", "focus", "pageshow"].forEach((type) => addEventListener(type, recheck));
    }
    // A press held on the camera starts recording: the red light and the time over it. Held again, it stops; at ten
    // minutes, the longest a review runs, it stops by itself.
    const tally = root.querySelector<HTMLElement>("[data-tally]");
    let recording = 0;
    let stopping = 0;
    const stopRec = () => {
      clearInterval(recording);
      clearTimeout(stopping);
      recording = 0;
      tally?.classList.remove("is-on");
    };
    const startRec = () => {
      if (!tally) return;
      const from = Date.now();
      const tick = () => {
        const s = Math.min(600, Math.floor((Date.now() - from) / 1000));
        tally.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
        if (s < 600) return;
        clearInterval(recording);
        stopping = window.setTimeout(stopRec, 1400);
      };
