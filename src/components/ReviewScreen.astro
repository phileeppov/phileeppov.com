    // covers a browser that restores them anyway, so nothing opens half-switched.
    const product = root.querySelector<HTMLInputElement>("input[name=mode][value=product]");
    if (product) product.checked = true;
    const tabName = root.querySelector<HTMLElement>("[data-tab-name]");
    const tabLabel = tabName?.textContent ?? "";
    let mode: Mode = "product";

    // Sent before noon: the camera wakes up for the review's sweep (the easter eggs below).
    wireReviewForm(root, {
      onSent: (sent) => {
        count(`review:send:${sent.get("mode") === "scratch" ? "scratch" : "product"}`);
        wake();
      },
    });
    // Typing anything counts as starting, once; switching the kind doesn't.
    root.addEventListener("input", (event) => {
      if (event.target instanceof HTMLInputElement && event.target.type === "radio") return;
      count("review:start");
    });

    const hint = link.placeholder;
    let shown: Read | null = null;
    let last = "";
    let force = false;
    // What the screen shows: the product from its link; from scratch, the words on a blank page (a deck or Notion link
    // draws as what it is).
    const current = (): Read => {
      if (mode === "scratch") {
        const v = what.value.trim();
        return v ? (isLink(v) ? read(v) : idea(v)) : { type: "idea", name: "" };
      }
      const v = link.value.trim();
      return v ? read(v) : (shown ?? read(""));
    };
    const render = () => {
      // One switch for the phone layout, used by both the sketch and the CSS (.is-narrow), so they never disagree.
      const narrow = screen.clientWidth < 520;
      // A note moved on one layout goes back to its place on the other: they keep it in different spots.
      if (note && narrow !== screen.classList.contains("is-narrow")) {
