      if (name && name.offsetWidth > room) name.style.fontSize = `${(parseFloat(name.style.fontSize) * room) / name.offsetWidth}cqi`;
      // The big name first, then the headline bar, then the small title (GitHub, an app with no name). The sketch
      // starts under the tab strip, so its own top is added.
      const head = sk.querySelector<HTMLElement>(".name") ?? sk.querySelector<HTMLElement>(".t.h") ?? sk.querySelector<HTMLElement>(".txt");
      if (head) {
