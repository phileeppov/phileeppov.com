        clearTimeout(resume);
        stop();
        shown = null;
        count("review:scratch");
      } else start(900);
      force = true;
      last = "";
      render();
      force = false;
      grow();
      ring();
    };
    root.querySelectorAll<HTMLInputElement>("input[name=mode]").forEach((radio) => {
