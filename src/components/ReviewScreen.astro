      looks.set(as, window.setTimeout(() => cam.classList.remove(as), ms));
    };
    // Back from another tab or app with the address bar still empty, most likely from copying the link: the camera
    // looks up at the bar. It turns back once something goes in (not on focus: coming back refocuses the bar).
    let away = 0;
    const leave = () => (away = Date.now());
    const back = () => {
      const gone = away ? Date.now() - away : 0;
      away = 0;
      if (gone > 1200 && !(mode === "scratch" ? what : link).value.trim()) look("is-looking", 2600);
    };
    document.addEventListener("visibilitychange", () => (document.hidden ? leave() : back()));
    addEventListener("blur", leave);
    addEventListener("focus", back);
    [link, what].forEach((field) => field.addEventListener("input", () => cam?.classList.remove("is-looking", "is-peeking")));
    // Just "test" in a field (or asdf, 123, aaa…), and in the contact a test address too: once the typing stops, the
    // camera squints, knowing. Nothing is blocked, and the same words don't get the look twice in a row. "www" is the
    // start of a link being typed, and "ООО" of a Russian company's name: not tests.
    const TEST = /^(test|testing|тест|asdf|qwerty|asd|123|1234|12345|123456|lorem ipsum.*|(?![wо])(?<c>\p{L})\k<c>{2,})$/iu;
    const TEST_MAIL = /^((test|testing|asdf|qwerty)@[^@\s]+\.\w+|[^@\s]+@(test|example)\.\w+|(?<m>\w)@\k<m>\.\w+)$/iu;
    const tried = new Map<HTMLElement, { timer: number; seen: string }>();
    [link, what, stuck, who, contact].forEach((field) =>
      field?.addEventListener("input", () => {
        const state = tried.get(field) ?? { timer: 0, seen: "" };
        tried.set(field, state);
        clearTimeout(state.timer);
        state.timer = window.setTimeout(() => {
          const v = field.value.trim().replace(/\s+/g, " ");
          const test = TEST.test(v) || (field === contact && TEST_MAIL.test(v));
          if (test && v.toLowerCase() !== state.seen) look("is-squinting", 1800);
          state.seen = test ? v.toLowerCase() : "";
        }, 800);
      }),
    );

    // The note peels off: picked up by the mouse or a finger, it follows, swinging a little with the hand, and stays
    // where it's dropped. A click still goes into its field; in a field being written in, the pointer is for the words.
    note?.addEventListener("pointerdown", (down) => {
      if (down.button !== 0 || root.classList.contains("is-done") || !barBox) return;
      const area = note.querySelector<HTMLTextAreaElement>("label:not([hidden]) textarea");
      const inField = !!(down.target as Element).closest(".field");
      const writing = () => !!area && document.activeElement === area;
      if (inField && (writing() || (down.pointerType === "mouse" && area?.value))) return;
      // The mouse would put the caret in or select the title, so the note holds it from the start; a click without a
      // drag then focuses the field itself (end). A finger is held by what it touched until it moves.
      const mouse = down.pointerType === "mouse";
      if (mouse) {
        down.preventDefault();
        note.setPointerCapture(down.pointerId);
      }
      const cqi = screen.clientWidth / 100;
      const from = { x: parseFloat(note.style.getPropertyValue("--nx")) || 0, y: parseFloat(note.style.getPropertyValue("--ny")) || 0 };
      const moved = note.classList.contains("is-moved");
      // It stays on the screen, under the address bar.
      const s = screen.getBoundingClientRect();
      const n = note.getBoundingClientRect();
      const pad = 1.2 * cqi;
      const lim = { x0: s.left + pad - n.left, x1: s.right - pad - n.right, y0: barBox.getBoundingClientRect().bottom + pad - n.top, y1: s.bottom - pad - n.bottom };
      let dragged = false;
      let tilt = 0;
      let lastX = down.clientX;
      const clamp = (v: number, a: number, b: number) => Math.min(Math.max(v, Math.min(a, 0)), Math.max(b, 0));
      const move = (e: PointerEvent) => {
        if (e.pointerId !== down.pointerId) return;
        const dx = e.clientX - down.clientX;
        const dy = e.clientY - down.clientY;
        if (!dragged) {
          if (Math.hypot(dx, dy) < 5) return;
          // A finger held in the field may have started writing in it after all; and one going up or down is
          // scrolling the page (the browser takes it a little later), unless it took the note by its title.
          if (inField && writing()) return end(e);
          if (!mouse && !(down.target as Element).closest("b") && Math.abs(dy) > Math.abs(dx)) return end(e);
          dragged = true;
          note.setPointerCapture(down.pointerId);
          note.classList.add("is-lifted", "is-moved");
        }
        note.style.setProperty("--nx", `${from.x + clamp(dx, lim.x0, lim.x1) / cqi}cqi`);
        note.style.setProperty("--ny", `${from.y + clamp(dy, lim.y0, lim.y1) / cqi}cqi`);
        if (!still.matches) {
          tilt = tilt * 0.75 + Math.max(-7, Math.min(7, (e.clientX - lastX) * 0.5)) * 0.25;
          note.style.setProperty("--tilt", `${tilt}deg`);
        }
        lastX = e.clientX;
      };
      const end = (e: PointerEvent) => {
        // A finger's hold passing from what it touched to the note says "lost" on the child, and that bubbles up here.
        if (e.pointerId !== down.pointerId || (e.type === "lostpointercapture" && e.target !== note)) return;
        note.removeEventListener("pointermove", move);
        note.removeEventListener("pointerup", end);
        note.removeEventListener("pointercancel", end);
        note.removeEventListener("lostpointercapture", end);
        if (!dragged) {
          if (e.type === "pointerup" && mouse) area?.focus();
          return;
        }
        dragged = false;
        note.classList.remove("is-lifted");
        note.style.removeProperty("--tilt");
        // The browser took the gesture after all (a scroll, a zoom): the note goes back to where it was.
        if (e.type === "pointercancel") {
          note.style.setProperty("--nx", `${from.x}cqi`);
          note.style.setProperty("--ny", `${from.y}cqi`);
          note.classList.toggle("is-moved", moved);
        }
        // The click that ends a drag doesn't go into the field.
        const swallow = (click: Event) => {
          click.preventDefault();
          click.stopPropagation();
        };
        note.addEventListener("click", swallow, { capture: true, once: true });
        setTimeout(() => note.removeEventListener("click", swallow, { capture: true }));
      };
      note.addEventListener("pointermove", move);
      note.addEventListener("pointerup", end);
      note.addEventListener("pointercancel", end);
      note.addEventListener("lostpointercapture", end);
    });
    // A click on the circled button circles it again, by hand.
    root.querySelector<HTMLElement>(".cta")?.addEventListener("click", circle);
    // Back and forward can bring typed words back after the page has started, without an input event: draw them again.
    addEventListener("pageshow", () => requestAnimationFrame(again));
  }
</script>

<style>
  /* The device: a thick, soft bezel with a highlight on top, the screen set into it. */
  /* Rows keep their real height (max-content): while the height glides (review-form.ts) the grid can't squeeze the
     screen row, so the dock never slides up under the screen. */
  .device {
    display: grid;
    grid-auto-rows: max-content;
    gap: 12px;
    padding: 16px;
    border-radius: 36px;
    background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, white 30%, var(--color-off-white)) 100%);
    box-shadow:
      inset 0 1.5px 0 #fff,
      inset 0 -1px 0 color-mix(in srgb, var(--color-black) 6%, transparent),
      0 0 0 0.5px color-mix(in srgb, var(--color-black) 9%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-black) 5%, transparent),
      0 30px 60px -28px color-mix(in srgb, var(--color-black) 30%, transparent);
  }

  /* The two kinds as browser tabs over the address bar, sharing the strip the way two open tabs do. The open tab is
     the page's own color and joins it, its bottom corners flaring into the strip like a browser tab's. */
  .tabs {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    right: 0;
    height: var(--shift);
    display: flex;
    align-items: flex-end;
    padding: 0 2.4cqi;
    background: color-mix(in srgb, var(--color-black) 5%, #fbfbfa);
    box-shadow: inset 0 -0.5px 0 var(--line);
  }
  /* The window's lights, where a browser keeps them: before the tabs, level with the tabs' words (a box as tall as a
     tab, at the strip's bottom). */
  .tabs .dots {
    align-self: flex-end;
    align-items: center;
    height: calc(100% - max(6px, 0.8cqi));
    margin-right: max(10px, 1.4cqi);
  }
  .tab {
    --r: max(9px, 1.1cqi);
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    max-width: max(180px, 25cqi);
    display: flex;
    align-items: center;
    gap: max(6px, 0.7cqi);
    height: calc(100% - max(6px, 0.8cqi));
    padding: 0 max(12px, 1.4cqi);
    border-radius: var(--r) var(--r) 0 0;
    color: color-mix(in srgb, var(--color-black) 55%, transparent);
    font-size: max(13px, 1.35cqi);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    background: linear-gradient(var(--tab-hover, transparent), var(--tab-hover, transparent)), var(--tab-fill, transparent);
    /* A tab left loses its hairlines at once (box-shadow isn't in the list), before its flares fold. */
    transition: --tab-fill 220ms ease-out, --tab-hover 220ms ease-out, color 160ms ease-out;
  }
  /* The tab's color, shared with its flares (below) and registered, so the browser animates it once for both: while a
     tab opens or closes, its flares are the tab's own color at every moment and grow out of it, never a lighter wedge
     beside it. Where @property isn't supported the color simply switches, still shared. */
  @property --tab-fill {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  /* The hover's grey lies over the tab's color instead of being it, so the flares never take it: no ledge of grey
     beside a tab under the mouse, coming or going. */
  @property --tab-hover {
    syntax: "<color>";
    inherits: false;
    initial-value: transparent;
  }
  /* A long product name in the first tab gives way with an ellipsis; the other tab keeps its words. */
  .tab span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The radio stays in its tab, invisible: the tab shows the choice and its focus. */
  .tab input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* The hairlines are shadows moved half a pixel up and to each side, so together they lie under the whole tab. At 125%
     or 150% zoom the tab's last row of pixels is only partly painted and they'd show through as a line along the
     bottom: the first shadow, in the page's color a pixel lower, lies over them there (half a pixel narrower each
     side, so the side hairlines keep their weight). */
  /* A tab opening takes its shape first and its hairlines once the flares are out: drawn earlier, the side hairlines
     would show down the corners the small flares don't cover yet. (A tab put down after a drag skips the delay: the
     script clears it for that once.) */
  .tab:has(input:checked) {
    z-index: 1;
    --tab-fill: #fbfbfa;
    transition:
      --tab-fill 200ms cubic-bezier(0.1, 0.8, 0.3, 1),
