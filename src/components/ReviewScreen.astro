      linear-gradient(transparent var(--cut), var(--tab-fill) var(--cut)),
      linear-gradient(var(--tab-fill), var(--tab-fill));
    background-position: left 1px bottom 0, left bottom, left bottom;
  }
  .tab:has(input:checked)::before,
  .tab:has(input:checked)::after {
    background-size: var(--r) var(--r), 2px 100%, calc(100% - 3px) 1px;
  }
  .tab:has(input:focus-visible) {
