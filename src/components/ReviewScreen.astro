    document.fonts?.ready.then(again);
    render();
    requestAnimationFrame(() => screen.classList.add("is-drawn"));

    // The demo: types a kind into the placeholder, holds it, erases it, moves on. It stops the moment the field is
    // focused (the sketch keeps the kind it was showing) and comes back if the field is left empty. Only for a product:
    // from scratch the bar holds one example.
    let run = 0;
    const pause = (ms: number) => new Promise((done) => setTimeout(done, ms));
    const demo = async () => {
      const id = ++run;
      for (let k = 0; ; k = (k + 1) % DEMO.length) {
        if (id !== run) return;
        const [text, kind] = DEMO[k];
        shown = kind;
        render();
        for (let i = 1; i <= text.length; i++) {
          if (id !== run) return;
          link.placeholder = text.slice(0, i);
          await pause(55);
        }
        await pause(1600);
        for (let i = text.length - 1; i >= 0; i--) {
