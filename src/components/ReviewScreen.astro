    });
    // Easter eggs. Nothing tells about them; each answers a thing people do anyway, and none is counted. All but the
    // window's lights (a hover, CSS) work under a finger too.
    // The tabs drag like a browser's: the tab picked up becomes the open one, and once it covers more than half of its
    // neighbour they swap places. The strip keeps the new order until the page is opened again.
    const strip = root.querySelector<HTMLElement>(".tabs");
    // A tab slides from where it was to where it is now.
