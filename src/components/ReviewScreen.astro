    opacity: 0.7;
    transition: max-width 360ms cubic-bezier(0.6, 0, 0.2, 1), padding 360ms cubic-bezier(0.6, 0, 0.2, 1), opacity 200ms ease-out,
      border-color 200ms ease-out;
  }
  /* A link is in: the question folds away and the link gets the bar. It stays in the label for screen readers. */
  .has-link .url b {
    max-width: 0;
    padding-right: 0;
    padding-left: 0;
    border-right-color: transparent;
    opacity: 0;
  }
  .has-link .url input {
    padding-left: max(16px, 2.2cqi);
  }
  input,
  textarea {
    width: 100%;
    border: 0;
    color: var(--ink);
    font: inherit;
    letter-spacing: inherit;
  }
  /* 16px and up, or iPhone zooms into the field on focus. */
  .url input {
    height: 100%;
    padding: 0 1.6cqi;
    background: none;
    font-size: max(16px, 1.75cqi);
    outline: none;
    transition: padding 360ms cubic-bezier(0.6, 0, 0.2, 1);
  }

  /* The product sketch: thin bars for text, outlines for boxes; the name from the link in real type. */
  .sk {
    position: absolute;
    inset: var(--top) 0 0;
  }
  .sk > :global(span) {
    position: absolute;
  }
  /* A new kind of product draws in piece by piece, top to bottom (--i is the order, set by the script); the name
     wipes in left to right, as if typed. */
  .sk:global(.is-in) > :global(span) {
    animation: sk-in 460ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 18ms);
  }
  .sk:global(.is-in) > :global(.name) {
    animation-name: sk-name;
    animation-duration: 560ms;
  }
  @keyframes sk-in {
    from {
      opacity: 0;
      translate: 0 0.9cqi;
    }
  }
  /* The clip reaches past the line box, so descenders (p, y) aren't cut while it plays. */
  @keyframes sk-name {
    from {
      clip-path: inset(-30% 100% -30% 0);
    }
    to {
      clip-path: inset(-30% -10% -30% 0);
    }
  }
  .sk :global(.t) {
    height: 0.62cqi;
    border-radius: 999px;
    background: var(--bar);
  }
  .sk :global(.t.h) {
    height: 1.9cqi;
    background: var(--bar-strong);
  }
  .sk :global(.o) {
    border: 1px solid var(--line);
    border-radius: 1.2cqi;
  }
  .sk :global(.f) {
    border: 1px solid var(--line);
    border-radius: 1.2cqi;
    background: var(--fill);
  }
  .sk :global(.pill) {
    border-radius: 999px;
  }
  .sk :global(.dark) {
    border: 0;
    background: var(--bar-strong);
  }
  .sk :global(.txt) {
    color: var(--graphite);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .sk :global(.txt b) {
    color: var(--name);
  }
  .sk :global(.name) {
    color: var(--name);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .sk :global(.grid) {
    inset: 9.6cqi 0 0 0;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-black) 11%, transparent) 0.12cqi, transparent 0.14cqi) 0 0 / 1.8cqi 1.8cqi;
  }
  /* From scratch: dashed outlines where things will go, and the picture to come crossed out, like on a wireframe. */
  .sk :global(.d) {
    border-style: dashed;
  }
  .sk :global(.t.d) {
    border: 1px dashed var(--bar-strong);
    background: none;
  }
  /* The page in miniature (a link to /review itself): its device has the device's rounder corners. */
  .sk :global(.dev) {
    border-radius: 2cqi;
  }
  .sk :global(.x) {
    background:
      linear-gradient(to top right, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px)),
      linear-gradient(to bottom right, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px));
  }
  /* The /glass icon: a rounded square of glass with an inner rim, the smile under it, the sheen on top. */
  .sk :global(.glass) {
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 24%;
    background: linear-gradient(160deg, #fff, var(--fill));
    box-shadow:
      inset 0 0 0 0.7cqi rgb(255 255 255 / 0.8),
      inset 0 0 0 calc(0.7cqi + 1px) var(--line);
  }
  .sk :global(.glass)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(125deg, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 42%);
  }
  .sk :global(.glass svg) {
    width: 76%;
    fill: none;
    stroke: var(--name);
    stroke-width: 3.4;
    stroke-linecap: round;
  }
  .sk :global(.glass .bend) {
    stroke: var(--bar-strong);
    stroke-width: 2.6;
  }
  /* The slider's knob: a white pill raised on its track. */
  .sk :global(.knob) {
    border: 0;
    background: #fff;
    box-shadow: var(--raise);
  }

  /* The review marks, in ink. */
  .cta {
    position: absolute;
    z-index: 1;
    left: 6cqi;
    top: calc(44cqi + var(--top));
    width: 15cqi;
    height: 4.6cqi;
    border-radius: 999px;
    background: var(--bar-strong);
  }
  /* On a page from scratch the circled button isn't there yet either. */
  .is-idea .cta {
    border: 1px dashed var(--bar-strong);
    background: none;
  }
  .ring {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    left: 1.6cqi;
    top: calc(40.6cqi + var(--top));
    width: 24cqi;
    height: 11.4cqi;
    overflow: visible;
  }
  .ring path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
    /* The gap is longer than the dash, so the round cap leaves no dot before the ring is drawn. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
  }
  .is-drawn .ring path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 720ms cubic-bezier(0.6, 0, 0.2, 1);
  }
  .pt {
    position: absolute;
    z-index: 2;
    width: 3cqi;
    height: 3cqi;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    font-size: 1.55cqi;
    font-weight: 600;
    letter-spacing: 0;
    /* The points glide to their new place when the sketch changes or the name grows. */
    transition: left 420ms cubic-bezier(0.3, 1.25, 0.4, 1), top 420ms cubic-bezier(0.3, 1.25, 0.4, 1);
  }
  /* "What I see, what I'd do, what it would cost" on the page points here (review.astro): hovering 1 or 2 makes its
     mark jump, with an emerald ring while it moves; 3 is said in the video, so the camera nods. */
  .pt:global(.is-ping) {
    animation: ping 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  /* Soft: a little bigger, a light grey fill and a faint emerald ring; the number keeps its ink, so the mark answers
     the hover without shouting over the sketch. */
  @keyframes ping {
    40% {
      scale: 1.3;
      background: color-mix(in srgb, var(--color-black) 9%, #fff);
      box-shadow: 0 0 0 0.7cqi color-mix(in srgb, var(--emerald) 16%, transparent);
    }
  }
  /* The wink: the right eye closes and opens, the coin nods. */
  .cam .smile circle {
    transform-box: fill-box;
    transform-origin: center;
  }
  .cam i:global(.is-winking) {
    animation: nod 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  .cam i:global(.is-winking) .smile circle:last-of-type {
    animation: wink 420ms ease-in-out;
  }
  @keyframes wink {
    35%,
    60% {
      scale: 1 0.12;
    }
  }
  .cam i:global(.is-ping) {
    animation: nod 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  @keyframes nod {
    40% {
      scale: 1.1;
    }
  }
  /* Asleep (the script, until noon): the lids instead of the eyes, and the smile breathes, slowly. */
  .cam .smile .lid {
    stroke-width: 3.4;
    opacity: 0;
  }
  .cam i:global(.is-asleep) .smile circle {
    opacity: 0;
    scale: 1 0.12;
  }
  .cam i:global(.is-asleep) .smile .lid {
    opacity: 1;
  }
  .cam i:global(.is-asleep) .smile {
    animation: breathe 4.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      scale: 1.05;
      translate: 0 2%;
    }
  }
  /* Looks (the script): up at the address bar, the face turned toward it; a knowing squint, the head tilted. */
  .cam .smile {
    transition: translate 420ms cubic-bezier(0.3, 1.3, 0.4, 1), rotate 420ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .cam .smile circle {
    transition: scale 220ms ease-out;
  }
  .cam i:global(.is-looking) .smile {
    translate: -14% -15%;
    rotate: -8deg;
  }
  .cam i:global(.is-squinting) .smile {
    rotate: 7deg;
  }
  .cam i:global(.is-squinting) .smile circle {
    scale: 1 0.38;
  }
  /* Asleep, a look is only a peek: the right eye half open, then shut again. */
  .cam i:global(.is-asleep.is-peeking) .smile circle:last-of-type {
    opacity: 1;
    scale: 1 0.5;
  }
  .cam i:global(.is-asleep.is-peeking) .smile .lid:last-of-type {
    opacity: 0;
  }
  /* Woken: the eyes open, blink once, and the coin nods. */
  .cam i:global(.is-waking) {
    animation: nod 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  .cam i:global(.is-waking) .smile circle {
    animation: wake 540ms ease-out;
  }
  @keyframes wake {
    0% {
      scale: 1 0.12;
    }
    35%,
    50% {
      scale: 1;
    }
    65% {
      scale: 1 0.12;
    }
    85% {
      scale: 1;
    }
  }
  /* A press held on the camera: the recording light over it, the dot and the time. The dot is emerald, not a camera's
     red: recording is green here, and emerald is for what moves — it blinks once a second (ink when still). */
  .cam {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .tally {
    position: absolute;
    bottom: calc(100% + 0.9cqi);
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.75em 0.3em 0.6em;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--raise);
    color: var(--ink);
    font-size: max(10px, 1.15cqi);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 0.4cqi;
    scale: 0.9;
    pointer-events: none;
    transition: opacity 180ms ease-out, translate 260ms cubic-bezier(0.3, 1.5, 0.4, 1), scale 260ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  .tally::before {
    content: "";
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--emerald);
  }
  .tally:global(.is-on) {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }
  .tally:global(.is-on)::before {
    animation: tally 1s steps(1) infinite;
  }
  @keyframes tally {
    50% {
      opacity: 0.25;
    }
  }
  /* The numbers are drawn, not text: they belong to the picture. */
  .pt::before {
    content: attr(data-pt);
  }
  .pt[hidden] {
    display: none;
  }

  /* The note = the "What's stuck?" field ("Who's it for?" from scratch). Peeled off and moved (the script), it keeps
     the place it was dropped at: --nx and --ny, in cqi, so it stays put on the picture as the screen resizes. */
  .note {
    position: absolute;
    z-index: 2;
    left: calc(28cqi + var(--nx, 0cqi));
    top: calc(38cqi + var(--top) + var(--ny, 0cqi));
    width: 27cqi;
    border-radius: 1.4cqi;
    background: linear-gradient(180deg, #fff, #fafaf8);
    box-shadow: var(--raise), 0 2.2cqi 3cqi -2cqi rgb(0 0 0 / 0.18);
    transform: rotate(-2.5deg) translateY(0.8cqi);
    opacity: 0;
    touch-action: pan-y pinch-zoom;
    transition: transform 420ms cubic-bezier(0.3, 1.3, 0.4, 1) 520ms, opacity 200ms 520ms, box-shadow 160ms, translate 200ms ease-out,
      scale 260ms cubic-bezier(0.3, 1.5, 0.4, 1), rotate 260ms ease-out;
  }
  /* Under a finger the note gives the page its scroll and its zoom, so it moves sideways first; its title, where a
     finger lands on it, takes a drag any way. The title's words don't get selected. */
  .note b {
    touch-action: pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
  }
  /* The field scrolls on its own, so it doesn't take the note's rule from above: it needs its own. */
  .note textarea {
    touch-action: pan-y pinch-zoom;
  }
  /* Moved once, it lies on top of what it was dropped on. */
  .note:global(.is-moved) {
    z-index: 3;
  }
  .is-drawn .note {
    transform: rotate(-2.5deg);
    opacity: 1;
  }
  .note:focus-within {
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink), 0 2.2cqi 3cqi -2cqi rgb(0 0 0 / 0.18);
  }
  /* The pin. */
  .note::before {
    content: "";
    position: absolute;
    top: -0.7cqi;
    left: 50%;
    width: 1.5cqi;
    height: 1.5cqi;
    border-radius: 50%;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge), 0 0.2cqi 0.3cqi rgb(0 0 0 / 0.3);
    transform: translateX(-50%);
    transition: transform 240ms cubic-bezier(0.3, 1.5, 0.4, 1), box-shadow 240ms ease-out;
  }
  /* Writing on the note pushes the pin in: smaller, its shadow gone into the screen. */
  .review-screen:not(.is-done) .note:focus-within::before {
    transform: translateX(-50%) scale(0.8);
    box-shadow: inset 0 0.15cqi 0.2cqi rgb(0 0 0 / 0.55), 0 0 0 0.5px rgb(0 0 0 / 0.5);
  }
  /* The label fills the note, so a click anywhere on it goes into the field. The field reaches 0.7cqi into the sides
     (margin below), so 0.9cqi is left there; the bottom matches. */
  .note label {
    display: block;
    padding: 1.3cqi 1.6cqi 0.9cqi;
  }
  .note label[hidden],
  .url[hidden] {
    display: none;
  }
  .note b {
    display: block;
    margin-bottom: 0.4cqi;
    font-size: max(11px, 1.25cqi);
    font-weight: 500;
    opacity: 0.7;
  }
  /* The field drawn on the note: a recessed tray, like the address bar, while it's empty; in focus a white field; once
     there are words, they sit on the paper. */
  .note .field {
    display: block;
    margin: 0 -0.7cqi;
    padding: 0.5cqi 0.7cqi;
    border-radius: 0.8cqi;
    background: var(--tray);
    box-shadow: var(--recess);
    transition: background-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .note:focus-within .field {
    background: #fff;
    box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 12%, transparent);
  }
  .note:not(:focus-within) .field:has(textarea:not(:placeholder-shown)),
  .is-done .note .field {
    background: none;
    box-shadow: none;
  }
  /* Sent with nothing written: the note stays blank, not an example that reads like an answer. */
  .is-done .note textarea::placeholder {
    color: transparent;
  }
  /* Grows with the words (the script sets the height) up to four lines (three on the phone), then scrolls without
     a scrollbar. */
  .note textarea {
    display: block;
    min-height: 2.6em;
    max-height: 4.9em;
    padding: 0;
    background: none;
    resize: none;
    font-size: max(16px, 1.9cqi);
    font-weight: 500;
    line-height: 1.2;
    outline: none;
    scrollbar-width: none;
  }
  .note textarea::-webkit-scrollbar {
    display: none;
  }
  .note textarea::placeholder {
    color: color-mix(in srgb, var(--color-black) 35%, transparent);
  }

  /* The reviewer's camera, like the face bubble in a screen recording, signed: the favicon's coin. Toned down to a soft
     graphite with no drop shadow while there's no sample review behind it, so it doesn't read as something to press. */
  .cam {
    position: absolute;
    z-index: 2;
    right: 2.4cqi;
    bottom: 2.4cqi;
    display: grid;
    justify-items: center;
    gap: 0.8cqi;
  }
  .cam i {
    position: relative;
    width: 11cqi;
    height: 11cqi;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(180deg, #8a8a88 0%, #747472 100%);
    box-shadow:
      inset 0 0.5px 0 rgb(255 255 255 / 0.2),
      0 0 0 0.5cqi #fbfbfa,
      0 0 0 calc(0.5cqi + 1px) var(--line);
  }
  .cam .smile {
    width: 62%;
    fill: #f6f6f4;
  }
  .cam .smile path {
    fill: none;
    stroke: #f6f6f4;
    stroke-width: 4.4;
    stroke-linecap: round;
  }
  /* The sweep sits on the hairline around the coin, draws once clockwise from the top (the path starts there), then
     fades: emerald only while it moves. */
  .cam .rec {
    position: absolute;
    top: calc(-0.5cqi - 1px);
    left: calc(-0.5cqi - 1px);
    width: calc(100% + 1cqi + 2px);
    height: calc(100% + 1cqi + 2px);
    overflow: visible;
    fill: none;
    stroke: var(--emerald);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .is-done .cam .rec {
    animation: rec 1.3s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes rec {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    65% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  .cam span {
    color: color-mix(in srgb, var(--color-black) 58%, transparent);
    font-size: max(10px, 1.15cqi);
    font-weight: 500;
  }

  /* Under the screen: the contact field and SEND, a dock. */
  .dock {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 0 2px;
  }
  .dock[hidden],
  .below[hidden] {
    display: none;
  }
  .dock label {
    padding-left: 8px;
    font-size: var(--text-meta);
    font-weight: 500;
  }
  .dock input {
    height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: var(--recess);
    font-size: var(--text-body);
    transition: background-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .dock input:focus {
    outline: none;
    background: #fff;
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink);
  }
  /* Under the mouse a field shows it takes typing before it's clicked (tokens.css); the note lifts a little off the
     screen. Focus keeps its own look, and nothing reacts once the request is in. */
  @media (hover: hover) {
    .review-screen:not(.is-done) .url:not(:focus-within):hover,
    .review-screen:not(.is-done) .dock input:not(:focus):hover {
      background: var(--tray-hover);
      box-shadow: var(--recess), var(--hover-edge);
    }
    .review-screen:not(.is-done) .has-link .url:not(:focus-within):hover {
      background: #fff;
      box-shadow: var(--raise), var(--hover-edge);
    }
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover {
      translate: 0 -0.6cqi;
      box-shadow: var(--raise), var(--hover-edge), 0 3.4cqi 4cqi -2cqi rgb(0 0 0 / 0.24);
    }
    /* The field on the note keeps its tray (lighter would vanish into the paper) and gets the hover edge. */
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover .field:has(textarea:placeholder-shown) {
      box-shadow: var(--recess), var(--hover-edge);
    }
    /* While lifted, a strip under the note keeps the hover, or a mouse at its bottom edge would make it jitter. */
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover::after {
      content: "";
      position: absolute;
      inset: auto 0 -0.9cqi;
      height: 0.9cqi;
    }
  }
  /* Peeled off and held: a little bigger, swinging with the hand (--tilt, from the script), its shadow further down.
     Doubled .note: the same weight as the hover above, and later, so it wins. */
  .review-screen:not(.is-done) .is-drawn .note.note:global(.is-lifted) {
    scale: 1.04;
    rotate: var(--tilt, 0deg);
    translate: 0 -0.6cqi;
    box-shadow: var(--raise), 0 4.4cqi 5cqi -2.4cqi rgb(0 0 0 / 0.3);
  }
  .review-screen:not(.is-done) .is-drawn .note.note:global(.is-lifted):focus-within {
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink), 0 4.4cqi 5cqi -2.4cqi rgb(0 0 0 / 0.3);
  }
  .note:global(.is-lifted),
  .note:global(.is-lifted) * {
    cursor: grabbing;
  }
  /* SEND with a required field empty (review-form.ts): one short red flash on the field and a message under it, instead
     of the browser's bubble; the classes go when the flash ends, the message when the field gets something. Red is
     only for errors: this and the failed-send line below. The field that takes focus (.is-invalid-focused) flashes from its focus look, so the ring fades
     into the ink ring instead of jumping. */
  @keyframes invalid {
    0%,
    45% {
      background-color: color-mix(in srgb, var(--error) 6%, #fff);
      box-shadow: var(--recess), 0 0 0 1.5px var(--error);
    }
  }
  @keyframes invalid-focus {
    0%,
    45% {
      background-color: color-mix(in srgb, var(--error) 6%, #fff);
      box-shadow: var(--raise), 0 0 0 1.5px var(--error);
    }
  }
  .url.is-invalid,
  .dock input.is-invalid {
    animation: invalid 1.2s ease-out;
  }
  .url.is-invalid-focused,
  .dock input.is-invalid-focused {
    animation-name: invalid-focus;
  }
  .err {
    position: relative;
    width: max-content;
    max-width: 100%;
    padding: 5px 10px;
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--raise);
    color: var(--error);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }
  .err[hidden] {
    display: none;
  }
  /* The tick pointing up at the field. */
  .err::before {
    content: "";
    position: absolute;
    top: -4px;
    left: 16px;
