      radio.dispatchEvent(new Event("change", { bubbles: true }));
    };
    strip?.addEventListener("pointerdown", (down) => {
      const tab = (down.target as Element).closest<HTMLElement>(".tab");
      if (!tab || down.button !== 0 || root.classList.contains("is-done")) return;
      // Pressed with the mouse, a tab opens at once, as a browser's does, so its shape turns while the button is
      // still down. Under a finger it waits for the tap or the drag: a swipe over the strip may be a scroll. Not with
      // Ctrl: on a Mac that press opens the context menu and makes no click.
      if (down.pointerType === "mouse" && !down.ctrlKey) open(tab);
      // The tab holds the pointer from the start, so the drag ends wherever the button or the finger comes up.
      tab.setPointerCapture(down.pointerId);
      let dragged = false;
      // Where the pointer would be if the tab sat in its place: moves along when the tabs swap.
      let origin = down.clientX;
      // The first swap comes right past the middle; after it, going back takes an eighth of a tab more, so at the line
      // the tabs don't flicker.
      let margin = 0;
      const neighbour = (el: Element | null) => (el?.classList.contains("tab") ? (el as HTMLElement) : null);
      const move = (e: PointerEvent) => {
        if (e.pointerId !== down.pointerId) return;
        let dx = e.clientX - origin;
        if (!dragged) {
          if (Math.abs(dx) < 5) return;
          dragged = true;
          tab.classList.add("is-dragging");
          // Picked up, it opens, as a browser tab does.
          open(tab);
        }
        // Past the strip's ends it follows with some give, like a tab pulled against the window's edge; the give stops
        // at 6px, so a tab pulled hard never covers the window's lights.
        const tabs = [...strip.querySelectorAll<HTMLElement>(".tab")];
        const min = tabs[0].offsetLeft - tab.offsetLeft;
        const last = tabs[tabs.length - 1];
        const max = last.offsetLeft + last.offsetWidth - tab.offsetLeft - tab.offsetWidth;
        if (dx < min) dx = min - Math.min(6, (min - dx) * 0.25);
        if (dx > max) dx = max + Math.min(6, (dx - max) * 0.25);
        tab.style.translate = `${dx}px 0`;
        // Its leading edge past a neighbour's middle (more than half of the neighbour covered): they swap. The neighbour
        // moves and glides to the free place; the held tab keeps its place in the strip and stays under the pointer.
        const left = tab.offsetLeft + dx;
        const right = left + tab.offsetWidth;
        const next = neighbour(tab.nextElementSibling);
        const prev = neighbour(tab.previousElementSibling);
