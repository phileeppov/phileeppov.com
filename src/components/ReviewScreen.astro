      screen.classList.toggle("is-narrow", narrow);
      const r = current();
      const field = mode === "scratch" ? what : link;
      screen.classList.toggle("has-link", !!field.value.trim());
      screen.classList.toggle("is-idea", r.type === "idea");
      // From scratch the bar shows an example, and in focus says what it takes; the question takes half the bar on a
      // phone, so there it's short.
      what.placeholder = narrow ? "a few words" : document.activeElement === what ? "a few words, plus a link if you have one" : "e.g. a booking app for barbers";
      // The first tab takes the product's name, like a browser tab takes the page's title.
      if (tabName) tabName.textContent = (mode === "product" && link.value.trim() && r.name) || tabLabel;
      const key = `${mode}|${narrow}|${r.type}|${r.name}|${r.owner}|${r.store}`;
      if (key === last) return;
      // A new kind of product draws in piece by piece; a name being typed just updates.
      const kind = force || (last && last.split("|").slice(0, 3).join() !== key.split("|").slice(0, 3).join());
      last = key;
      sk.classList.remove("is-in");
      sk.innerHTML = draw(r, narrow);
      if (kind && !still.matches) {
        [...sk.children].forEach((el, i) => (el as HTMLElement).style.setProperty("--i", String(i)));
        void sk.offsetWidth;
        sk.classList.add("is-in");
      }
      const cqi = screen.clientWidth / 100;
