  const DEMO: [string, Read][] = [
    ["your-product.com", { type: "web", name: "" }],
    ["App Store link", { type: "app", name: "", store: "App Store" }],
    ["Figma file", { type: "figma", name: "" }],
    ["GitHub repo", { type: "github", name: "" }],
    ["Google Play link", { type: "app", name: "", store: "Google Play" }],
    ["Notion page", { type: "doc", name: "" }],
    ["any link", { type: "web", name: "" }],
