      tab.addEventListener("pointerup", end);
      tab.addEventListener("pointercancel", end);
      tab.addEventListener("lostpointercapture", end);
    });
    // The reviewer's camera winks when poked: in both research rounds everybody poked it.
    const cam = root.querySelector<HTMLElement>(".cam i");
    const replay = (name: string) => {
      if (!cam) return;
      cam.classList.remove("is-winking", "is-ping", "is-waking");
      void cam.offsetWidth;
      cam.classList.add(name);
    };
    // Before noon, Moscow time (UTC+3, as the review weeks in worker/index.js), the camera is asleep, as the reviewer
    // is: the first poke wakes it, and at noon it wakes by itself.
    const wake = () => {
      if (!cam?.classList.contains("is-asleep")) return;
      cam.classList.remove("is-asleep", "is-peeking");
      replay("is-waking");
    };
