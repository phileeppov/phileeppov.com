      if (down.button !== 0) return;
      held = false;
      touching = down.pointerType !== "mouse";
      clearTimeout(hold);
      hold = window.setTimeout(() => {
        held = true;
        // Woken by the hold, it keeps its waking blink instead of the nod.
        const slept = !!cam.classList.contains("is-asleep");
