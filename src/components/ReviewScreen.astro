      const moscow = new Date(Date.now() + 3 * 60 * 60 * 1000);
      return Date.UTC(moscow.getUTCFullYear(), moscow.getUTCMonth(), moscow.getUTCDate(), 12) - moscow.getTime();
    };
    if (cam && toNoon() > 0) {
      cam.classList.add("is-asleep");
