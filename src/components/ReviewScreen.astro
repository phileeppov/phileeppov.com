---
// The video review form on /review, drawn as the review itself: a screen whose address bar is the link field and whose
// sticky note is "What's stuck?"; under it, the contact field and SEND, like a player's dock. The product sketched in
// the screen follows the link — a website, a Figma file, a GitHub repo, an app, a doc — with the name taken from it.
// The review marks: the ring around what's stuck, the note and the reviewer's camera stay put; point 1 follows the name.
// Copy: questions and states — site.md §1.6; the rest — §8. Submit: src/scripts/review-form.ts → worker/index.js.
---

<div class="review-screen" data-review>
  <form class="device" method="post" action="/api/review" data-review-form>
    <div class="screen" data-screen>
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <!-- The address bar is the link field. The question sits in it like "https://" does and folds away once a link
             is in, so the link gets the whole bar. -->
        <label class="url" data-field>
          <b>What's the link?</b>
          <input
            name="link"
            type="text"
            required
            maxlength="2000"
            autocomplete="url"
            inputmode="url"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="next"
            placeholder="url / Figma / App Store"
          />
          <span class="load" aria-hidden="true"></span>
        </label>
        <span class="err" id="review-link-error" data-error-for="link" role="alert" hidden>Paste a link first.</span>
      </div>
      <div class="sk" data-sk aria-hidden="true"></div>
      <span class="cta" aria-hidden="true"></span>
      <span class="pt" data-pt="1" aria-hidden="true"></span>
      <span class="pt" data-pt="2" aria-hidden="true"></span>
      <svg class="ring" viewBox="0 0 229 100" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M34,66 C16,42 50,10 116,9 C182,8 223,24 220,50 C217,79 168,94 110,93 C54,92 12,79 22,50 C27,36 46,28 66,24" />
      </svg>
      <!-- The sticky note is the "What's stuck?" field, pinned next to the circled button. The field is drawn on the
           note, so it reads as a place to write before anything is typed. -->
      <label class="note">
        <b>What's stuck?</b>
        <span class="field"><textarea name="stuck" rows="2" maxlength="500" enterkeyhint="next" placeholder="e.g. people sign up, then leave"></textarea></span>
      </label>
      <span class="cam" aria-hidden="true">
        <!-- The smile from the favicon, drawn, so it's the same mark everywhere. -->
        <i>
          <svg class="smile" viewBox="0 0 64 64"><circle cx="23.5" cy="26" r="3.8" /><circle cx="40.5" cy="26" r="3.8" /><path d="M20.5 37.5 Q32 49.5 43.5 37.5" /></svg>
          <!-- After SEND: one emerald sweep around the camera, like a recording starting. -->
          <svg class="rec" viewBox="0 0 100 100"><path pathLength="1" d="M50 2a48 48 0 1 1 0 96a48 48 0 1 1 0-96" /></svg>
        </i>
        <span>Nikita</span>
      </span>
    </div>

    <div class="dock" data-hide-on-sent>
      <label for="review-contact">How do I get back to you?</label>
      <input id="review-contact" name="contact" type="text" required maxlength="200" autocomplete="email" placeholder="email or @telegram" enterkeyhint="send" />
      <span class="err" id="review-contact-error" data-error-for="contact" role="alert" hidden>Add an email or @telegram.</span>
      <button type="submit">SEND</button>
    </div>
    <!-- Bot trap: not rendered, so neither a person nor browser autofill fills it in; bots fill every field. -->
    <input class="trap" name="message" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="t" value="" />
    <p class="below" data-hide-on-sent>Behind a login? I'll ask for access.<br /> Private. Nothing gets posted without your OK.</p>
    <p class="error" data-state="error" role="alert" hidden>That didn't go through. Write to <a href="mailto:nikita@phileeppov.com">nikita@phileeppov.com</a> instead.</p>
    <div class="done" tabindex="-1" aria-live="polite" data-done>
      <p data-state="sent" hidden>Got it. I'll send the review to <span data-contact>[contact]</span>.</p>
      <p data-state="next" hidden>Got it. This week is full, so I'll send the review to <span data-contact>[contact]</span> next week.</p>
      <p data-state="later" hidden>Got it. There's a queue, so I'll send the review to <span data-contact>[contact]</span> the week of <span data-week>[date]</span>.</p>
    </div>
  </form>
</div>

<script>
  import { wireReviewForm } from "../scripts/review-form";

  type Read = { type: "web" | "figma" | "github" | "app" | "doc"; name: string; owner?: string; store?: string };

  // Links to a platform rather than a product: no name to take, so the sketch stays plain.
  const PLATFORMS = /(^|\.)(loom\.com|youtube\.com|youtu\.be|vimeo\.com|dropbox\.com|canva\.com|miro\.com|framer\.com|webflow\.com|x\.com|twitter\.com|linkedin\.com|t\.me)$/;
  const words = (s: string) => {
    try {
      return decodeURIComponent(s).replace(/[-_+]+/g, " ").trim();
    } catch {
      return s.replace(/[-_+]+/g, " ").trim();
    }
  };
  const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);
  const short = (s: string, n = 24) => (s.length > n ? s.slice(0, n - 1).trimEnd() + "…" : s);

  // What the link is, and the product's name in it.
  function read(raw: string): Read {
    const v = raw.trim();
    if (!v) return { type: "web", name: "" };
    let u: URL;
    try {
      u = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
    } catch {
      return { type: "web", name: "" };
    }
    const host = u.hostname.replace(/^www\./, "").toLowerCase();
    const parts = u.pathname.split("/").filter(Boolean);
    if (host.endsWith("figma.com")) return { type: "figma", name: parts[2] ? short(words(parts[2])) : "" };
    if (host === "github.com") return { type: "github", owner: short(parts[0] ?? "", 18), name: short(parts[1] ?? parts[0] ?? "", 20) };
    if (host === "apps.apple.com") {
      const i = parts.indexOf("app");
      return { type: "app", store: "App Store", name: i >= 0 && parts[i + 1] ? short(cap(words(parts[i + 1]).split(" ").slice(0, 3).join(" "))) : "" };
    }
    if (host === "play.google.com") return { type: "app", store: "Google Play", name: short(cap(u.searchParams.get("id")?.split(".").pop() ?? "")) };
    if (host === "testflight.apple.com") return { type: "app", store: "TestFlight", name: "" };
    if (host.endsWith("notion.site") || host.endsWith("notion.so")) {
      const last = parts[parts.length - 1] ?? "";
      return { type: "doc", name: short(cap(words(last.replace(/-?[0-9a-f]{32}$/i, "")))) };
    }
    if (host === "docs.google.com" || host === "drive.google.com") return { type: "doc", name: "" };
    if (PLATFORMS.test(host)) return { type: "web", name: "" };
    return { type: "web", name: short(cap(host.split(".")[0])) };
  }

  // The sketch, drawn from a few primitives in cqi so it scales with the screen. Each kind keeps something to circle
  // at the spot where the ring sits. "narrow" is the phone layout: fewer pieces, more height.
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const k = (cls: string, x: number, y: number, w?: number | null, h?: number | null, text = "", size?: number) =>
    `<span class="${cls}" style="left:${x}cqi;top:${y}cqi;${w != null ? `width:${w}cqi;` : ""}${h != null ? `height:${h}cqi;` : ""}${size ? `font-size:${size}cqi;` : ""}">${text}</span>`;
  const bars = (x: number, y: number, ws: number[], gap = 2.4) => ws.map((w, i) => k("t", x, y + i * gap, w)).join("");

  function draw(r: Read, narrow: boolean): string {
    const name = esc(r.name);
    if (narrow) {
      switch (r.type) {
        case "figma":
          return [k("grid", 0, 0), k("o", 4, 15, 3.6, 3.6), k("txt", 9.4, 15.2, null, null, name || "", 3), k("o", 4, 21.5, 92, 88),
            name ? k("name", 8, 26, null, null, name, 6.4) : k("t h", 8, 27, 50) + k("t h", 8, 32, 34), bars(8, 38, [56, 48, 34], 3.2)].join("");
        case "github":
          return [k("o", 5, 15.4, 4, 4), k("txt", 11, 15.6, null, null, `${r.owner ? esc(r.owner.toLowerCase()) + " / " : ""}<b>${name || "repo"}</b>`, 3.4),
            k("t", 5, 24, 9), k("t", 17, 24, 9), k("t", 29, 24, 9), k("dark", 5, 26.4, 9, 0.5),
            k("o", 4, 30, 92, 14), ...[0, 1, 2].map((i) => k("o", 7, 32.4 + i * 3.8, 2.2, 2.2) + k("t", 11, 33.2 + i * 3.8, [30, 22, 36][i])),
            k("o", 4, 47, 92, 62), bars(32, 54, [50, 42], 3.6)].join("");
        case "app":
          return [k("f", 5, 15, 13, 13), name ? k("name", 21.5, 16.4, null, null, name, 5.2) : k("t h", 21.5, 17.5, 40),
            k("txt", 21.5, 23.4, null, null, esc(r.store ?? ""), 2.8), bars(5, 33, [70, 56], 3.4), k("o", 4, 47, 92, 62)].join("");
        case "doc":
          return [k("f", 0, 13.2, 100, 8), k("o", 6, 17, 8, 8), name ? k("name", 6, 28, null, null, name, 6.4) : k("t h", 6, 30, 60),
            k("t", 6, 37.5, 10) + k("t", 19, 37.5, 22), k("f", 4, 46, 92, 21)].join("");
        default:
          return [k("o", 5, 16, 4.4, 4.4), name ? k("txt", 11.4, 16.2, null, null, name.toLowerCase(), 3.4) : k("t", 12, 17.8, 14),
            name ? k("name", 5.6, 24, null, null, name, 9) : k("t h", 6, 26, 62) + k("t h", 6, 31.5, 40), bars(6, 39, [66, 58, 42], 3.2)].join("");
      }
    }
    switch (r.type) {
      case "figma":
        return [k("grid", 0, 0), k("o", 4, 11.4, 2.4, 2.4), k("txt", 7.6, 11.4, null, null, name || "", 1.9),
          k("t", 70, 12.4, 6), k("t", 78, 12.4, 6), k("o pill", 86, 11, 8, 3), k("t", 4, 16.4, 9), k("o", 3.6, 18, 52, 54),
          name ? k("name", 6.5, 21.4, null, null, name, 4.4) : k("t h", 6.5, 21.5, 30) + k("t h", 6.5, 25.2, 20), bars(6.5, 31, [32, 27, 18]),
          k("o", 6.5, 52, 22, 6.5), k("o", 31, 52, 22, 6.5), k("t", 59, 16.4, 7), k("o", 58.6, 18, 18, 32), bars(60.6, 22, [12, 9, 13, 8], 3),
          k("f", 80, 18, 15, 34), bars(82, 21, [10, 7, 9, 6, 10, 8], 3.4)].join("");
      case "github":
        return [k("o", 5, 10.4, 2.6, 2.6), k("txt", 8.8, 10.3, null, null, `${r.owner ? esc(r.owner.toLowerCase()) + " / " : ""}<b>${name || "repo"}</b>`, 2.3),
          k("o pill", 74, 10, 9, 3.4), k("o pill", 84.6, 10, 9, 3.4), k("t", 5, 16.6, 6), k("t", 13, 16.6, 6), k("t", 21, 16.6, 6), k("t", 29, 16.6, 6), k("dark", 5, 18.4, 6, 0.35),
          k("o", 4, 21, 52, 18.5), ...[0, 1, 2, 3, 4].map((i) => k("o", 6, 23 + i * 3.3, 1.6, 1.6) + k("t", 9, 23.5 + i * 3.3, [14, 10, 18, 12, 9][i]) + k("t", 42, 23.5 + i * 3.3, 10)),
          k("o", 4, 41, 52, 30), bars(24, 45, [28, 24, 30, 18], 2.8), k("t", 60, 21.5, 8), bars(60, 25, [32, 28, 22]),
          k("o pill", 60, 33, 9, 2.8), k("o pill", 70.5, 33, 11, 2.8), k("o pill", 60, 37, 13, 2.8)].join("");
      case "app":
        return [k("o", 3.4, 11.5, 27, 58), k("t", 13, 13, 8), k("t h", 6.5, 18, 18), bars(6.5, 23, [20, 16]), k("f", 6.5, 28.5, 20.6, 12), k("o", 6.5, 51.5, 20.6, 7.5),
          k("f", 36, 13, 9, 9), name ? k("name", 47.4, 13.8, null, null, name, 3.6) : k("t h", 47.4, 14.2, 20),
          k("txt", 47.4, 18.6, null, null, esc(r.store ?? ""), 1.6), k("dark pill", 84, 15.5, 9, 3.6), bars(36, 26, [30, 26]),
          k("f", 60, 32, 10, 20), k("f", 71.6, 32, 10, 20), k("f", 83.2, 32, 10, 20)].join("");
      case "doc":
        return [k("f", 0, 9.6, 100, 6), k("o", 6, 13, 5, 5), name ? k("name", 6, 20, null, null, name, 4.6) : k("t h", 6, 21.5, 34),
          k("t", 6, 27, 6) + k("t", 14, 27, 12), k("t", 6, 29.6, 6) + k("t", 14, 29.6, 9), bars(6, 34, [44, 40]), k("f", 4.6, 39.6, 48, 12.6),
          bars(6, 58, [14]), bars(24, 58, [30]), k("t", 72, 21, 10), bars(72, 24.4, [18, 14, 16, 12], 2.6)].join("");
      default:
        return [k("o", 5, 10.2, 2.8, 2.8), name ? k("txt", 8.8, 10.1, null, null, name.toLowerCase(), 2.1) : k("t", 9, 11.2, 7),
          k("t", 58, 11.2, 5.4), k("t", 65.5, 11.2, 5.4), k("t", 73, 11.2, 5.4), k("o pill", 84, 10, 9, 3.6),
          name ? k("name", 5.6, 17.6, null, null, name, 6.6) : k("t h", 6, 19.6, 36) + k("t h", 6, 23.6, 24), bars(6, 30.4, [34, 31, 22]),
          k("f", 58, 19, 35, 29), k("o", 6, 54, 22, 6.5), k("o", 31, 54, 22, 6.5)].join("");
    }
  }

  // Where point 2 sits; point 1 follows the end of the name (or the first heading when there is none).
  const POINT2: Record<Read["type"], [number, number] | null> = { web: [56.4, 17.4], figma: [77.6, 16], github: [56.6, 20], app: [57.6, 30.6], doc: [70, 18.6] };
  // How far right the big name may run on the wide screen, in cqi: up to the next block or point 2, less room for
  // point 1. On the phone the name has its row to itself.
  const ROOM: Record<Read["type"], number> = { web: 49.5, figma: 50, github: 49.5, app: 78, doc: 64 };

  const root = document.querySelector<HTMLElement>("[data-review]");
  const screen = root?.querySelector<HTMLElement>("[data-screen]");
  const sk = root?.querySelector<HTMLElement>("[data-sk]");
  const link = root?.querySelector<HTMLInputElement>("input[name=link]");
  const stuck = root?.querySelector<HTMLTextAreaElement>("textarea[name=stuck]");
  const [pt1, pt2] = [1, 2].map((n) => root?.querySelector<HTMLElement>(`[data-pt="${n}"]`));

  // While the bar is empty, its placeholder types through what can go in it, and the sketch turns into each kind.
  const DEMO: [string, Read][] = [
    ["your-product.com", { type: "web", name: "" }],
    ["App Store link", { type: "app", name: "", store: "App Store" }],
    ["Figma file", { type: "figma", name: "" }],
    ["GitHub repo", { type: "github", name: "" }],
    ["Google Play link", { type: "app", name: "", store: "Google Play" }],
    ["Notion page", { type: "doc", name: "" }],
    ["any link", { type: "web", name: "" }],
  ];
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  if (root && screen && sk && link && pt1 && pt2) {
    wireReviewForm(root);
    const hint = link.placeholder;
    let shown: Read | null = null;
    let last = "";
    let force = false;
    const render = () => {
      // One switch for the phone layout, used by both the sketch and the CSS (.is-narrow), so they never disagree.
      const narrow = screen.clientWidth < 520;
      screen.classList.toggle("is-narrow", narrow);
      const r = link.value.trim() ? read(link.value) : (shown ?? read(""));
      const key = `${narrow}|${r.type}|${r.name}|${r.owner}|${r.store}`;
      screen.classList.toggle("has-link", !!link.value.trim());
      if (key === last) return;
      // A new kind of product draws in piece by piece; a name being typed just updates.
      const kind = force || (last && last.split("|").slice(0, 2).join() !== key.split("|").slice(0, 2).join());
      last = key;
      sk.classList.remove("is-in");
      sk.innerHTML = draw(r, narrow);
      if (kind && !still.matches) {
        [...sk.children].forEach((el, i) => (el as HTMLElement).style.setProperty("--i", String(i)));
        void sk.offsetWidth;
        sk.classList.add("is-in");
      }
      const cqi = screen.clientWidth / 100;
      // Names are cut at 24 characters, but one long word still runs into the next block: then the name gets smaller.
      const name = sk.querySelector<HTMLElement>(".name");
      const room = name ? (narrow ? 88 : ROOM[r.type]) * cqi - name.offsetLeft : 0;
      if (name && name.offsetWidth > room) name.style.fontSize = `${(parseFloat(name.style.fontSize) * room) / name.offsetWidth}cqi`;
      // The big name first, then the headline bar, then the small title (GitHub, an app with no name).
      const head = sk.querySelector<HTMLElement>(".name") ?? sk.querySelector<HTMLElement>(".t.h") ?? sk.querySelector<HTMLElement>(".txt");
      if (head) {
        const y = head.offsetTop + head.offsetHeight / 2 - 1.5 * cqi;
        pt1.style.left = `${Math.min(head.offsetLeft + head.offsetWidth + 1.4 * cqi, screen.clientWidth - 6 * cqi)}px`;
        pt1.style.top = `${y}px`;
      }
      const p2 = narrow ? null : POINT2[r.type];
      pt2.hidden = !p2;
      if (p2) Object.assign(pt2.style, { left: `${p2[0]}cqi`, top: `${p2[1]}cqi` });
    };
    // The note grows with what's written, up to its max-height, so the words stay in view.
    const grow = () => {
      if (!stuck) return;
      stuck.style.height = "auto";
      stuck.style.height = `${stuck.scrollHeight}px`;
    };
    // The ring is drawn again when "what's stuck" changes, so the mark follows the words.
    let redraw = 0;
    stuck?.addEventListener("input", () => {
      grow();
      clearTimeout(redraw);
      redraw = window.setTimeout(() => {
        screen.classList.remove("is-drawn");
        void screen.offsetWidth;
        screen.classList.add("is-drawn");
      }, 350);
    });
    link.addEventListener("input", render);
    // Enter moves on the way the form reads: link → note → contact, and Enter in the contact sends. Shift+Enter in the
    // note is still a new line.
    const contact = root.querySelector<HTMLInputElement>("input[name=contact]");
    const onEnter = (from: HTMLElement, to: HTMLElement | null) =>
      from.addEventListener("keydown", (event) => {
        // keyCode 229: Safari's way of saying an input method is still composing.
        if (event.key !== "Enter" || event.shiftKey || event.isComposing || event.keyCode === 229 || !to) return;
        event.preventDefault();
        to.focus();
      });
    onEnter(link, stuck ?? null);
    if (stuck) onEnter(stuck, contact);

    // A link going in plays the loading line along the bar and the sketch draws in again behind it, like a page
    // loading: pasted — at once, typed — once the typing stops.
    const bar = link.closest<HTMLElement>(".url");
    let loaded = "";
    let typing = 0;
    const load = () => {
      const value = link.value.trim();
      // A cleared bar forgets the last link, so pasting the same one again loads again.
      if (!value) loaded = "";
      if (!bar || !value || value === loaded || still.matches) return;
      loaded = value;
      bar.classList.remove("is-loading");
      void bar.offsetWidth;
      bar.classList.add("is-loading");
      force = true;
      last = "";
      render();
      force = false;
    };
    link.addEventListener("paste", () => requestAnimationFrame(load));
    link.addEventListener("input", () => {
      clearTimeout(typing);
      typing = window.setTimeout(load, 700);
    });
    const again = () => {
      last = "";
      render();
      grow();
    };
    new ResizeObserver(again).observe(screen);
    // Point 1 is placed by the width of the name, which changes once Onest has loaded.
    document.fonts?.ready.then(again);
    render();
    requestAnimationFrame(() => screen.classList.add("is-drawn"));

    // The demo: types a kind into the placeholder, holds it, erases it, moves on. It stops the moment the field is
    // focused (the sketch keeps the kind it was showing) and comes back if the field is left empty.
    let run = 0;
    const pause = (ms: number) => new Promise((done) => setTimeout(done, ms));
    const demo = async () => {
      const id = ++run;
      for (let k = 0; ; k = (k + 1) % DEMO.length) {
        if (id !== run) return;
        const [text, kind] = DEMO[k];
        shown = kind;
        render();
        for (let i = 1; i <= text.length; i++) {
          if (id !== run) return;
          link.placeholder = text.slice(0, i);
          await pause(55);
        }
        await pause(1600);
        for (let i = text.length - 1; i >= 0; i--) {
          if (id !== run) return;
          link.placeholder = text.slice(0, i);
          await pause(24);
        }
        await pause(260);
      }
    };
    const stop = () => {
      run++;
      link.placeholder = hint;
    };
    let resume = 0;
    const start = (delay: number) => {
      clearTimeout(resume);
      if (still.matches || link.value || link.readOnly) return;
      resume = window.setTimeout(demo, delay);
    };
    link.addEventListener("focus", () => {
      clearTimeout(resume);
      stop();
    });
    link.addEventListener("blur", () => start(1400));
    start(1800);
  }
</script>

<style>
  /* The device: a thick, soft bezel with a highlight on top, the screen set into it. */
  /* Rows keep their real height (max-content): while the height glides (review-form.ts) the grid can't squeeze the
     screen row, so the dock never slides up under the screen. */
  .device {
    display: grid;
    grid-auto-rows: max-content;
    gap: 12px;
    padding: 16px;
    border-radius: 36px;
    background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, white 30%, var(--color-off-white)) 100%);
    box-shadow:
      inset 0 1.5px 0 #fff,
      inset 0 -1px 0 color-mix(in srgb, var(--color-black) 6%, transparent),
      0 0 0 0.5px color-mix(in srgb, var(--color-black) 9%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-black) 5%, transparent),
      0 30px 60px -28px color-mix(in srgb, var(--color-black) 30%, transparent);
  }
  .screen {
    --line: color-mix(in srgb, var(--color-black) 12%, transparent);
    --bar: color-mix(in srgb, var(--color-black) 10%, transparent);
    --bar-strong: color-mix(in srgb, var(--color-black) 16%, transparent);
    --graphite: color-mix(in srgb, var(--color-black) 38%, transparent);
    --fill: color-mix(in srgb, var(--color-black) 3%, transparent);
    --name: color-mix(in srgb, var(--color-black) 72%, transparent);
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 20px;
    background: #fbfbfa;
    box-shadow:
      inset 0 1px 3px color-mix(in srgb, var(--color-black) 9%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 8%, transparent);
    container-type: inline-size;
  }
  /* Once there is a link, the product draws in a little darker: it is yours now. */
  .screen.has-link {
    --line: color-mix(in srgb, var(--color-black) 17%, transparent);
    --bar: color-mix(in srgb, var(--color-black) 14%, transparent);
  }
  /* A faint sheen across the glass, like on the /glass icon. */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(118deg, rgb(255 255 255 / 0.45) 0%, rgb(255 255 255 / 0) 34%);
  }

  .bar {
    position: absolute;
    z-index: 4;
    top: 2.2cqi;
    left: 2.4cqi;
    right: 2.4cqi;
    display: flex;
    align-items: center;
    gap: 1.8cqi;
  }
  .dots {
    display: flex;
    gap: 0.9cqi;
  }
  .dots i {
    width: 1.3cqi;
    height: 1.3cqi;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  /* Clips to its pill, so the loading line along the bottom tapers into the rounded ends. */
  .url {
    position: relative;
    overflow: hidden;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    height: max(40px, 4.8cqi);
    border-radius: 999px;
    background: var(--tray);
    box-shadow: var(--recess);
    transition: background-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  /* Filled: a raised white field. In focus: the ink ring on top, so focus shows even when there's text. */
  .has-link .url {
    background: #fff;
    box-shadow: var(--raise);
  }
  .url:focus-within {
    background: #fff;
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink);
  }
  /* A link going in: a thin emerald line runs along the bottom of the bar, like a page loading, then fades. */
  .load {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--emerald);
    transform-origin: left;
    scale: 0 1;
    opacity: 0;
    pointer-events: none;
  }
  .url:global(.is-loading) .load {
    animation: load 760ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes load {
    0% {
      scale: 0 1;
      opacity: 1;
    }
    75% {
      scale: 1 1;
      opacity: 1;
    }
    100% {
      scale: 1 1;
      opacity: 0;
    }
  }
  /* The whole bar and the whole note take a click into their field. */
  .url,
  .note {
    cursor: text;
  }
  .is-done .url,
  .is-done .note {
    cursor: default;
  }
  /* The question in the bar: room from the rounded end, and a pixel lower, where it sits level with the typed link. */
  .url b {
    flex: none;
    max-width: 14em;
    overflow: hidden;
    padding: 1px max(10px, 1.4cqi) 0 max(16px, 2.2cqi);
    border-right: 1px solid var(--line);
    font-size: max(12px, 1.35cqi);
    font-weight: 500;
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0.7;
    transition: max-width 360ms cubic-bezier(0.6, 0, 0.2, 1), padding 360ms cubic-bezier(0.6, 0, 0.2, 1), opacity 200ms ease-out,
      border-color 200ms ease-out;
  }
  /* A link is in: the question folds away and the link gets the bar. It stays in the label for screen readers. */
  .has-link .url b {
    max-width: 0;
    padding-right: 0;
    padding-left: 0;
    border-right-color: transparent;
    opacity: 0;
  }
  .has-link .url input {
    padding-left: max(16px, 2.2cqi);
  }
  input,
  textarea {
    width: 100%;
    border: 0;
    color: var(--ink);
    font: inherit;
    letter-spacing: inherit;
  }
  /* 16px and up, or iPhone zooms into the field on focus. */
  .url input {
    height: 100%;
    padding: 0 1.6cqi;
    background: none;
    font-size: max(16px, 1.75cqi);
    outline: none;
    transition: padding 360ms cubic-bezier(0.6, 0, 0.2, 1);
  }

  /* The product sketch: thin bars for text, outlines for boxes; the name from the link in real type. */
  .sk {
    position: absolute;
    inset: 0;
  }
  .sk > :global(span) {
    position: absolute;
  }
  /* A new kind of product draws in piece by piece, top to bottom (--i is the order, set by the script); the name
     wipes in left to right, as if typed. */
  .sk:global(.is-in) > :global(span) {
    animation: sk-in 460ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 18ms);
  }
  .sk:global(.is-in) > :global(.name) {
    animation-name: sk-name;
    animation-duration: 560ms;
  }
  @keyframes sk-in {
    from {
      opacity: 0;
      translate: 0 0.9cqi;
    }
  }
  /* The clip reaches past the line box, so descenders (p, y) aren't cut while it plays. */
  @keyframes sk-name {
    from {
      clip-path: inset(-30% 100% -30% 0);
    }
    to {
      clip-path: inset(-30% -10% -30% 0);
    }
  }
  .sk :global(.t) {
    height: 0.62cqi;
    border-radius: 999px;
    background: var(--bar);
  }
  .sk :global(.t.h) {
    height: 1.9cqi;
    background: var(--bar-strong);
  }
  .sk :global(.o) {
    border: 1px solid var(--line);
    border-radius: 1.2cqi;
  }
  .sk :global(.f) {
    border: 1px solid var(--line);
    border-radius: 1.2cqi;
    background: var(--fill);
  }
  .sk :global(.pill) {
    border-radius: 999px;
  }
  .sk :global(.dark) {
    border: 0;
    background: var(--bar-strong);
  }
  .sk :global(.txt) {
    color: var(--graphite);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .sk :global(.txt b) {
    color: var(--name);
  }
  .sk :global(.name) {
    color: var(--name);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .sk :global(.grid) {
    inset: 9.6cqi 0 0 0;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-black) 11%, transparent) 0.12cqi, transparent 0.14cqi) 0 0 / 1.8cqi 1.8cqi;
  }

  /* The review marks, in ink. */
  .cta {
    position: absolute;
    z-index: 1;
    left: 6cqi;
    top: 44cqi;
    width: 15cqi;
    height: 4.6cqi;
    border-radius: 999px;
    background: var(--bar-strong);
  }
  .ring {
    position: absolute;
    z-index: 2;
    left: 1.6cqi;
    top: 40.6cqi;
    width: 24cqi;
    height: 11.4cqi;
    overflow: visible;
  }
  .ring path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
    /* The gap is longer than the dash, so the round cap leaves no dot before the ring is drawn. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
  }
  .is-drawn .ring path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 720ms cubic-bezier(0.6, 0, 0.2, 1);
  }
  .pt {
    position: absolute;
    z-index: 2;
    width: 3cqi;
    height: 3cqi;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    font-size: 1.55cqi;
    font-weight: 600;
    letter-spacing: 0;
    /* The points glide to their new place when the sketch changes or the name grows. */
    transition: left 420ms cubic-bezier(0.3, 1.25, 0.4, 1), top 420ms cubic-bezier(0.3, 1.25, 0.4, 1);
  }
  /* "What I see, what I'd do, what it would cost" on the page points here (review.astro): hovering 1 or 2 makes its
     mark jump, with an emerald ring while it moves; 3 is said in the video, so the camera nods. */
  .pt:global(.is-ping) {
    animation: ping 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  /* Soft: a little bigger, a light grey fill and a faint emerald ring; the number keeps its ink, so the mark answers
     the hover without shouting over the sketch. */
  @keyframes ping {
    40% {
      scale: 1.3;
      background: color-mix(in srgb, var(--color-black) 9%, #fff);
      box-shadow: 0 0 0 0.7cqi color-mix(in srgb, var(--emerald) 16%, transparent);
    }
  }
  .cam i:global(.is-ping) {
    animation: nod 560ms cubic-bezier(0.3, 1.5, 0.4, 1);
  }
  @keyframes nod {
    40% {
      scale: 1.1;
    }
  }
  /* The numbers are drawn, not text: they belong to the picture. */
  .pt::before {
    content: attr(data-pt);
  }
  .pt[hidden] {
    display: none;
  }

  /* The note = the "What's stuck?" field. */
  .note {
    position: absolute;
    z-index: 2;
    left: 28cqi;
    top: 38cqi;
    width: 27cqi;
    /* The field reaches 0.7cqi into the sides (margin below), so 0.9cqi is left there; the bottom matches. */
    padding: 1.3cqi 1.6cqi 0.9cqi;
    border-radius: 1.4cqi;
    background: linear-gradient(180deg, #fff, #fafaf8);
    box-shadow: var(--raise), 0 2.2cqi 3cqi -2cqi rgb(0 0 0 / 0.18);
    transform: rotate(-2.5deg) translateY(0.8cqi);
    opacity: 0;
    transition: transform 420ms cubic-bezier(0.3, 1.3, 0.4, 1) 520ms, opacity 200ms 520ms, box-shadow 160ms, translate 200ms ease-out;
  }
  .is-drawn .note {
    transform: rotate(-2.5deg);
    opacity: 1;
  }
  .note:focus-within {
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink), 0 2.2cqi 3cqi -2cqi rgb(0 0 0 / 0.18);
  }
  /* The pin. */
  .note::before {
    content: "";
    position: absolute;
    top: -0.7cqi;
    left: 50%;
    width: 1.5cqi;
    height: 1.5cqi;
    border-radius: 50%;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge), 0 0.2cqi 0.3cqi rgb(0 0 0 / 0.3);
    transform: translateX(-50%);
    transition: transform 240ms cubic-bezier(0.3, 1.5, 0.4, 1), box-shadow 240ms ease-out;
  }
  /* Writing on the note pushes the pin in: smaller, its shadow gone into the screen. */
  .review-screen:not(.is-done) .note:focus-within::before {
    transform: translateX(-50%) scale(0.8);
    box-shadow: inset 0 0.15cqi 0.2cqi rgb(0 0 0 / 0.55), 0 0 0 0.5px rgb(0 0 0 / 0.5);
  }
  .note b {
    display: block;
    margin-bottom: 0.4cqi;
    font-size: max(11px, 1.25cqi);
    font-weight: 500;
    opacity: 0.7;
  }
  /* The field drawn on the note: a recessed tray, like the address bar, while it's empty; in focus a white field; once
     there are words, they sit on the paper. */
  .note .field {
    display: block;
    margin: 0 -0.7cqi;
    padding: 0.5cqi 0.7cqi;
    border-radius: 0.8cqi;
    background: var(--tray);
    box-shadow: var(--recess);
    transition: background-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .note:focus-within .field {
    background: #fff;
    box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 12%, transparent);
  }
  .note:not(:focus-within) .field:has(textarea:not(:placeholder-shown)),
  .is-done .note .field {
    background: none;
    box-shadow: none;
  }
  /* Sent with nothing written: the note stays blank, not an example that reads like an answer. */
  .is-done .note textarea::placeholder {
    color: transparent;
  }
  /* Grows with the words (the script sets the height) up to four lines (three on the phone), then scrolls without
     a scrollbar. */
  .note textarea {
    display: block;
    min-height: 2.6em;
    max-height: 4.9em;
    padding: 0;
    background: none;
    resize: none;
    font-size: max(16px, 1.9cqi);
    font-weight: 500;
    line-height: 1.2;
    outline: none;
    scrollbar-width: none;
  }
  .note textarea::-webkit-scrollbar {
    display: none;
  }
  .note textarea::placeholder {
    color: color-mix(in srgb, var(--color-black) 35%, transparent);
  }

  /* The reviewer's camera, like the face bubble in a screen recording, signed: the favicon's coin. Toned down to a soft
     graphite with no drop shadow while there's no sample review behind it, so it doesn't read as something to press. */
  .cam {
    position: absolute;
    z-index: 2;
    right: 2.4cqi;
    bottom: 2.4cqi;
    display: grid;
    justify-items: center;
    gap: 0.8cqi;
  }
  .cam i {
    position: relative;
    width: 11cqi;
    height: 11cqi;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(180deg, #8a8a88 0%, #747472 100%);
    box-shadow:
      inset 0 0.5px 0 rgb(255 255 255 / 0.2),
      0 0 0 0.5cqi #fbfbfa,
      0 0 0 calc(0.5cqi + 1px) var(--line);
  }
  .cam .smile {
    width: 62%;
    fill: #f6f6f4;
  }
  .cam .smile path {
    fill: none;
    stroke: #f6f6f4;
    stroke-width: 4.4;
    stroke-linecap: round;
  }
  /* The sweep sits on the hairline around the coin, draws once clockwise from the top (the path starts there), then
     fades: emerald only while it moves. */
  .cam .rec {
    position: absolute;
    top: calc(-0.5cqi - 1px);
    left: calc(-0.5cqi - 1px);
    width: calc(100% + 1cqi + 2px);
    height: calc(100% + 1cqi + 2px);
    overflow: visible;
    fill: none;
    stroke: var(--emerald);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .is-done .cam .rec {
    animation: rec 1.3s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes rec {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    65% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  .cam span {
    color: color-mix(in srgb, var(--color-black) 58%, transparent);
    font-size: max(10px, 1.15cqi);
    font-weight: 500;
  }

  /* Under the screen: the contact field and SEND, a dock. */
  .dock {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 0 2px;
  }
  .dock[hidden],
  .below[hidden] {
    display: none;
  }
  .dock label {
    padding-left: 8px;
    font-size: var(--text-meta);
    font-weight: 500;
  }
  .dock input {
    height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: var(--recess);
    font-size: var(--text-body);
    transition: background-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .dock input:focus {
    outline: none;
    background: #fff;
    box-shadow: var(--raise), 0 0 0 1.5px var(--ink);
  }
  /* Under the mouse a field shows it takes typing before it's clicked (tokens.css); the note lifts a little off the
     screen. Focus keeps its own look, and nothing reacts once the request is in. */
  @media (hover: hover) {
    .review-screen:not(.is-done) .url:not(:focus-within):hover,
    .review-screen:not(.is-done) .dock input:not(:focus):hover {
      background: var(--tray-hover);
      box-shadow: var(--recess), var(--hover-edge);
    }
    .review-screen:not(.is-done) .has-link .url:not(:focus-within):hover {
      background: #fff;
      box-shadow: var(--raise), var(--hover-edge);
    }
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover {
      translate: 0 -0.6cqi;
      box-shadow: var(--raise), var(--hover-edge), 0 3.4cqi 4cqi -2cqi rgb(0 0 0 / 0.24);
    }
    /* The field on the note keeps its tray (lighter would vanish into the paper) and gets the hover edge. */
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover .field:has(textarea:placeholder-shown) {
      box-shadow: var(--recess), var(--hover-edge);
    }
    /* While lifted, a strip under the note keeps the hover, or a mouse at its bottom edge would make it jitter. */
    .review-screen:not(.is-done) .is-drawn .note:not(:focus-within):hover::after {
      content: "";
      position: absolute;
      inset: auto 0 -0.9cqi;
      height: 0.9cqi;
    }
  }
  /* SEND with a required field empty (review-form.ts): one short red flash on the field and a message under it, instead
     of the browser's bubble; the classes go when the flash ends, the message when the field gets something. Red is
     only for errors: this and the failed-send line below. The field that takes focus (.is-invalid-focused) flashes from its focus look, so the ring fades
     into the ink ring instead of jumping. */
  @keyframes invalid {
    0%,
    45% {
      background-color: color-mix(in srgb, var(--error) 6%, #fff);
      box-shadow: var(--recess), 0 0 0 1.5px var(--error);
    }
  }
  @keyframes invalid-focus {
    0%,
    45% {
      background-color: color-mix(in srgb, var(--error) 6%, #fff);
      box-shadow: var(--raise), 0 0 0 1.5px var(--error);
    }
  }
  .url.is-invalid,
  .dock input.is-invalid {
    animation: invalid 1.2s ease-out;
  }
  .url.is-invalid-focused,
  .dock input.is-invalid-focused {
    animation-name: invalid-focus;
  }
  .err {
    position: relative;
    width: max-content;
    max-width: 100%;
    padding: 5px 10px;
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--raise);
    color: var(--error);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }
  .err[hidden] {
    display: none;
  }
  /* The tick pointing up at the field. */
  .err::before {
    content: "";
    position: absolute;
    top: -4px;
    left: 16px;
    width: 8px;
    height: 8px;
    background: #fff;
    box-shadow: -0.5px -0.5px 0 color-mix(in srgb, var(--color-black) 10%, transparent);
    transform: rotate(45deg);
  }
  /* Under the address bar, over the sketch; under the contact field, in the dock's second row. */
  .bar .err {
    position: absolute;
    top: calc(100% + 8px);
    left: 7.5cqi;
  }
  .dock .err {
    grid-column: 2;
    grid-row: 2;
    margin-top: -2px;
  }
  .dock button {
    grid-column: 3;
    grid-row: 1;
  }

  button {
    height: 46px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
    font: inherit;
    font-weight: 500;
    letter-spacing: inherit;
    cursor: pointer;
    transition: transform 120ms ease-out, filter 120ms ease-out, opacity 120ms ease-out, box-shadow 120ms ease-out;
  }
  button:hover {
    filter: brightness(1.12);
  }
  /* Pressed: the button goes into the dock — down a pixel, the light edge gives way to an inner shadow. */
  button:active {
    transform: translateY(1px) scale(0.99);
    box-shadow: inset 0 1.5px 3px rgb(0 0 0 / 0.55), 0 0 0 0.5px rgb(0 0 0 / 0.5);
    filter: brightness(0.92);
  }
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .below,
  .error {
    margin: 0;
    padding: 0 10px;
    font-size: 12px;
    line-height: 1.5;
  }
  .below {
    opacity: 0.7;
  }
  .error a {
    color: inherit;
  }
  /* A failed send: the line flashes red for a moment on every try, so it's seen even when it was already there. */
  .error {
    justify-self: start;
    padding: 3px 10px;
    border-radius: 8px;
  }
  .error:global(.is-flash) {
    animation: error-flash 1.2s ease-out;
  }
  @keyframes error-flash {
    0%,
    45% {
      background-color: color-mix(in srgb, var(--error) 8%, transparent);
      color: var(--error);
    }
  }
  .trap {
    display: none;
  }
  .done {
    outline: none;
  }
  .done p {
    margin: 0;
    padding: 6px 10px 8px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  /* A long email in the answer breaks anywhere rather than widen the form. */
  .done :global([data-contact]) {
    overflow-wrap: anywhere;
  }
  /* The answer comes in as the sweep around the camera closes. */
  .is-done .done p {
    animation: done-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) 700ms backwards;
  }
  @keyframes done-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /* A narrow screen (the script sets .is-narrow under 520px of screen width, whatever the window is): a taller frame,
     the review layer moves down to make room, and the sketch draws its narrow version. */
  .screen.is-narrow {
    aspect-ratio: 1 / 1.04;
  }
  .is-narrow .cta {
    left: 7cqi;
    top: 52cqi;
    width: 22cqi;
    height: 7cqi;
  }
  .is-narrow .ring {
    left: 1cqi;
    top: 47cqi;
    width: 34cqi;
    height: 16.5cqi;
  }
  .is-narrow .note {
    left: 9cqi;
    top: 67cqi;
    width: 66cqi;
    padding: 2.4cqi 3cqi 2.3cqi;
  }
  .is-narrow .note b {
    font-size: 11px;
  }
  .is-narrow .note textarea {
    min-height: 2.4em;
    max-height: 3.7em;
  }
  .is-narrow .pt {
    width: 5cqi;
    height: 5cqi;
    font-size: 2.6cqi;
  }
  .is-narrow .cam {
    right: 3cqi;
    bottom: 3cqi;
