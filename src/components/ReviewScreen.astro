    onEnter(what, who);
    onEnter(stuck, contact);
    onEnter(who, contact);

    // A link going in plays the loading line along the bar and the sketch draws in again behind it, like a page
    // loading: pasted — at once, typed — once the typing stops.
    const bar = link.closest<HTMLElement>(".url");
    let loaded = "";
    let typing = 0;
    const load = () => {
      const value = link.value.trim();
