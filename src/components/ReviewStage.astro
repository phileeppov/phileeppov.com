---
// The stage on /review: the video review you'll get, sketched. A screen with an outline of a product page,
// your link in the address bar and your "what's stuck" as a note by the circled button, the reviewer in the
// corner (☺) and the three chapters of every review (site.md §1.4). It mirrors the form as you type (ReviewForm.astro).
// It doesn't react to the submit: a filled-in player would read as a review that's already done.
// Decorative: hidden from screen readers.
---

<figure class="stage" data-stage aria-hidden="true">
  <div class="screen">
    <div class="bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url" data-stage-url></span>
    </div>
    <div class="page">
      <div class="nav"><b class="logo"></b><b></b><b></b><b></b><b class="pill"></b></div>
      <div class="hero">
        <b class="h"></b>
        <b class="h short"></b>
        <b class="t"></b>
        <b class="t shorter"></b>
        <span class="cta">
          <b></b>
          <!-- Same aspect as the ring box (27 × 11.8 cqi), so the stroke keeps one width all the way round. -->
          <svg class="ring" viewBox="0 0 229 100" preserveAspectRatio="none">
            <path
              pathLength="1"
              d="M34,66 C16,42 50,10 116,9 C182,8 223,24 220,50 C217,79 168,94 110,93 C54,92 12,79 22,50 C27,36 46,28 66,24"
            />
          </svg>
          <span class="note" data-stage-note data-default="landing not converting">landing not converting</span>
        </span>
      </div>
      <b class="img"></b>
      <div class="cards"><b></b><b></b><b></b></div>
    </div>
    <span class="face"></span>
  </div>
  <div class="chapters">
    <span>What I see</span>
    <span>What I'd do</span>
    <span>What it would cost</span>
  </div>
</figure>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const url = stage?.querySelector<HTMLElement>("[data-stage-url]");
  const note = stage?.querySelector<HTMLElement>("[data-stage-note]");
  const link = document.querySelector<HTMLInputElement>("#review-link");
  const stuck = document.querySelector<HTMLInputElement>("#review-stuck");

  if (stage && url && note) {
    // The ring redraws when the note changes: drop the class, force a reflow, add it back.
    let redraw = 0;
    const ring = () => {
      clearTimeout(redraw);
      redraw = window.setTimeout(() => {
        stage.classList.remove("is-drawn");
        void stage.offsetWidth;
        stage.classList.add("is-drawn");
      }, 350);
    };
    const showLink = () => {
      if (link) url.textContent = link.value.trim().replace(/^https?:\/\/(www\.)?/i, "");
    };
    const showStuck = () => {
      const text = stuck?.value.trim() || note.dataset.default || "";
      if (note.textContent === text) return false;
      note.textContent = text;
      return true;
    };
    link?.addEventListener("input", showLink);
    stuck?.addEventListener("input", () => showStuck() && ring());
    // Fields the browser restored on reload are already filled in, so mirror them once at the start.
    showLink();
    showStuck();
    requestAnimationFrame(() => stage.classList.add("is-drawn"));
  }
</script>

<style>
  /* The device: a raised white frame like the /glass panel, a recessed screen inside. */
  .stage {
    margin: 0;
    padding: 14px 14px 16px;
    border-radius: 32px;
    background: var(--surface);
    box-shadow: var(--float);
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 20px;
    background: color-mix(in srgb, white 70%, var(--color-off-white));
    box-shadow: var(--recess);
    container-type: inline-size;
  }
  /* Everything inside scales with the screen width (cqi), so the sketch keeps its proportions on a phone. */
  .bar {
    position: absolute;
    top: 2.4cqi;
    left: 2.6cqi;
    right: 2.6cqi;
    display: flex;
    align-items: center;
    gap: 2cqi;
  }
  .dots {
    display: flex;
    gap: 1cqi;
  }
  .dots i {
    width: 1.4cqi;
    height: 1.4cqi;
    border-radius: 50%;
    background: var(--tray);
    box-shadow: var(--recess);
  }
  .url {
    flex: 1;
    min-width: 0;
    height: 4.6cqi;
    display: flex;
    align-items: center;
    padding: 0 2.2cqi;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: var(--recess);
    color: var(--ink);
    font-size: max(11px, 1.9cqi);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Empty address bar: a caret, waiting for your link. */
  .url:empty::after {
    content: "";
    width: 1px;
    height: 2.4cqi;
    background: var(--ink);
    animation: caret 1.1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* The product page, in outline: grey blocks only, so any product fits. */
  .page {
    position: absolute;
    inset: 10cqi 4.4cqi 4cqi;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: auto 1fr auto;
    gap: 3.6cqi 4.4cqi;
  }
  .page b {
    display: block;
    border-radius: 1.2cqi;
    background: color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  .nav {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 2cqi;
  }
  .nav b {
    width: 6cqi;
    height: 1.4cqi;
  }
  .nav .logo {
    width: 3.6cqi;
    height: 3.6cqi;
    margin-right: auto;
    border-radius: 1cqi;
    background: color-mix(in srgb, var(--color-black) 12%, transparent);
  }
  .nav .pill {
    width: 10cqi;
    height: 3.6cqi;
    border-radius: 999px;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6cqi;
  }
  .hero .h {
    width: 100%;
    height: 4.2cqi;
    background: color-mix(in srgb, var(--color-black) 10%, transparent);
  }
  .hero .short {
    width: 70%;
  }
  .hero .t {
    width: 86%;
    height: 1.4cqi;
    margin-top: 0.6cqi;
  }
  .hero .shorter {
    width: 62%;
    margin-top: 0;
  }
  .img {
    grid-row: 2;
    grid-column: 2;
    border-radius: 2cqi !important;
  }
  .cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.6cqi;
  }
  .cards b {
    height: 6cqi;
    border-radius: 1.6cqi;
  }

  /* The button that's stuck: circled by hand, with your note next to it. */
  .cta {
    position: relative;
    margin-top: 2cqi;
  }
  .cta > b {
    width: 17cqi;
    height: 5cqi;
    border-radius: 999px !important;
    background: color-mix(in srgb, var(--color-black) 18%, transparent) !important;
  }
  .ring {
    position: absolute;
    left: -5cqi;
    top: -3.4cqi;
    width: calc(100% + 10cqi);
    height: calc(100% + 6.8cqi);
    overflow: visible;
  }
  .ring path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
    /* The gap is longer than the dash, so the round cap leaves no dot before the ring is drawn. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
  }
  .is-drawn .ring path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 720ms cubic-bezier(0.6, 0, 0.2, 1);
  }
  .note {
    position: absolute;
    left: calc(100% + 6cqi);
    top: 50%;
    width: max-content;
    max-width: 30cqi;
    padding: 1.2cqi 1.8cqi;
    border-radius: 1.8cqi;
    background: var(--surface);
    box-shadow: var(--raise);
    font-size: max(11px, 1.9cqi);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
    /* The field takes 500 characters; the note shows three lines of them. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-50%) rotate(-3deg) scale(0.9);
  }
  .is-drawn .note {
    opacity: 1;
    transform: translateY(-50%) rotate(-3deg);
    transition: opacity 200ms ease-out 520ms, transform 420ms cubic-bezier(0.3, 1.3, 0.4, 1) 520ms;
  }

  /* The reviewer's camera: a dark bubble, signed. */
  .face {
    position: absolute;
    right: 2.6cqi;
    bottom: 2.6cqi;
    width: 13cqi;
    height: 13cqi;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge), 0 1.6cqi 3.6cqi -1.4cqi rgb(0 0 0 / 0.45);
    color: var(--color-off-white);
    font-size: 6.4cqi;
    line-height: 1;
  }
  /* The signature as text, not emoji (FE0E), drawn in CSS: it's a picture, not copy. */
  .face::before {
    content: "\263A\FE0E";
  }

  /* Chapters: three recessed tracks, the first one under way. */
  .chapters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 14px 6px 0;
    font-size: var(--text-meta);
  }
  .chapters span {
    position: relative;
    padding-top: 12px;
    opacity: 0.6;
    line-height: 1.25;
  }
  .chapters span::before,
  .chapters span::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 4px;
    border-radius: 4px;
  }
  .chapters span::before {
    right: 0;
    background: var(--tray);
    box-shadow: var(--recess);
  }
  .chapters span::after {
    width: 0;
    background: var(--ink);
  }
  .is-drawn .chapters span:first-child::after {
    width: 38%;
    transition: width 1.4s cubic-bezier(0.3, 0.9, 0.4, 1) 200ms;
  }
  .chapters span:first-child {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage *,
    .stage *::before,
    .stage *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
