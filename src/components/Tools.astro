---
// Tools on the home page (site.md §1.8): chefkiss and Glass, on a full-width black band: the wall goes dark for its
// two objects. No tiles: each object stands straight on the black with its wall label under it (name, line, address).
// The chefkiss tile does what its line says: the 💩 under an answer goes down, the answer folds away and a shorter,
// better-shaped one is written in its place. Desktop: under the hand or keyboard focus, and back on leaving. Touch:
// once, when the tile is first in view or on the first touch. With reduced motion: the pressed state, still.
// Material: the chefkiss pills raised and light, the only raised things on the band (they are what you press).
import { Image } from "astro:assets";
import ChefkissArt from "./ChefkissArt.astro";
import glass from "../assets/tools/glass.png";
---

<section class="tools" aria-labelledby="tools-label">
  <h2 class="label" id="tools-label">TOOLS</h2>
  <div class="tiles grid">
    <a class="tile ck" href="/chefkiss/" data-count="site:chefkiss">
      <!-- The drawing (ChefkissArt): the end of an answer in Claude Code and the three buttons under it. -->
      <div class="art"><ChefkissArt /></div>
      <p class="name">chefkiss</p>
      <p class="line">A 💩 button for AI&nbsp;slop. Claude takes the&nbsp;hint.</p>
      <p class="where">phileeppov.com/chefkiss</p>
    </a>
    <a class="tile gl" href="/glass/" data-count="site:glass">
      <div class="art dark" aria-hidden="true">
        <span class="icon"><Image src={glass} alt="" widths={[260, 520]} sizes="(max-width: 560px) 40vw, 260px" /></span>
      </div>
      <p class="name">Glass</p>
      <p class="line">Drop a logo, get it back in glass.</p>
      <p class="where">phileeppov.com/glass</p>
    </a>
  </div>
</section>

<script>
  // A touch screen has no hover: the press plays once, when the chefkiss tile has been in view for a moment, or on the
  // first touch, and stays. The class only switches states; the motion is in CSS (none with reduced motion).
  const tile = document.querySelector<HTMLElement>(".tools .ck");
  if (tile && !matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let timer = 0;
    const play = () => {
      tile.classList.add("fixed");
      io.disconnect();
    };
    const io = new IntersectionObserver(
      ([e]) => {
        clearTimeout(timer);
        if (e.isIntersecting) timer = window.setTimeout(play, 500);
      },
      // Only once it reaches the middle of the screen: not on load while the hero is being read.
      { threshold: 0.8, rootMargin: "-30% 0px -30% 0px" },
    );
    io.observe(tile.querySelector(".chat")!);
    tile.addEventListener("touchstart", play, { once: true, passive: true });
  }
  // Guests from the chefkiss repository (its Website link carries ?from=chefkiss) see their tool answer them: the press
  // plays once by itself, a moment after the page opens, and stays.
  if (tile && new URLSearchParams(location.search).get("from") === "chefkiss") {
    window.setTimeout(() => tile.classList.add("fixed"), 1200);
  }

  // Glass comes alive under the hand with its own engine (see glass-tile.js). Desktop only, never with reduced motion.
  // The engine loads when the hand first comes onto the band, so it is ready by the time it reaches the tile; if the
  // tile is already under the hand when it is ready, it plays then. Until then, and on any failure, the picture stays.
  const gl = document.querySelector<HTMLElement>(".tools .gl");
  const band = document.querySelector<HTMLElement>(".tools");
  if (
    gl &&
    band &&
    matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    let pending: PointerEvent | null = null;
    const note = (e: PointerEvent) => (pending = e.pointerType === "mouse" ? e : null);
    const forget = () => (pending = null);
    gl.addEventListener("pointerenter", note);
    gl.addEventListener("pointermove", note);
    gl.addEventListener("pointerleave", forget);
    band.addEventListener(
      "pointerenter",
      () => {
        import("../scripts/glass-tile.js")
          .then(({ glassTile }) => glassTile(gl))
          .then((live) => {
            gl.removeEventListener("pointerenter", note);
            gl.removeEventListener("pointermove", note);
            gl.removeEventListener("pointerleave", forget);
            if (live && pending) live.enter(pending);
          })
          .catch(() => {});
      },
      { once: true },
    );
  }
</script>

<style>
  /* The band: the full width of the window, black. The label at its top as on every part of the wall, the two objects
     72px under it standing on one line, their labels under them. */
  .tools {
    margin-inline: calc(var(--bleed, 24px) * -1);
    padding: 24px max(var(--bleed, 24px), (100% + 2 * var(--bleed, 24px) - 1392px) / 2) 120px;
    background: var(--color-black);
    color: var(--color-off-white);
  }
  .tools .label {
    opacity: 0.6;
  }
  /* Both objects in boxes of one height, standing on the box's foot: their labels start on one line. */
  .tiles {
    margin-top: 72px;
    align-items: start;
  }
  .tile {
    display: grid;
    align-content: start;
    gap: 2px;
    color: inherit;
    text-decoration: none;
  }
  .ck {
    grid-column: 1 / span 6;
  }
  /* Glass from column 7, the caption line of the whole wall. */
  .gl {
    grid-column: 7 / span 6;
  }
  .tile:focus-visible {
    outline: 2px solid var(--color-off-white);
    outline-offset: 8px;
    border-radius: 4px;
  }
  /* The object: no frame, no surface, straight on the band. */
  .art {
    position: relative;
    display: grid;
    height: 300px;
    margin-bottom: 44px;
  }
  /* The glint (glint.js) rings the object itself, not its box: 16px out from what is drawn, the corners rounded.
     chefkiss: the drawing's box, which ends on the right where the drawing does. */
  .ck .art {
    margin-right: 8%;
  }
  /* At rest the rows start 20px in and the top row ~27px down in the fade: the ring stands 16px off what is drawn
     on every side, so 4px in at the left (28px from the window, near the wall's 24) and 11px down at the top. */
  .ck .art:global(.glint)::after {
    inset: 11px -16px -16px 4px;
    border-radius: 28px;
  }
  .art.dark {
    place-items: end start;
  }
  /* Glass: the icon, 240px inside its 260 × 250 picture (10px each side, 5px top and bottom), its corner ~56px. The
     ring stands 16px off the icon on every side, its corner 72px: the same curve, 16px out. */
  .icon {
    position: relative;
    display: block;
    width: 260px;
  }
  .icon:global(.glint)::after {
    inset: -11px -6px -11px -6px;
    border-radius: 72px;
  }
  /* The picture's own black is a shade darker than the band: lighten lets the band show through it. */
  .art.dark img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: lighten;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* The live glass (glass-tile.js) over the picture, the same size: the picture is a crop of the square the glass is
     drawn in, its top 10 of 520 px off. Hidden until its first frame is drawn, which is the picture's own; while it
     plays the picture steps out, and when it has settled back the picture returns under it and it fades. */
  .art.dark :global(canvas) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 260px;
    height: 260px;
    translate: 0 calc(100% * 10 / 520);
    mix-blend-mode: lighten;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease-out,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .gl.is-live .art :global(canvas) {
    opacity: 1;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .gl.is-live .art img {
    opacity: 0;
  }
  /* Glass lifts a little under the hand; chefkiss answers with its press instead. */
  @media (hover: hover) {
    .gl:hover .art img,
    .gl:hover .art :global(canvas) {
      transform: translateY(-4px);
    }
  }
  .name {
    margin: 0;
    font-weight: 500;
  }
  .line {
    margin: 0;
    text-wrap: pretty;
  }
  .where {
    margin: 6px 0 0;
    font-size: var(--text-meta);
    opacity: 0.5;
  }

  /* Narrower: the two objects share the band evenly. */
  @media (max-width: 1023px) {
    .ck {
      grid-column: 1 / span 6;
    }
    .gl {
      grid-column: 7 / span 6;
    }
    .art {
      height: 300px;
    }
  }
  /* Phone: two square objects side by side, the drawing scaled to them. */
  @media (max-width: 560px) {
    .tools {
      padding-bottom: 72px;
    }
    .tiles {
      margin-top: 40px;
    }
    .art {
      height: auto;
      aspect-ratio: 1;
      margin-bottom: 16px;
    }
    .ck .art {
      margin-right: 0;
    }
    .icon {
      width: 100%;
    }
    .art.dark :global(canvas) {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
  }
</style>
