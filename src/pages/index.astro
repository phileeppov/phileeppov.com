---
// Home: site.md §1, the MVP in the /review style (Site.astro: Onest, monochrome, depth in the controls).
// Hero: the "who" line from §8.1 in place of the temporary §1.1 hero. Cases are left out while they're being redone;
// in their place, the tools. The form lives on /review: both buttons lead there instead of repeating it here.
// The arrows turn into emeralds under a moving pointer (data-gem, Site.astro).
import Site from "../layouts/Site.astro";
import Tools from "../components/Tools.astro";
---

<Site description="Nikita Filippov, product designer. I redesigned game recording in Medal.tv, an app with 3M daily users." image="/review-og.png">
  <main class="page home">
    <section class="hero">
      <h1><span>Nikita Filippov, product designer.</span> <span>I&nbsp;redesigned game recording in&nbsp;Medal.tv, an&nbsp;app with 3M daily&nbsp;users.</span></h1>
      <a class="btn" href="/review/" data-gem data-count="site:hero">Send a link, get a video review <span class="arw">→</span></a>
    </section>

    <Tools />

    <section class="row how" aria-labelledby="how-label">
      <h2 class="label caps" id="how-label">HOW I WORK</h2>
      <div class="moments">
        <p><span>You send me your product.</span> <span>A landing page, an onboarding flow, a product that doesn't exist yet.</span> <span>Whatever you're stuck on.</span></p>
        <p><span>I send back a free video review within 48&nbsp;hours.</span> <span>What I see, what I'd do, what it would cost.</span> <span>If we're not aligned, we stop there. You keep the review.</span></p>
        <p><span>If we are, we work async.</span> <span>Video updates, shared Figma, decisions in writing.</span> <span>Calls when useful.</span></p>
        <p><span>A pharmacy website went from my spec to launch in six weeks.</span> <span>Longer partnerships run on a monthly retainer, after the first project.</span></p>
      </div>
    </section>

    <!-- The manifesto preview folded to one line (site.md §1.2: the list stood between the promise and the proof). -->
    <section class="row principles">
      <span class="label" aria-hidden="true"></span>
      <div class="one">
        <p>Five principles I work by:</p>
        <a class="link" href="/manifesto/" data-gem data-count="site:manifesto"><span class="arw">→</span> Read full manifesto</a>
      </div>
    </section>

    <section class="row about">
      <span class="label" aria-hidden="true"></span>
      <div>
        <p><span>I'm Nikita. I can't ship work I&nbsp;wouldn't sign.</span> <span>So I design alone, async, and only with founders who feel the same.</span> <span>For code I team up with a developer I've shipped with, and I'm taking more of it on myself, this site included.</span></p>
        <a class="link" href="/about/" data-gem data-count="site:about"><span class="arw">→</span> More about me</a>
      </div>
    </section>

    <section class="row cta">
      <span class="label" aria-hidden="true"></span>
      <div class="panel">
        <h2><span>Send me your product.</span> <span>Get a video review in&nbsp;return.</span></h2>
        <p>A link is enough: a landing page, Notion, Figma, anything that shows what you're working on. No call needed to&nbsp;start.</p>
        <a class="btn" href="/review/" data-gem data-count="site:end">Send a link, get a video review <span class="arw">→</span></a>
      </div>
    </section>
  </main>
</Site>

<script>
  import { count } from "../scripts/review-count";

  // A visit to the home page, counted once (Web Analytics misses many visits to blockers).
  count("site:view");
</script>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 36px;
    padding-top: 40px;
  }
  h1 {
    margin: 0;
    max-width: 17em;
    font-size: clamp(40px, 5.6vw, 80px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }
  /* Each sentence starts its own line, as the title on /review; on a phone they run on. */
  h1 span {
    display: block;
    text-wrap: pretty;
  }

  /* How I work: four moments. The first line of each is the moment, the rest is quieter. */
  .moments {
    display: grid;
    gap: 40px;
    max-width: 38em;
  }
  .moments p {
    margin: 0;
    line-height: 1.45;
  }
  .moments span {
    display: block;
    opacity: 0.6;
    text-wrap: pretty;
  }
  .moments span:first-child {
    font-weight: 500;
    opacity: 1;
  }

  /* Principles: one line at Lead size, the words quiet and the link full ink; on a narrow screen the link wraps whole. */
  .one {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.05em;
  }
  .one p {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }
  .one .link {
    white-space: nowrap;
  }

  /* The manifesto line and the about line read as one pair: closer to each other than the rows around them. */
  .principles + .about {
    margin-top: -64px;
  }
  .about p {
    margin: 0 0 24px;
    max-width: 30em;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.05em;
  }
  .about p span:not(:first-child) {
    opacity: 0.6;
  }

  /* The closing call: a raised panel, like the screen on /review, with the same dark button. */
  .panel {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 760px;
    padding: 40px;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--float);
  }
  .panel h2 {
    margin: 0;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  /* Each sentence starts its own line, as the title on /review; on a phone they run on. */
  .panel h2 span {
    display: block;
    text-wrap: balance;
  }
  .panel p {
    margin: 0 0 12px;
    max-width: 34em;
    opacity: 0.6;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .principles + .about {
      margin-top: -40px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 16px;
      gap: 28px;
    }
    h1 {
      font-size: clamp(30px, 9.4vw, 36px);
    }
    h1 span {
      display: inline;
      text-wrap: pretty;
    }
    .one {
      font-size: 22px;
    }
    .about p {
      font-size: 22px;
    }
    .panel h2 span {
      display: inline;
    }
    .panel {
      padding: 28px 22px 24px;
      margin-inline: -8px;
    }
  }
</style>
