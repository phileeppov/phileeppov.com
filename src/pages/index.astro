---
// Home: site.md §1, the MVP in the /review style (Site.astro: Onest, monochrome, depth in the controls), laid out as
// a wall (site.css): statements at Display, captions at body and meta, nothing between.
// Hero: §1.1, the line at Display under a label that says who. Under it the selected work (§1.3), then the tools, on a
// dark band. The form lives on /review: both buttons lead there instead of repeating it here. The arrows turn into
// emeralds under a moving pointer (data-gem, Site.astro).
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import Tools from "../components/Tools.astro";
import Stamp from "../components/Stamp.astro";
import { cases, shot } from "../data/cases";

// Selected work: each case as its card shot, name and description. A card's columns on a wide screen give its image
// sizes; a shot is never shown wider than its design size (half its pixels: the exports are @2x).
const SPANS = [3, 8, 7, 4];
const cards = cases.map((c, i) => {
  const src = shot(c.slug, c.card);
  const span = SPANS[i] ?? 6;
  const w = Math.round(src.width / 2);
  const px = Math.min(w, Math.round(((1392 - 11 * 24) / 12) * span + 24 * (span - 1)));
  const top = Math.min(src.width, px * 2);
  const widths = [...new Set([480, 800, 1200, 1600].filter((x) => x < top).concat(top))];
  const sizes = `(max-width: 767px) calc(100vw - 48px), (max-width: 1440px) ${Math.round((span / 12) * 100)}vw, ${px}px`;
  return { c, src, widths, sizes, w };
});
---

<Site passage description="Nikita Filippov, product designer. I redesigned game recording in Medal.tv, an app with 3M daily users." image="/home-og.png">
  <main class="wall home">
    <!-- The hero is the first screen: the label says who, the line at Display, one meaning part to a line, and the
         button under it in the caption half. -->
    <section class="hero grid">
      <h1 class="label">NIKITA FILIPPOV, PRODUCT DESIGNER</h1>
      <p class="statement"><span>“Good design</span> <span>is invisible.”</span> <span>Bullshit.</span> <span>It stands out.</span></p>
      <div class="cap">
        <a class="btn" href="/review/" data-gem data-count="site:hero">Send a link, get a video review <span class="arw">→</span></a>
      </div>
    </section>

    <!-- Selected work: four cards, large next to small, not an equal grid; on a phone, a list. The whole card is the
         link; the emerald comes out after the name. -->
    <section class="part work grid" id="work" aria-labelledby="work-label">
      <h2 class="label" id="work-label">SELECTED WORK</h2>
      {
        cards.map(({ c, src, widths, sizes, w }, i) => (
          <a class={`card k${i + 1}`} href={`/work/${c.slug}/`} style={`--w: ${w}px`}>
            <Image src={src} alt="" widths={widths} sizes={sizes} loading="lazy" />
            <h3 class="name"><span class="lbl">{c.name}</span></h3>
            <p class="line">{c.description}</p>
          </a>
        ))
      }
    </section>

    <Tools />

    <!-- How I work: the moments in the caption half, the first sentence of each in full ink and weight, the rest
         quieter; the offer between them at Display. -->
    <section class="part how grid" aria-labelledby="how-label">
      <h2 class="label" id="how-label">HOW I WORK</h2>
      <div class="cap moments">
        <p><span>You send me your product.</span> <span>A landing page, an onboarding flow, a product that doesn't exist yet.</span> <span>Whatever you're stuck on.</span></p>
      </div>
      <!-- The offer itself is the part's statement, between the moment that asks and the ones that answer. -->
      <p class="statement offer"><span class="ph"><span>I send back</span> <span>a free video review</span> <span>within 48&nbsp;hours.</span></span></p>
      <div class="cap moments rest">
        <p><span>What I see, what I'd do, what it would cost.</span> <span>If we're not aligned, we stop there. You keep the review.</span></p>
        <p><span>If we are, we work async.</span> <span>Video updates, shared Figma, decisions in writing.</span> <span>Calls when useful.</span></p>
        <p><span>A pharmacy website went from my spec to launch in six weeks.</span> <span>Longer partnerships run on a monthly retainer, after the first project.</span></p>
      </div>
    </section>

    <!-- About: its first sentences are the statement, the rest a caption with the two ways further under it (the
         manifesto preview folded to one line, site.md §1.2). The stamp signs the statement: its rim crosses "sign". -->
    <section class="part about grid">
      <Stamp seed={0} prefer={0} />
      <p class="statement" data-stamp-host><span>I'm Nikita.</span> <span>I can't ship work</span> <span>I&nbsp;wouldn't <span data-stamp-at>sign.</span></span></p>
      <div class="cap">
        <p>So I design alone, async, and only with founders who feel the same. For code I team up with a developer I've shipped with, and I'm taking more of it on myself, this site included.</p>
        <div class="further">
          <a class="link" href="/about/" data-gem data-count="site:about"><span class="arw">→</span> More about me</a>
          <div class="one">
            <p>Five principles I work by:</p>
            <a class="link" href="/manifesto/" data-gem data-count="site:manifesto"><span class="arw">→</span> Read full manifesto</a>
          </div>
        </div>
      </div>
    </section>

    <!-- The closing call: the last statement, its paragraph and the button as the caption. -->
    <section class="part cta grid">
      <h2 class="statement"><span>Send me your&nbsp;product.</span> <span class="ph"><span>Get a video review</span> <span>in&nbsp;return.</span></span></h2>
      <div class="cap">
        <p>A link is enough: a landing page, Notion, Figma, anything that shows what you're working on. No call needed to&nbsp;start.</p>
        <a class="btn" href="/review/" data-gem data-count="site:end">Send a link, get a video review <span class="arw">→</span></a>
      </div>
    </section>
  </main>
</Site>

<script>
  import { count } from "../scripts/review-count";

  // A visit to the home page, counted once (Web Analytics misses many visits to blockers).
  count("site:view");
</script>

<style>
  /* The hero: the line, and the button under it as its caption. */
  .hero {
    padding-bottom: 120px;
  }
  .hero .label {
    grid-column: 1 / -1;
  }
  .hero .statement {
    grid-column: 1 / -1;
    margin-top: 24px;
    /* The line and its button share the first screen: on a short screen the Display steps down to fit both. */
    font-size: max(min(var(--text-display), calc((100svh - 330px) / 4)), min(var(--text-display), 64px));
  }
  .hero .cap {
    margin-top: 48px;
  }

  /* Parts: the statement 72px under the hairline (or under the label), the caption 48px under the statement, and a
     long rest after, so the next statement starts on the next screen. */
  .part {
    row-gap: 0;
    padding-bottom: 200px;
  }
  .part > .statement {
    grid-column: 1 / -1;
    margin-top: 72px;
  }
  .part > .cap {
    margin-top: 48px;
  }

  /* Selected work: on a wide screen two rows, a large card next to a small one in each, the pair flipped in the second
     (Medal small and SPORTS CLUB large, then Ailekmed large and Mavatars small, low against it). On a phone, a list.
     Cards are prints on the wall, not panels: the shot with its 0.5px edge, the name in weight, the description
     quieter under it. */
  .work {
    row-gap: 96px;
  }
  .work .label {
    grid-column: 1 / -1;
    margin-bottom: -48px;
  }
  .card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }
  .card :global(img) {
    display: block;
    width: 100%;
    max-width: var(--w);
    height: auto;
    margin-bottom: 18px;
    border-radius: 4px;
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-black) 16%, transparent);
  }
  .card .name {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
    line-height: 1.45;
    transition: opacity 120ms ease-out;
  }
  .card .line {
    max-width: var(--cap);
    margin: 0;
    line-height: 1.45;
    opacity: 0.6;
    text-wrap: pretty;
  }
  .card:hover .name {
    opacity: 0.7;
  }
  .card:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 4px;
  }
  .k1 {
    grid-column: 1 / span 3;
    grid-row: 2;
  }
  .k2 {
    grid-column: 5 / span 8;
    grid-row: 2;
  }
  .k3 {
    grid-column: 1 / span 7;
    grid-row: 3;
  }
  .k4 {
    grid-column: 9 / span 4;
    grid-row: 3;
    align-self: end;
  }

  /* How I work: the label on the left at the hairline, the moments in the caption half, level with it. */
  .how .label {
    grid-column: 1 / span 4;
    grid-row: 1;
  }
  .how .moments {
    grid-row: 1;
    margin-top: 0;
    display: grid;
    gap: 40px;
  }
  .how .moments.rest {
    grid-row: auto;
    margin-top: 48px;
  }
  .moments p {
    display: grid;
  }
  .moments span {
    opacity: 0.6;
    text-wrap: balance;
  }
  .moments span:first-child {
    font-weight: 500;
    opacity: 1;
  }

  /* About: the caption, then the two ways further. */
  .about .cap {
    display: grid;
    justify-items: start;
    gap: 28px;
  }
  .further {
    display: grid;
    justify-items: start;
    gap: 6px;
  }
  .one {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
  }
  .one p {
    opacity: 0.6;
  }
  .one .link {
    white-space: nowrap;
  }

  /* The closing call: the paragraph quiet, the button under it. */
  .cta .cap {
    display: grid;
    justify-items: start;
    gap: 32px;
  }
  .cta .cap p {
    opacity: 0.6;
  }
  .cta {
    padding-bottom: 96px;
  }

  @media (max-width: 1199px) {
    .k1 {
      grid-column: 1 / span 4;
    }
    .k2 {
      grid-column: 6 / span 7;
    }
    .k3 {
      grid-column: 1 / span 7;
    }
    .k4 {
      grid-column: 8 / span 5;
    }
  }
  @media (max-width: 767px) {
    .work {
      row-gap: 64px;
    }
    .work .label {
      margin-bottom: -24px;
    }
    .k1,
    .k2,
    .k3,
    .k4 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .how .moments {
      grid-row: 2;
      margin-top: 40px;
    }
    .how .moments.rest {
      grid-row: auto;
    }
    .how .label {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-bottom: 72px;
    }
    /* Four short lines: on a phone the line takes the measure's full width. */
    .hero .statement {
      font-size: 12vw;
    }
    .hero .cap {
      margin-top: 32px;
    }
    .part {
      padding-bottom: 120px;
    }
    .part > .statement {
      margin-top: 48px;
    }
    .part > .cap {
      margin-top: 32px;
    }
    .how .moments {
      gap: 32px;
    }
    .cta {
      padding-bottom: 64px;
    }
  }
</style>
