---
// Home: site.md §1, the MVP in the /review style (Site.astro: Onest, monochrome, depth in the controls).
// Hero: the "who" line from §8.1 in place of the temporary §1.1 hero. Cases are left out while they're being redone;
// in their place, the tools. The form lives on /review: both buttons lead there instead of repeating it here.
// The arrows turn into emeralds under a moving pointer (data-gem, Site.astro).
import Site from "../layouts/Site.astro";
import Tools from "../components/Tools.astro";
import Stamp from "../components/Stamp.astro";
---

<Site description="Nikita Filippov, product designer. I redesigned game recording in Medal.tv, an app with 3M daily users." image="/home-og.png">
  <!-- data-layout: "grid" (How I work in two columns from 1200px, the rest on the left edge), "grid-about" (the same,
       the about line in the second column), "grid-shift" (the about line and the closing call in the second column) or
       "column" (one column throughout). -->
  <main class="page flow home" data-layout="grid-about">
    <section class="hero">
      <h1 class="page-title"><span>Nikita Filippov, product designer.</span> <span>I&nbsp;redesigned game recording in&nbsp;Medal.tv, an&nbsp;app with 3M daily&nbsp;users.</span></h1>
      <a class="btn" href="/review/" data-gem data-count="site:hero">Send a link, get a video review <span class="arw">→</span></a>
    </section>

    <Tools />

    <!-- How I work: the first line of each moment at Lead, the rest quieter at body size. Read down the Lead lines
         alone and the page still tells the whole offer. -->
    <section class="part how" aria-labelledby="how-label">
      <h2 class="label caps" id="how-label">HOW I WORK</h2>
      <div class="moments">
        <p><span>You send me your product.</span> <span>A landing page, an onboarding flow, a product that doesn't exist yet.</span> <span>Whatever you're stuck on.</span></p>
        <p><span>I send back a free video review within 48&nbsp;hours.</span> <span>What I see, what I'd do, what it would cost.</span> <span>If we're not aligned, we stop there. You keep the review.</span></p>
        <p><span>If we are, we work async.</span> <span>Video updates, shared Figma, decisions in writing.</span> <span>Calls when useful.</span></p>
        <p><span>A pharmacy website went from my spec to launch in six weeks.</span> <span>Longer partnerships run on a monthly retainer, after the first project.</span></p>
      </div>
    </section>

    <!-- About and the manifesto as one part: the about line at Lead, then two ways further at body size (the manifesto
         preview folded to one line, site.md §1.2). -->
    <!-- The stamp signs the about line: its rim crosses "sign" (off until approved; ?stamp=on to review). -->
    <section class="part about" data-stamp-host>
      <Stamp seed={0} prefer={-60} />
      <p><span>I'm Nikita. I can't ship work I&nbsp;wouldn't <span data-stamp-at>sign</span>.</span> <span>So I design alone, async, and only with founders who feel the same.</span> <span>For code I team up with a developer I've shipped with, and I'm taking more of it on myself, this site included.</span></p>
      <div class="further">
        <a class="link hang" href="/about/" data-gem data-count="site:about"><span class="arw">→</span> More about me</a>
        <div class="one">
          <p>Five principles I work by:</p>
          <a class="link" href="/manifesto/" data-gem data-count="site:manifesto"><span class="arw">→</span> Read full manifesto</a>
        </div>
      </div>
    </section>

    <!-- The closing call, straight on the page: the button carries the depth, not a panel around it. -->
    <section class="part cta">
      <h2><span>Send me your product.</span> <span>Get a video review in&nbsp;return.</span></h2>
      <p>A link is enough: a landing page, Notion, Figma, anything that shows what you're working on. No call needed to&nbsp;start.</p>
      <a class="btn" href="/review/" data-gem data-count="site:end">Send a link, get a video review <span class="arw">→</span></a>
    </section>
  </main>
</Site>

<script>
  import { count } from "../scripts/review-count";

  // A visit to the home page, counted once (Web Analytics misses many visits to blockers).
  count("site:view");
</script>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 48px;
    padding-top: 40px;
  }
  h1 {
    max-width: 17em;
  }
  /* Each sentence starts its own line, as the title on /review. */
  h1 span {
    display: block;
    text-wrap: pretty;
  }

  /* How I work: four moments, 64px apart. The first line of each is the moment, at Lead; the rest is quieter, at body
     size, each sentence on its own line. */
  .moments {
    display: grid;
    gap: 64px;
    max-width: var(--column);
  }
  .moments p {
    display: grid;
    margin: 0;
    line-height: 1.45;
  }
  .moments span {
    opacity: 0.6;
    text-wrap: pretty;
  }
  .moments span:first-child {
    margin-bottom: 12px;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.05em;
    opacity: 1;
    text-wrap: balance;
  }

  /* About: the one Lead block below How I work, its first sentence in full ink. Under it two ways further at body
     size: more about me, and the manifesto line with its words quiet and the link in full ink. */
  .about {
    gap: 32px;
  }
  .about > p {
    margin: 0;
    max-width: var(--column);
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.05em;
    text-wrap: pretty;
  }
  .about > p span:not(:first-child) {
    opacity: 0.6;
  }
  .further {
    display: grid;
    justify-items: start;
    gap: 6px;
  }
  .one {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
  }
  .one p {
    margin: 0;
    opacity: 0.6;
  }
  .one .link {
    white-space: nowrap;
  }

  /* The closing call, on the page itself: Lead, a quiet paragraph, the dark button; more air above it than above any
     other part. */
  .cta {
    gap: 16px;
    margin-top: calc(var(--part) * 0.2);
  }
  .cta h2 {
    margin: 0;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  /* Each sentence starts its own line, as the title on /review. */
  .cta h2 span {
    display: block;
    text-wrap: balance;
  }
  .cta p {
    margin: 0;
    max-width: var(--measure-body);
    opacity: 0.6;
    text-wrap: pretty;
  }
  .cta .btn {
    margin-top: 20px;
  }

  /* From 1200px How I work takes the width the tools take: the four moments in two columns on the tools' split, so
     the second column starts where the Glass tile does. Body lines stay short, about 60 characters. */
  @media (min-width: 1200px) {
    .home[data-layout^="grid"] .moments {
      justify-self: stretch;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 72px 24px;
      max-width: none;
    }
    /* A moment keeps its own height in a row: the rest sits under its first line, not spread down the row. */
    .home[data-layout^="grid"] .moments p {
      align-content: start;
    }
    .home[data-layout^="grid"] .moments span:not(:first-child) {
      max-width: 24em;
      text-wrap: balance;
    }
    /* The about line (and in grid-shift the closing call too) in the second column. There the arrow of "More about me"
       has a real margin to hang in, so the words keep the text edge. */
    .home[data-layout="grid-shift"] .about,
    .home[data-layout="grid-shift"] .cta,
    .home[data-layout="grid-about"] .about {
      padding-left: calc((100% - 24px) * 7 / 12 + 24px);
    }
    .home[data-layout="grid-shift"] .hang,
    .home[data-layout="grid-about"] .hang {
      margin-left: -1.15em;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 16px;
      gap: 28px;
    }
    /* Each sentence still starts its own line, balanced: the same six lines from 360 to 430px, no hole after
       "game recording" (the space in "in Medal.tv" stays non-breaking). */
    h1 span {
      text-wrap: balance;
    }
    .moments {
      gap: 44px;
    }
    .moments span:first-child {
      margin-bottom: 8px;
      font-size: 24px;
    }
    .about {
      gap: 24px;
    }
    .about > p,
    .cta h2 {
      font-size: 24px;
    }
    .cta .btn {
      margin-top: 12px;
    }
  }
</style>
