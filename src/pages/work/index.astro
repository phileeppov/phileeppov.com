---
// Facts, work first: a catalogue. The ruler answers "how long, and where" before anything is read; then each case is a
// row: the shot on the left at its own proportions, its fields on the caption axis next to it, so the picture and the
// facts are read together. A case shows dates only when they are its own.
import { Image } from "astro:assets";
import Site from "../../layouts/Site.astro";
import FactsWho from "../../components/FactsWho.astro";
import CareerRuler from "../../components/CareerRuler.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import { person, places, projects, skills, education, languages } from "../../data/facts";
import { cases, shot, tie } from "../../data/cases";

const withPlace = places.flatMap((p) => p.work.map((w) => ({ ...w, place: p })));
// A second tile beside a case's card, from the same case: Medal's card is narrow, and its red twin, the recorder off,
// is the case's call (recording is green) made visible.
const beside: Record<string, string> = { medal: "IMG-00b" };
const widthsOf = (src: ImageMetadata) => {
  const top = Math.min(src.width, 1368);
  return [...new Set([480, 800, 1200].filter((x) => x < top).concat(top))];
};
const seen = new Set<string>();
const sheet = withPlace.filter((w) => w.slug).map((w) => {
  const c = cases.find((x) => x.slug === w.slug)!;
  const src = shot(c.slug, c.card);
  const twin = beside[c.slug] ? shot(c.slug, beside[c.slug]) : undefined;
  const first = !seen.has(w.place.id);
  seen.add(w.place.id);
  const design = Math.round(src.width / 2) + (twin ? Math.round(twin.width / 2) + 20 : 0);
  return { ...w, title: c.name, src, twin, widths: widthsOf(src), design, anchor: first ? w.place.id : undefined };
});
const others = withPlace.filter((w) => !w.slug);
// A place with no case of its own: the ruler's capsule lands on its first row in Also.
const anchorOf = (w: (typeof withPlace)[number]) => (!seen.has(w.place.id) && w.place.work.find((x) => !x.slug)?.name === w.name ? w.place.id : undefined);
// The case named after the place takes the place's dates; other cases only name the place, its dates aren't theirs.
// The only work of a place takes the place's dates too: they are its own.
// A line break never leaves the separator at a line's end: it goes down with what follows it.
const keepDots = (s: string) => s.replace(/ · /g, " · ");
const whereRaw = (w: (typeof withPlace)[number]) => {
  if (w.meta) return w.meta;
  if (w.term) return `${w.term} · ${w.place.id === "independent" ? "Independent" : w.place.name}`;
  if (w.slug === "medal") return `${w.place.term} · ${w.place.meta}`;
  if (w.place.work.length === 1) return `${w.place.term} · ${w.place.name}`;
  return `${w.place.name} · ${w.place.meta}`;
};
// A line of three items or more, in two halves as even as can be: on a phone each half takes a line, so no line starts
// with a dot and an item or two (the format line under the name does the same, FactsWho.astro).
const where = (w: (typeof withPlace)[number]) => {
  const xs = whereRaw(w).split(" · ");
  if (xs.length < 3) return [keepDots(xs.join(" · "))];
  const join = (a: string[]) => a.join(" · ");
  let best = 1;
  const worst = (k: number) => Math.max(join(xs.slice(0, k)).length, join(xs.slice(k)).length);
  for (let k = 2; k < xs.length; k++) if (worst(k) < worst(best)) best = k;
  return [keepDots(join(xs.slice(0, best))), keepDots(join(xs.slice(best)))];
};
---

<Site passage view="facts" title={`${person.name}, ${person.role}`} description={person.summary} image="/work-og.png">
  <!-- Stones only where the arrow is, on the cases' titles; a case's picture lights its title's (emerald.js). -->
  <main class="wall facts" data-gem-off>
    <FactsWho />

    <div class="career" id="work">
      <CareerRuler lines />
      <div class="rowsN">
        {
          places.map((p) => (
            <p class="placeN"><span class="name">{p.name}</span> <span class="quiet term">{p.term}</span>{p.id === "premium" && p.note && <span class="quiet note2">{p.note}</span>}</p>
          ))
        }
      </div>
    </div>

    {
      sheet.map((w, n) => (
        <article class="part case grid" id={w.anchor}>
          <div class="print" style={`--d: ${w.design}px`}>
            <a class:list={["shot", w.twin && "pair"]} href={`/work/${w.slug}/`} data-count="work:case" data-gem-to={`case-${w.slug}`} tabindex="-1" aria-hidden="true">
              {
                w.twin ? (
                  <Fragment>
                    <Image src={w.src} alt="" widths={w.widths} sizes="(max-width: 767px) calc(50vw - 30px), 296px" loading="lazy" />
                    <Image src={w.twin} alt="" widths={widthsOf(w.twin)} sizes="(max-width: 767px) calc(50vw - 30px), 296px" loading="lazy" />
                  </Fragment>
                ) : (
                  <Image src={w.src} alt="" widths={w.widths} sizes="(max-width: 767px) calc(100vw - 48px), 684px" loading={n === 0 ? "eager" : "lazy"} />
                )
              }
            </a>
            {w.shotNote && <p class="note quiet">{w.shotNote}</p>}
          </div>
          <div class="fields">
            <h2><a class="link" id={`case-${w.slug}`} href={`/work/${w.slug}/`} data-gem data-count="work:case">{w.title} <span class="arw" aria-hidden="true">→</span></a></h2>
            <p class="quiet what">{w.what ?? w.place.note}</p>
            <p class="quiet term">{where(w).map((h, i) => <Fragment>{i > 0 && <span class="sep"> · </span>}<span class="half">{h}</span></Fragment>)}</p>
            {w.did?.map((d) => <p class="gap quiet">{d}</p>)}
            {w.result && <p class="gap">{w.result}</p>}
          </div>
        </article>
      ))
    }

    <section class="part tail grid">
      <div class="side">
        <h2>Also</h2>
      </div>
      <div class="rows">
        {
          projects.map((x) => (
            <div class="other">
              <h3><a class="link" href={x.href}>{x.name}</a></h3>
              <p class="quiet what">{x.what}</p>
              <p class="quiet">{x.did}</p>
              <p class="quiet term">Personal project</p>
            </div>
          ))
        }
        {
          others.map((w) => (
            <div class="other" id={anchorOf(w)}>
              <h3>{w.name}</h3>
              {w.what && <p class="quiet what">{w.what}</p>}
              {w.did?.map((d) => <p class="quiet">{d}</p>)}
              {w.result && <p>{w.result}</p>}
              <p class="quiet term">{where(w).map((h, i) => <Fragment>{i > 0 && <span class="sep"> · </span>}<span class="half">{h}</span></Fragment>)}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="part tail end grid">
      <div class="side">
        <h2>Skills</h2>
      </div>
      <div class="rows tight">
        {skills.map((s) => (
          <p class="tr"><span class="quiet">{s.label}</span> <span>{s.text}</span></p>
        ))}
        <p class="tr"><span class="quiet">Education</span> <span>{education.school}. {education.degree}</span></p>
        <p class="tr"><span class="quiet">Languages</span> <span>{languages}</span></p>
      </div>
    </section>

    <!-- The end of the page: how to reach me, and one line for someone with a product, with no free work offered. -->
    <section class="part close grid" id="contact">
      <span id="site-end" hidden></span>
      <div class="side">
        <h2>Contact</h2>
        <p class="gap"><CopyEmail /></p>
        <p><a class="link" href={person.linkedin} data-count="work:linkedin">LinkedIn</a></p>
        <p><a class="link" href="https://github.com/phileeppov" data-count="work:github">GitHub</a></p>
        <p><a class="link" href={person.cv} download data-count="work:cv">Download CV</a></p>
      </div>
      <div class="fin">
        <h2>Have a product?</h2>
        <p class="gap quiet">{tie("Email me a link and what's stuck. I'll reply with a few questions and a way to work together.")}</p>
      </div>
    </section>
  </main>
</Site>

<script>
  import { count } from "../../scripts/review-count";

  // The short version opened (worker/index.js keeps the list of names).
  count("work:view");
</script>

<style>
  .facts {
    line-height: 1.45;
  }
  p,
  h2,
  h3 {
    margin: 0;
    font: inherit;
  }
  /* 0.7 keeps the quiet text above 4.5:1 on the paper: the rows' "what I did" is set in it. */
  .quiet {
    opacity: 0.7;
  }
  .fields p,
  .fields h2,
  .rows p,
  .other h3,
  .fin p {
    text-wrap: pretty;
  }
  .term {
    font-variant-numeric: tabular-nums;
  }
  /* A short "what it is" line keeps its lines even, with no word or two left alone on the last. */
  .fields .what,
  .other .what {
    text-wrap: balance;
  }
  /* Lines: one over the text column only, from each title down, like a rule in a ledger; the pictures stand free. Quieter
     than the site's hairline. The header stands further from the name, so the first lines get air. */
  .facts {
    --rule: color-mix(in srgb, var(--hair) 55%, transparent);
  }
  :global(body:has(> main.facts) > .top2) {
    margin-bottom: 64px;
  }
  .part {
    padding-top: 0;
    border-top: 0;
  }
  .part > :is(.fields, .rows, .fin) {
    padding-top: 14px;
    border-top: 0.5px solid var(--rule);
  }
  .part > :is(.print, .side) {
    padding-top: 15px;
  }
  /* The ruler and its lines stand between the who and the first case. "Back to all work" from a case lands here, below
     the pinned switch rather than under it. */
  .career {
    padding-bottom: 88px;
    padding-inline: max(0px, (100% - 1392px) / 2);
    scroll-margin-top: 56px;
  }
  .rowsN {
    display: none;
  }
  .case {
    padding-bottom: 88px;
    align-items: start;
    scroll-margin-top: 16px;
  }
  /* A print at its own proportions, never wider than its design size or taller than most of a screen. */
  .print {
    grid-column: 1 / span 6;
  }
  .shot {
    display: block;
    max-width: min(100%, var(--d));
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-black) 16%, transparent);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
    object-position: left top;
  }
  /* Two tiles side by side, each with its own edge. */
  .shot.pair {
    display: flex;
    gap: 20px;
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
  }
  .shot.pair :global(img) {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 4px;
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-black) 16%, transparent);
  }
  /* What was changed in the screens for the case, under the print and no wider than it. */
  .note {
    max-width: min(100%, var(--d), 40ch);
    margin-top: 8px;
    font-size: var(--text-meta);
    text-wrap: balance;
  }
  .fields {
    grid-column: 7 / span 6;
    max-width: var(--cap);
  }
  .fields h2,
  .other h3,
  .side h2,
  .placeN .name {
    font-weight: 500;
  }
  .gap {
    margin-top: 10px;
  }
  .tail {
    padding-bottom: 80px;
    scroll-margin-top: 16px;
  }
  .tail.end {
    padding-bottom: 96px;
  }
  .side {
    grid-column: 1 / span 6;
  }
  .rows {
    grid-column: 7 / span 6;
    display: grid;
    gap: 18px;
    max-width: 34em;
  }
  /* Also reads as the rows above; only the Skills table needs the wider measure. */
  .rows:not(.tight) {
    max-width: var(--cap);
  }
  .rows.tight {
    gap: 6px;
  }
  /* Its rule as long as the others: the table is wider than a caption, the line isn't. */
  .part > .rows.tight {
    position: relative;
    border-top: 0;
  }
  .part > .rows.tight::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: min(100%, var(--cap));
    border-top: 0.5px solid var(--rule);
  }
  .other {
    scroll-margin-top: 56px;
  }
  .placeN .note2 {
    display: block;
  }
  .tr {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
  }
  .close {
    padding-bottom: 8px;
    scroll-margin-top: 16px;
  }
  .close .side p {
    margin-top: 2px;
  }
  .fin {
    grid-column: 7 / span 6;
    max-width: var(--cap);
  }
  .close h2 {
    font-weight: 500;
  }
  /* Without the ruler the places are lines, in the caption column on a mid window, on their own on a phone. */
  @media (max-width: 1199px) {
    .career {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      margin-top: 0;
    }
    .rowsN {
      grid-column: 6 / -1;
      display: grid;
      gap: 8px;
    }
    .placeN span {
      display: block;
    }
    .print,
    .side {
      grid-column: 1 / span 5;
    }
    .fields,
    .rows,
    .fin {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 767px) {
    :global(body:has(> main.facts) > .top2) {
      margin-bottom: 40px;
    }
    .career {
      padding-bottom: 56px;
    }
    /* On a phone the text sits under its picture: the line goes over the whole row, in the column's width. */
    .part {
      margin-inline: 0;
      padding-inline: 0;
      padding-top: 14px;
      border-top: 0.5px solid var(--rule);
    }
    .part > :is(.fields, .rows, .fin) {
      padding-top: 0;
      border-top: 0;
    }
    .part > :is(.print, .side) {
      padding-top: 0;
    }
    .shot.pair {
      gap: 12px;
    }
    .term .half {
      display: block;
    }
    .term .sep {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .tail,
    .tail.end {
      padding-bottom: 64px;
    }
    .part > .rows.tight::before {
      content: none;
    }
    .rowsN,
    .print,
    .fields,
    .side,
    .rows,
    .fin {
      grid-column: 1 / -1;
    }
    .fin {
      margin-top: 28px;
    }
    .fields {
      margin-top: 16px;
    }
    .rows {
      margin-top: 16px;
    }
    .tr {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 8px;
    }
    .case {
      padding-bottom: 64px;
    }
  }
</style>
