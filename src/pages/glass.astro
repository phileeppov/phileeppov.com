---
// Tool: logo → glass icon. Copy: site.md §7.
// Exception: elsewhere heavy effects load as desktop-only islands; here the effect is the page itself, so WebGL runs on phones too.
// The page font is Onest; the rest of the site uses its own stack from tokens.css.
// Custom header and footer: the wordmark in version mode (phil 01 ppov is mini-project #01).
import Base from "../layouts/Base.astro";
import "../styles/onest.css";
---

<Base title="Glass" description="Drop a logo, get it back as a glass app icon. Runs in your browser." image="/glass-og.png" bare>
  <Fragment slot="head">
    <link rel="icon" type="image/png" sizes="64x64" href="/glass-favicon.png" />
    <link rel="apple-touch-icon" href="/glass-touch-icon.png" />
  </Fragment>

  <!-- Author links: wordmark → portfolio, handle → X profile, the pill → the video review form. Every link off this page
       opens in a new tab, so the uploaded logo and settings aren't lost. -->
  <header class="top">
    <a class="mark" href="/" target="_blank" rel="noopener" aria-label="phil01ppov, portfolio" title="Portfolio" data-link="wordmark">phil<i>01</i>ppov</a>
    <nav>
      <a href="https://x.com/phileeppov" target="_blank" rel="noopener" data-link="x-handle">@phileeppov</a>
      <a class="work" href="/review/" target="_blank" rel="noopener" data-link="review-pill">Work with me</a>
    </nav>
  </header>

  <main class="glass" data-glass data-sides="two" data-volume="on">
    <div class="intro">
      <h1>Glass</h1>
      <p>Drop a logo, get it back in glass.</p>
      <p class="whatsnew" data-whatsnew hidden></p>
    </div>

    <div class="stage-wrap">
      <div class="stage-sticky">
        <div class="stage" data-stage>
          <canvas aria-label="Glass icon preview"></canvas>
          <button type="button" class="soft tilt" data-tilt hidden>Tilt the glass</button>
          <!-- In full screen, the way back: the screen's corner, there while the mouse moves. -->
          <button type="button" class="full exit" data-full-exit aria-label="Exit full screen" title="Exit full screen"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M8 4v4H4M12 4v4h4M8 16v-4H4M12 16v-4h4" /></svg></button>
          <p class="unsupported">WebGL isn't working in this browser, so the glass can't render.</p>
        </div>
        <!-- Under the glass: the presets, each key your own logo in that look, and a sixth key for a look of its own.
             The most used control sits next to what it changes. -->
        <div class="looks">
          <fieldset class="presets">
            <legend class="sr">Presets</legend>
            <div class="seg">
              <label><input type="radio" name="preset" value="studio" checked /><span><canvas width="128" height="128" data-thumb="studio" aria-hidden="true"></canvas>Studio</span></label>
              <label><input type="radio" name="preset" value="melt" /><span><canvas width="128" height="128" data-thumb="melt" aria-hidden="true"></canvas>Melt</span></label>
              <label><input type="radio" name="preset" value="prism" /><span><canvas width="128" height="128" data-thumb="prism" aria-hidden="true"></canvas>Prism</span></label>
              <label><input type="radio" name="preset" value="lens" /><span><canvas width="128" height="128" data-thumb="lens" aria-hidden="true"></canvas>Lens</span></label>
              <label><input type="radio" name="preset" value="night" /><span><canvas width="128" height="128" data-thumb="night" aria-hidden="true"></canvas>Night</span></label>
              <!-- The sixth key rolls a look of its own and keeps it: try a preset, tap here to come back; tap again to roll again. -->
              <button type="button" class="slot" data-roll aria-pressed="false"><span><i class="well"><canvas width="128" height="128" data-roll-thumb aria-hidden="true"></canvas><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="2.5" y="2.5" width="15" height="15" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="7" cy="7" r="1.4" fill="currentColor" /><circle cx="13" cy="13" r="1.4" fill="currentColor" /><circle cx="13" cy="7" r="1.4" fill="currentColor" /><circle cx="7" cy="13" r="1.4" fill="currentColor" /><circle cx="10" cy="10" r="1.4" fill="currentColor" /></svg></i>Random</span></button>
            </div>
          </fieldset>
        </div>
      </div>
    </div>

    <form class="controls" autocomplete="off" onsubmit="return false">
      <!-- The logo comes in one row: Upload is the wide key, the text field waits next to it folded into an Aa key.
           A tap on Aa opens the field and folds Upload to its arrow; an empty field folds back. -->
      <div class="logo-in" data-logo-in>
        <label class="upload">
          <span><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 14V4.5M5.8 8.6 10 4.4l4.2 4.2M4.5 15.5h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg><i>Upload logo</i></span>
          <input type="file" accept=".svg,image/svg+xml,image/png,image/jpeg,image/webp" />
        </label>
        <div class="type">
          <input type="text" name="text" maxlength="12" placeholder="Aa" data-open-placeholder="Type a word or emoji" enterkeyhint="done" spellcheck="false" aria-label="Type a word or emoji" data-text />
          <div class="samples" role="group" aria-label="Try one">
            <button type="button" data-sample="">☺</button>
            <button type="button" data-sample="A">A</button>
            <button type="button" data-sample="★">★</button>
          </div>
        </div>
      </div>
      <p class="hint drop-hint">Drop an SVG or PNG anywhere, or paste one.</p>

      <h2 class="group rule"><span class="sr">Look</span></h2>

      <label class="range"><input type="range" name="refraction" min="0" max="1.5" step="any" value="1.5" /><span class="thumb"><span class="name">Refraction</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
      <label class="range"><input type="range" name="liquid" min="0" max="1" step="any" value="0.75" /><span class="thumb"><span class="name">Blend</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
      <label class="range"><input type="range" name="size" min="0.3" max="1.2" step="any" value="0.66" /><span class="thumb"><span class="name">Logo size</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
      <fieldset>
        <legend>Background</legend>
        <div class="seg">
          <label><input type="radio" name="background" value="light" checked /><span>Light</span></label>
          <label><input type="radio" name="background" value="dark" /><span>Dark</span></label>
          <label><input type="radio" name="background" value="none" /><span>None</span></label>
        </div>
      </fieldset>

      <!-- The Sound row: the name, the live bars while sound plays (added from code), and the full-screen key, kept out of
           the heading so the heading reads as just "Sound". -->
      <div class="group" data-sound-head>
        <h2>Sound</h2>
        <!-- Full screen: only the glass, for a screen recording, a stream or a screen by the speakers. -->
        <button type="button" class="full" data-full aria-label="Full screen" title="Full screen"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 8V4h4M16 8V4h-4M4 12v4h4M16 12v4h-4" /></svg></button>
      </div>
      <fieldset>
        <legend class="sr">Sound</legend>
        <div class="seg">
          <label><input type="radio" name="sound" value="off" checked /><span>Off</span></label>
          <label><input type="radio" name="sound" value="demo" /><span>Lofi</span></label>
          <label><input type="radio" name="sound" value="mic" /><span>Mic</span></label>
          <label><input type="radio" name="sound" value="track" /><span>Track</span></label>
        </div>
      </fieldset>
      <!-- With a track: the part a video takes, 12 s, over the song's loudness. It starts on the strongest part. -->
      <label class="range clip" data-clip hidden><input type="range" name="clip" min="0" max="1" step="any" value="0" aria-label="Part of the track to record" /><canvas aria-hidden="true"></canvas><span class="thumb"><span class="name" data-clip-time></span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
      <input type="file" class="track-input" accept="audio/*,.mp3,.m4a,.aac,.wav,.ogg,.flac" data-track tabindex="-1" aria-label="Pick a track" />

      <details class="advanced" data-advanced>
        <summary>Advanced</summary>
        <div class="adv-body">
          <label class="range"><input type="range" name="dispersion" min="0" max="1" step="any" value="0.95" /><span class="thumb"><span class="name">Dispersion</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <label class="range"><input type="range" name="edge" min="0.06" max="0.35" step="any" value="0.18" /><span class="thumb"><span class="name">Edge width</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <label class="check"><input type="checkbox" name="facets" /><span>Facets</span></label>
          <fieldset>
            <legend>Edges</legend>
            <div class="seg">
              <label><input type="radio" name="sides" value="all" /><span>All</span></label>
              <label><input type="radio" name="sides" value="two" checked /><span>Two</span></label>
              <label><input type="radio" name="sides" value="one" /><span>One</span></label>
            </div>
          </fieldset>
          <label class="range directional"><input type="range" name="angle" min="0" max="360" step="any" value="45" /><span class="thumb"><span class="name">Angle</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <label class="range directional"><input type="range" name="spread" min="0" max="1" step="any" value="0.6" /><span class="thumb"><span class="name">Length</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <label class="check directional"><input type="checkbox" name="spin" /><span>Spin</span></label>
          <label class="range"><input type="range" name="motion" min="0" max="1" step="any" value="0.5" /><span class="thumb"><span class="name">Motion</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <label class="check"><input type="checkbox" name="volume" checked /><span>Depth</span></label>
          <label class="range thick"><input type="range" name="thickness" min="0.05" max="1" step="any" value="0.35" /><span class="thumb"><span class="name">Thickness</span><span class="val" aria-hidden="true"></span></span><i class="detent" aria-hidden="true"></i></label>
          <fieldset>
            <legend>Shape</legend>
            <div class="seg">
              <label><input type="radio" name="shape" value="squircle" checked /><span>Squircle</span></label>
              <label><input type="radio" name="shape" value="circle" /><span>Circle</span></label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Logo color</legend>
            <div class="seg">
              <label><input type="radio" name="color" value="original" checked /><span>Original</span></label>
              <label><input type="radio" name="color" value="black" /><span>Black</span></label>
              <label><input type="radio" name="color" value="white" /><span>White</span></label>
            </div>
          </fieldset>
        </div>
      </details>

      <!-- On a phone this block docks at the bottom of the screen, under the thumb: download is on the first screen.
           Each key says what it makes in small print, and the arrow at its end opens the formats. -->
      <div class="dock">
        <div class="actions">
          <div class="key dark">
            <button type="button" data-png>Download PNG<small data-png-spec>1024 px</small></button>
            <button type="button" class="opt" popovertarget="png-formats" aria-label="PNG format"><svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.8 5 6.8l3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          </div>
          <div class="key">
            <button type="button" data-video><span data-video-name>Record video</span><small data-video-spec><span class="res">1080p · </span>4 s</small></button>
            <button type="button" class="opt" popovertarget="video-formats" aria-label="Video format"><svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.8 5 6.8l3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          </div>
        </div>
        <!-- The formats open over their key. Each row draws its framing; with a mouse, Avatar and App Store try it on the glass. -->
        <fieldset class="menu" id="png-formats" popover>
          <legend class="sr">Image</legend>
          <label><input type="radio" name="image" value="icon" checked /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="0.75" y="0.75" width="14.5" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-opacity="0.35" /><rect x="3.5" y="3.5" width="9" height="9" rx="2.6" fill="currentColor" /></svg>1024 px</span></label>
          <label><input type="radio" name="image" value="large" /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="0.75" y="0.75" width="14.5" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-opacity="0.35" /><rect x="3.5" y="3.5" width="9" height="9" rx="2.6" fill="currentColor" /></svg>2048 px</span></label>
          <label><input type="radio" name="image" value="avatar" /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="0.75" y="0.75" width="14.5" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-opacity="0.35" /><circle cx="8" cy="8" r="7.25" fill="currentColor" /></svg>Avatar</span></label>
          <label><input type="radio" name="image" value="store" /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="0.75" y="0.75" width="14.5" height="14.5" rx="2.5" fill="currentColor" /></svg>App Store</span></label>
        </fieldset>
        <fieldset class="menu" id="video-formats" popover>
          <legend class="sr">Video</legend>
          <label><input type="radio" name="format" value="square" checked /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="2.25" y="2.25" width="11.5" height="11.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Square</span></label>
          <label><input type="radio" name="format" value="wide" /><span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="0.75" y="4" width="14.5" height="8.2" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Wide 16:9</span></label>
        </fieldset>
        <button type="button" class="share" data-share hidden>Share it on X →</button>
        <!-- Right after a download, while the interest is there: another look, or a link to this one. -->
        <div class="look after" data-after hidden>
          <button type="button" class="soft" data-random>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><rect x="2.5" y="2.5" width="15" height="15" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="7" cy="7" r="1.4" fill="currentColor" /><circle cx="13" cy="13" r="1.4" fill="currentColor" /><circle cx="13" cy="7" r="1.4" fill="currentColor" /><circle cx="7" cy="13" r="1.4" fill="currentColor" /><circle cx="10" cy="10" r="1.4" fill="currentColor" /></svg>
            <span>Another look</span>
          </button>
          <button type="button" class="soft" data-copy-link aria-label="Copy link to this look">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M8.5 11.5a3.2 3.2 0 0 0 4.6 0l2.6-2.6a3.2 3.2 0 0 0-4.6-4.6l-.9.9M11.5 8.5a3.2 3.2 0 0 0-4.6 0l-2.6 2.6a3.2 3.2 0 0 0 4.6 4.6l.9-.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            <span>Copy link</span>
          </button>
        </div>
        <p class="status" data-status aria-live="polite"></p>
      </div>
      <!-- The source link under "never leaves your browser": the code is where that can be checked. The text in the span is
         rewritten by the tool when the sound changes; the link stays. -->
    <p class="hint caption"><span data-caption>Your logo never leaves your browser.</span><br /> <a href="https://github.com/phileeppov/glass" target="_blank" rel="noopener" data-link="source">Source on GitHub</a></p>
    </form>
    <footer class="bottom">
      <p class="made">Made by <a href="https://x.com/phileeppov" target="_blank" rel="noopener" data-link="x-name">Nikita Filippov</a> ☺</p>
      <p class="pitch">Product designer.<br /> <a href="/review/" target="_blank" rel="noopener" data-link="review-line">Send your product, get a video review →</a></p>
      <p>
        <a href="mailto:nikita@phileeppov.com" data-link="email">Email</a>{" · "}
        <a href="https://linkedin.com/in/phileeppov" target="_blank" rel="noopener" data-link="linkedin">LinkedIn</a>{" · "}
        <a href="https://github.com/phileeppov" target="_blank" rel="noopener" data-link="github">GitHub</a>
      </p>
    </footer>
  </main>

</Base>

<script>
  // The counter first: it is this site's own layer and counts author links even where WebGL fails and the tool doesn't start.
  // The tool's files are the same as in the open repository phileeppov/glass.
  import "../scripts/glass/count.js";
  import "../scripts/glass/app.js";
</script>

<style>
  /* All page text is Onest, tracking −4%. Page styles load only on /glass. */
  :global(html) {
    font-family: "Onest", var(--font-base);
    letter-spacing: -0.04em;
  }
  :global(body) {
    padding: 20px 24px;
  }
  /* The panel sits between the stage and the page edge with the same 32 px on both sides of it, which shows when the
     stage goes dark out to the edges. */
  @media (min-width: 761px) {
    :global(body) {
      padding-right: 32px;
    }
  }
  .top a,
  .bottom a {
    color: inherit;
    text-decoration: none;
  }

  /* Header: wordmark on the left, two links on the right. */
  /* The header sits over the page, not above it: the stage starts at the top of the screen, so the icon is centered from the first frame. */
  .top {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-meta);
  }
  .mark {
    font-size: 17px;
    font-weight: 500;
    transition: opacity 120ms ease-out, color 200ms ease-out;
  }
  /* On a computer the wordmark sits over the stage: over a dark one it turns light (the links on the right sit over
     the light panel). On a phone the header is above the stage, on the light page. */
  @media (min-width: 761px) {
    .top:has(~ .glass[data-tone="dark"]) .mark {
      color: var(--color-off-white);
    }
  }
  @media (min-width: 761px) {
    .top {
      right: 32px;
    }
  }
  /* In full screen only the glass stays: the header steps aside with the panel. */
  .top:has(~ .glass.is-full) {
    display: none;
  }
  /* The wordmark leads to the portfolio, so it responds to hover like a link. */
  .mark:hover {
    opacity: 0.6;
  }
  .mark i {
    font-family: var(--font-anomaly);
    letter-spacing: 0;
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  /* The review pill is small and white, like the buttons in the panel: the main path from the tool to working together. */
  .top nav .work {
    padding: 6px 14px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    font-weight: 500;
    opacity: 1;
  }
  .top nav .work:hover {
    filter: brightness(0.98);
  }
  .top nav a,
  .bottom a {
    opacity: 0.6;
    transition: opacity 120ms ease-out;
  }
  .top nav a:hover,
  .bottom a:hover {
    opacity: 1;
  }

  .glass {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    /* The stage spans two rows, next to the panel and the footer, so it keeps the icon centered on screen all the way down. */
    grid-template-areas:
      "stage intro"
      "stage controls"
      "stage foot";
    /* On a screen taller than the panel, the spare height goes under the footer, not between the title and the panel. */
    grid-template-rows: auto auto 1fr;
    gap: 24px 32px;
    align-items: start;
  }
  /* Title above the panel, in the right column; the top padding makes room for the header links.
     The title, the panel and the footer share one left edge. */
  .intro {
    grid-area: intro;
    padding: 56px 0 0;
  }
  h1 {
    font-size: 40px;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.065em;
    margin: 0 0 12px;
  }
  .intro p {
    margin: 0;
    font-size: var(--text-body);
  }

  /* The stage is pinned: while you adjust settings, the icon is always in view. */
  /* The stage is full viewport height and sticks to the top, so the icon always sits in the middle of the screen. */
  .stage-wrap {
    grid-area: stage;
    align-self: stretch;
    position: relative;
    isolation: isolate;
  }
  /* With a dark background the whole stage goes dark, out to the page edges (past the body's 20 / 24 px padding): the glass
     hangs in the dark instead of sitting on a black card. Trying a dark look on with the mouse previews it. The layer's
     opacity is --dark, which app.js eases in the same frames as the glass's own background, so the two never part.
     The panel stays light. */
  .stage-wrap::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -20px 0 -20px -24px;
    background: var(--color-black);
    opacity: var(--dark, 0);
    pointer-events: none;
  }
  [data-tone="dark"] .presets span {
    color: color-mix(in srgb, var(--color-off-white) 62%, transparent);
  }
  [data-tone="dark"] .presets input:checked + span,
  [data-tone="dark"] .presets .slot.is-on > span {
    color: var(--ink);
  }
  [data-tone="dark"] .slot:not(.is-filled) .well {
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.5), inset 0 0 0 0.5px rgb(255 255 255 / 0.08);
    color: color-mix(in srgb, var(--color-off-white) 80%, transparent);
  }
  [data-tone="dark"] .looks :focus-visible,
  [data-tone="dark"] .presets .slot:focus-visible,
  [data-tone="dark"] .presets input:focus-visible + span {
    outline-color: var(--color-off-white);
  }
  .stage-sticky {
    position: sticky;
    top: 20px;
    height: calc(100vh - 40px);
    height: calc(100svh - 40px);
    display: grid;
    place-items: center;
    align-content: center;
    row-gap: 14px;
    width: 100%;
  }
  /* The glass sizes to the screen, minus the row of presets under it, up to 760 px on a large one. */
  .stage {
    position: relative;
    width: min(100%, 760px, calc(100svh - 190px));
    aspect-ratio: 1;
  }
  /* The keys under the glass share one geometry: --pad of room around the glass on every side of a key, and corners
     that follow the glass: a key's radius is the glass's own plus --pad, so the two curves run side by side. */
  .looks {
    --pad: 8px;
    --key: 72px;
    --thumb: calc(var(--key) - 2 * var(--pad));
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .looks .presets {
    flex: none;
  }
  .caption {
    text-align: center;
    font-size: 12px;
  }
  /* A file is being dragged over the page: highlight the stage, it can be dropped anywhere. */
  .is-over .stage {
    border-radius: 24px;
    outline: 2px dashed var(--ink);
    outline-offset: -10px;
  }
  .stage canvas {
    display: block;
    cursor: pointer; /* the glass is played */
    touch-action: none; /* the glass is played: a finger held or drawn on it plays, it doesn't scroll the page */
    width: 100%;
    height: 100%;
    border-radius: 24px;
    /* The checkerboard shows only in no-background mode, to show the PNG is transparent. */
    background: repeating-conic-gradient(var(--color-off-white) 0 25%, color-mix(in srgb, var(--color-black) 6%, var(--color-off-white)) 0 50%) 0 0 / 24px 24px;
    /* The whole glass leans up to 6° toward the cursor or with the phone (app.js sets the lean, -1 to 1). */
    transform: perspective(1100px) rotateY(calc(var(--lean-x, 0) * 6deg)) rotateX(calc(var(--lean-y, 0) * 6deg));
    /* The canvas edge feathers into the page over its outer 4% (the margin, the glass is in the middle 80%): the glass's
       shadow reaches the edge a shade darker than the page, which would show as a square seam on a dark stage. */
    -webkit-mask: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent), linear-gradient(transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent), linear-gradient(transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }
  .unsupported {
    display: none;
  }
  .is-unsupported .unsupported {
    display: block;
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 24px;
  }

  /* The settings sit straight on the page, no card behind them: the glass is the only object with depth here.
     8 px between controls, 24 px and a hairline between parts. */
  .controls {
    grid-area: controls;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 0 20px;
    font-size: var(--text-meta);
  }
  .upload input,
  .track-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  /* Secondary actions (Tilt the glass, and the moves after a download): a white pill, quieter than the keys. */
  .soft {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 10px;
    white-space: nowrap;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: var(--ink);
  }
  .soft:hover {
    filter: brightness(0.98);
  }
  .soft:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .look {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  /* After a download: another look, or a link to this one, under Share. Text and an icon with no raised key:
     they're offers, the keys above stay the things to press. */
  .after {
    animation: share-in 320ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .after .soft {
    padding: 8px 10px;
    background: none;
    box-shadow: none;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .after .soft:hover {
    filter: none;
    background: var(--tray);
    color: var(--ink);
  }
  .after[hidden] {
    display: none;
  }
  /* What this release added: one line under the title on the first visit, after a small ink dot. Monochrome, no accent color. */
  .whatsnew[hidden] {
    display: none;
  }
  .intro .whatsnew {
    margin-top: 10px;
    font-size: var(--text-meta);
    opacity: 0.6;
    text-wrap: balance; /* two even lines, not a pair of words left on the second */
  }
  .whatsnew::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: 1px;
  }
  /* The die rolls a third of a turn on every tap. */
  .soft svg {
    flex: none;
    transform: rotate(var(--turn, 0deg));
    transition: transform 480ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .soft svg {
      transition: none;
    }
  }
  /* iPhone only: the one button that asks for motion access, on the stage itself, under the glass. */
  .tilt {
    position: absolute;
    left: 50%;
    bottom: 1%; /* in the margin under the icon, clear of the glass */
    width: auto;
    padding: 6px 12px;
    font-size: 12px;
    transform: translateX(-50%);
  }
  .tilt:active {
    transform: translateX(-50%) scale(0.985);
  }
  .tilt[hidden] {
    display: none;
  }
  /* Full screen: a small quiet key at the end of a heading row, out of the stage. In full screen its counterpart, the way
     back, sits in the screen's corner. */
  .full {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: 10px;
    padding: 0;
    border-radius: 9px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .full:hover {
    color: var(--ink);
  }
  .full svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .full:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    opacity: 1;
  }
  /* At the end of the Sound heading. A phone shows the glass large already, and there the heading sits under the stage,
     so the key is for larger screens. */
  .group .full {
    order: 2;
    margin-left: auto;
  }
  @media (max-width: 760px) {
    .group .full {
      display: none;
    }
  }
  /* The live bars sit right by the word, standing on its baseline: they are the sound itself. The key keeps its place at
     the end. The bars are added from code, so they carry no scope attribute: global. */
  .group :global(.bars) {
    order: 1;
    height: 10px;
    margin: 1px 0 0 7px;
  }

  .full.exit {
    display: none;
  }
  .is-full .full.exit {
    display: grid;
    position: fixed;
    z-index: 21;
    top: 16px;
    right: 16px;
    margin: 0;
    transition: opacity 200ms ease-out;
  }
  [data-tone="dark"].is-full .full.exit {
    background: color-mix(in srgb, #fff 12%, transparent);
    color: var(--color-off-white);
  }
  /* In full screen only the glass stays, centred and as large as the screen allows, on the colour of its background.
     After a moment without the mouse, the key and the cursor step aside. */
  .is-full .intro,
  .is-full .controls,
  .is-full .bottom,
  .is-full .looks {
    display: none;
  }
  /* While the browser takes the screen, everything but the glass fades out of the way. */
  .is-going-full .intro,
  .is-going-full .controls,
  .is-going-full .bottom,
  .is-going-full .looks,
  .top:has(~ .glass.is-going-full) {
    opacity: 0;
    transition: opacity 160ms ease-out;
  }
  .is-full .stage-wrap {
    position: fixed;
    z-index: 20;
    inset: 0;
    background: var(--color-off-white);
  }
  .is-full .stage-sticky {
    position: static;
    height: 100%;
  }
  .is-full .stage {
    width: min(92vw, 92svh);
  }
  /* Only with a mouse: a touch screen has nothing to move to bring them back. */
  @media (hover: hover) {
    .is-full.is-resting .full.exit {
      opacity: 0;
    }
    .is-full.is-resting .stage canvas {
      cursor: none;
    }
  }
  /* Into full screen and back, the glass travels between its place and the middle of the screen and grows or shrinks,
     while the rest of the page fades (a view transition; without one, the change is plain). */
  .stage canvas {
    view-transition-name: glass;
  }
  :global(::view-transition-group(glass)) {
    animation-duration: 560ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: 320ms;
  }
  /* The logo row: Upload and the folded text field share one line and trade widths when the field opens.
     The columns are lengths, not fr, so the trade animates. */
  .logo-in {
    display: grid;
    grid-template-columns: calc(100% - 58px) 52px;
    gap: 6px;
    transition: grid-template-columns 360ms cubic-bezier(0.3, 1.2, 0.4, 1);
  }
  .logo-in.is-typing {
    grid-template-columns: 40px calc(100% - 46px);
  }
  /* Typed text. Folded, the field is a raised Aa key like Upload; open, it's a recessed tray like the sliders,
     with the sample marks inside its right end while it's empty. Inside a tray, flat marks are the ones to tap. */
  .type {
    position: relative;
    min-width: 0;
  }
  .type input {
    display: block;
    width: 100%;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    letter-spacing: inherit;
    text-align: center;
    cursor: pointer;
  }
  .type input::placeholder {
    color: var(--ink);
    opacity: 1;
  }
  .is-typing .type input {
    padding: 0 16px 0 14px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 7%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 6%, transparent);
    text-align: left;
    cursor: text;
  }
  .is-typing .type input:placeholder-shown {
    padding-right: 96px;
  }
  .is-typing .type input::placeholder {
    font-weight: 400;
    opacity: 0.45;
  }
  /* Open, the field already says it has focus (a tray with a caret), so its ring is a quiet hairline, not the black one. */
  .type input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .is-typing .type input:focus-visible {
    outline: 1.5px solid color-mix(in srgb, var(--ink) 60%, transparent); /* still 3:1 against the tray */
  }
  .samples {
    position: absolute;
    top: 4px;
    right: 3px;
    bottom: 4px;
    display: flex;
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease-out, visibility 0s 120ms;
  }
  .is-typing input:placeholder-shown + .samples {
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms ease-out 160ms;
  }
  .samples button {
    width: 30px;
    padding: 0;
    background: none;
    box-shadow: none;
    color: var(--ink);
    font-size: 15px;
    line-height: 32px;
    opacity: 0.55;
  }
  .samples button:hover {
    opacity: 1;
    filter: none;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
  }
  .samples button:focus-visible {
    opacity: 1;
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  /* Black and white, but not flat and sterile: soft black, rounded corners, 0.5px strokes.
     Page styling is a separate task once the tool is finished. */
  /* On body, not .glass: the header and footer use these colors too. */
  :global(body) {
    --ink: color-mix(in srgb, var(--color-black) 88%, var(--color-off-white));
    --hair: color-mix(in srgb, var(--color-black) 22%, transparent);
    --tray: color-mix(in srgb, var(--color-black) 5%, var(--color-off-white));
    --raised: color-mix(in srgb, white 70%, var(--color-off-white));
    --panel: color-mix(in srgb, white 40%, var(--color-off-white));
    --tick: color-mix(in srgb, var(--color-black) 6%, transparent);
    /* Raised white surface: thin edge, highlight on top, short soft shadow. */
    --raise: inset 0 1px 0 #fff, 0 0 0 0.5px color-mix(in srgb, var(--color-black) 10%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-black) 6%, transparent),
      0 3px 8px -3px color-mix(in srgb, var(--color-black) 12%, transparent);
    /* Dark button: slightly lighter than black,
       a thin highlight on top, 0.5px along the edge. */
    --btn-dark: linear-gradient(180deg, #3a3a3a 0%, #2a2a2a 100%);
    --btn-edge: inset 0 0.5px 0 rgb(255 255 255 / 0.16), 0 0 0 0.5px rgb(0 0 0 / 0.5),
      0 1px 2px rgb(0 0 0 / 0.14);
  }
  .upload span,
  button {
    display: block;
    width: 100%;
    padding: 12px 16px;
    font-weight: 500;
    border: 0;
    border-radius: 999px;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform 120ms ease-out, filter 120ms ease-out;
  }
  .upload span:hover,
  button:hover {
    filter: brightness(1.12);
  }
  .upload span:active,
  button:active {
    transform: scale(0.985);
  }
  /* Upload is a white key, like Record video: the one black button on the page is Download PNG. */
  .upload span {
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: var(--ink);
  }
  .upload span:hover {
    filter: brightness(0.98);
  }
  .upload > span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 40px;
    padding: 0 14px;
    overflow: hidden;
    white-space: nowrap;
  }
  .upload svg {
    flex: none;
  }
  /* While the text field is open, Upload folds to its arrow. The name only shrinks, so the key keeps it for screen readers. */
  .upload i {
    max-width: 8em;
    font-style: normal;
    transition: max-width 360ms cubic-bezier(0.3, 1, 0.4, 1), opacity 160ms ease-out;
  }
  .is-typing .upload > span {
    gap: 0;
    padding: 0;
  }
  .is-typing .upload i {
    max-width: 0;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-in,
    .upload i {
      transition: none;
    }
  }
  .upload:focus-within span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .hint,
  .status {
    margin: 0;
    opacity: 0.6;
    text-wrap: pretty;
  }
  .status {
    text-align: center;
  }
  .status:empty {
    display: none;
  }
  /* Slider: a gray pill with ticks, a white pill thumb with a label.
     A transparent native range sits on top: mouse, touch, keyboard and screen readers work as usual.
     The range thumb and the visible thumb share one width (--tw), so their positions match. */
  .range {
    --tw: 104px;
    --p: 0.5;
    position: relative;
    display: block;
    height: 40px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 7%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  /* The scale, a ruler: a long tick every 60 px and four short ones between, light along the whole length, darker where
     passed. The short ticks skip the places of the long ones, so no tick is drawn over another. */
  .range::before,
  .range::after {
    --tick: color-mix(in srgb, var(--color-black) 9%, transparent);
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    top: 11px;
    bottom: 11px;
    background:
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 60px) 0 0 / 100% 100% no-repeat,
      repeating-linear-gradient(90deg, transparent 0 12px, var(--tick) 12px 13px, transparent 13px 24px, var(--tick) 24px 25px,
          transparent 25px 36px, var(--tick) 36px 37px, transparent 37px 48px, var(--tick) 48px 49px, transparent 49px 60px)
        0 50% / 100% 6px no-repeat;
    pointer-events: none;
  }
  /* Where the browser can round, the ruler is a whole number of 60 px steps, centred: it starts and ends on a long tick,
     the same distance from both ends of the tray. */
  @supports (width: round(down, 100px, 60px)) {
    .range::before,
    .range::after {
      --len: calc(round(down, 100% - 32px, 60px) + 1px);
      left: round(down, (100% - var(--len)) / 2, 1px);
      right: auto;
      width: var(--len);
    }
  }
  .range::after {
    --tick: color-mix(in srgb, var(--color-black) 20%, transparent);
    clip-path: inset(0 calc((1 - var(--p)) * 100%) 0 0);
  }
  /* The part of a track a video takes: the song's loudness on the tray instead of the ruler, the pill is the 12 seconds
     and says where they start; the detent marks the strongest part, where it starts on its own. */
  .range.clip[hidden] {
    display: none;
  }
  .range.clip::before,
  .range.clip::after {
    display: none;
  }
  .range.clip canvas {
    position: absolute;
    inset: 8px 16px;
    width: calc(100% - 32px);
    height: calc(100% - 16px);
  }
  /* The detent: a dot on the tray under where the look put the thumb. It's hidden while the thumb sits on it. */
  .detent {
    position: absolute;
    bottom: 5px;
    left: calc(3px + var(--d, 0.5) * (100% - var(--tw) - 6px) + var(--tw) / 2);
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    pointer-events: none;
  }
  .range input {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: grab;
  }
  .range input:active {
    cursor: grabbing;
  }
  .range input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: var(--tw);
    height: 40px;
  }
  .range input::-moz-range-thumb {
    width: var(--tw);
    height: 40px;
    border: 0;
  }
  .thumb {
    position: absolute;
    z-index: 1;
    top: 3px;
    bottom: 3px;
    left: calc(3px + var(--p) * (100% - var(--tw) - 6px));
    width: var(--tw);
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    pointer-events: none;
    transition: transform 180ms cubic-bezier(0.3, 1.3, 0.4, 1), box-shadow 180ms ease-out;
  }
  /* Grabbed, the thumb lifts a little off the tray: a touch larger, a longer shadow. */
  .range:has(input:active) .thumb {
    transform: scale(1.045);
    box-shadow: inset 0 1px 0 #fff, 0 0 0 0.5px color-mix(in srgb, var(--color-black) 10%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-black) 8%, transparent),
      0 10px 20px -8px color-mix(in srgb, var(--color-black) 28%, transparent);
  }
  .thumb > span {
    grid-area: 1 / 1;
    transition: opacity 120ms ease-out;
  }
  .name {
    font-weight: 500;
  }
  .val {
    opacity: 0;
    font-variant-numeric: tabular-nums;
  }
  .val::after {
    content: attr(data-v);
  }
  /* While dragging or adjusting with the keyboard, the number replaces the label. */
  .range:has(input:active) .name,
  .range:has(input:focus-visible) .name {
    opacity: 0;
  }
  .range:has(input:active) .val,
  .range:has(input:focus-visible) .val {
    opacity: 1;
  }
  .range:has(input:focus-visible) .thumb {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  /* Segments: a recessed tray, the selected one is filled. */
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
  }
  /* The panel's parts open over a hairline, 24 px from the part above. One size of name everywhere: Sound is named
     like Background, 13 px medium. Look shows no name, its sliders carry theirs on the thumbs. */
  .group {
    display: flex;
    align-items: center;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 0.5px solid color-mix(in srgb, var(--color-black) 10%, transparent);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .group.rule {
    padding-top: 8px;
  }
  .group h2 {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }
  /* Random, the sixth key: an empty well with a die until the first roll, then the roll itself, with the die on its corner.
     Selected, it's raised like a preset. The die turns a third of a turn per roll. */
  .presets .seg:has(> .slot) {
    --n: 6;
  }
  .presets .slot {
    width: auto;
    padding: 0;
    border-radius: calc(var(--thumb) * 0.24 + var(--pad));
    background: none;
    box-shadow: none;
    color: inherit;
    font-weight: inherit;
  }
  .presets .slot:hover {
    filter: none;
  }
  .presets .slot:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  .slot .well {
    position: relative;
    display: grid;
    place-items: center;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 8%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 7%, transparent);
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }
  .slot canvas {
    display: none;
  }
  .slot.is-filled .well {
    background: none;
    box-shadow: none;
  }
  .slot.is-filled canvas {
    display: block;
  }
  .slot svg {
    transform: rotate(var(--turn, 0deg));
    transition: transform 480ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  /* A new roll comes into its key with a small turn, instead of being swapped in. */
  .slot.is-rolling canvas {
    animation: roll-in 460ms cubic-bezier(0.3, 1.35, 0.4, 1);
  }
  @keyframes roll-in {
    from {
      opacity: 0;
      transform: scale(0.82) rotate(-8deg);
    }
  }
  .slot.is-filled svg {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 20px;
    height: 20px;
    padding: 4px;
    border-radius: 50%;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: var(--ink);
  }
  .presets .seg:has(> .slot.is-on) {
    --i: 5;
  }
  .presets .seg:has(> .slot.is-on)::before {
    opacity: 1;
  }
  .presets .slot.is-on > span {
    color: var(--ink);
  }
  /* With a mouse, a key under the glass answers the pointer: its glass lifts 2 px; an empty Random turns its die a little. */
  .presets canvas,
  .slot .well {
    transition: transform 200ms cubic-bezier(0.3, 1.3, 0.4, 1), box-shadow 200ms ease-out;
  }
  @media (hover: hover) {
    .presets label:hover canvas,
    .presets .slot:hover .well {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px -6px color-mix(in srgb, var(--color-black) 30%, transparent);
    }
    .slot:not(.is-filled):hover svg {
      transform: rotate(calc(var(--turn, 0deg) + 30deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slot svg,
    .presets canvas,
    .slot .well {
      transition: none;
    }
  }
  /* For screen readers only: the group name already says it on screen. */
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Group and toggle labels are medium: they are names. */
  legend,
  .check span {
    font-weight: 500;
  }
  legend {
    width: 100%;
    padding: 0;
    margin-bottom: 8px;
  }
  /* A name under a slider gets the space of a new line of thought: 16 px, not 8. */
  .controls > .range + fieldset {
    margin-top: 8px;
  }
  /* One selected pill per tray, sliding to the new option (like iOS segmented controls):
     --n is how many options, --i is which one is selected. */
  .seg {
    --n: 2;
    --i: 0;
    position: relative;
    isolation: isolate;
    display: flex;
    width: 100%;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 7%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  fieldset label {
    flex: 1;
  }
  fieldset input {
    position: absolute;
    opacity: 0;
  }
  fieldset span {
    display: block;
    padding: 8px 6px;
    border-radius: 999px;
    text-align: center;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 160ms ease-out;
  }
  /* Every control in the panel is 40 px tall: a 34 px option in a tray with 3 px around it. */
  .controls .seg > label > span {
    display: grid;
    place-items: center;
    height: 34px;
    padding: 0 6px;
  }
  .seg::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px - (var(--n) - 1) * 2px) / var(--n));
    /* translate, not transform: the stretch below is a scale, which would stretch a transform's shift along with the pill. */
    translate: calc(var(--i) * (100% + 2px)) 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    transition: translate 360ms cubic-bezier(0.3, 1.05, 0.4, 1), opacity 160ms ease-out; /* barely past the target: the stretch is the bounce now, and it stays inside the tray */
  }
  /* On its way to the new option the pill stretches a little and settles (app.js replays is-moving on each change). */
  .seg.is-moving::before {
    animation: stretch 380ms cubic-bezier(0.3, 0.9, 0.4, 1);
  }
  @keyframes stretch {
    45% {
      scale: 1.1 0.94;
    }
  }
  .seg:has(> label:nth-child(3)) {
    --n: 3;
  }
  .seg:has(> label:nth-child(4)) {
    --n: 4;
  }
  .seg:has(> label:nth-child(5)) {
    --n: 5;
  }
  .seg:has(> label:nth-child(2) input:checked) {
    --i: 1;
  }
  .seg:has(> label:nth-child(3) input:checked) {
    --i: 2;
  }
  .seg:has(> label:nth-child(4) input:checked) {
    --i: 3;
  }
  .seg:has(> label:nth-child(5) input:checked) {
    --i: 4;
  }
  /* Nothing selected (preset cleared by a manual change): no pill. */
  .seg:not(:has(input:checked))::before {
    opacity: 0;
  }
  fieldset label:hover span {
    opacity: 0.85;
  }
  fieldset input:checked + span {
    opacity: 1;
    font-weight: 500;
  }
  fieldset input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  /* Thickness only matters when volume is on. Angle, length and spin only when sides are selected, so with All they're gone. */
  [data-volume="off"] .thick {
    opacity: 0.35;
    pointer-events: none;
  }
  [data-sides="all"] .directional {
    display: none;
  }
  /* Checkboxes as toggles. The whole row is the target, 32 px tall, so a finger finds it. */
  .check {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 32px;
    cursor: pointer;
  }
  .check input {
    order: 2;
    -webkit-appearance: none;
    appearance: none;
    position: relative;
    width: 36px;
    height: 22px;
    margin: 0;
    border-radius: 22px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 10%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 8%, transparent);
    cursor: pointer;
    transition: background-color 160ms ease-out;
  }
  .check input::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    transition: transform 200ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  /* On is the knob turning soft black at the right end; the tray stays light, so the one black key stays Download PNG. */
  .check input:checked::before {
    background: var(--btn-dark);
    box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.18), 0 0 0 0.5px rgb(0 0 0 / 0.5), 0 1px 2px rgb(0 0 0 / 0.2);
    transform: translateX(14px);
  }
  .check input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  /* Download and what follows it (Share, the after-download moves, status) dock at the bottom of the screen
     while the panel scrolls, so Download PNG is on the first screen whatever the panel holds above it.
     The hairline and the frost show only while the panel actually runs under the dock (app.js sets is-stuck). */
  .dock {
    position: sticky;
    bottom: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: inherit;
    padding: 12px 0;
    border-top: 0.5px solid transparent;
    transition: border-color 160ms ease-out, background-color 160ms ease-out;
  }
  .dock.is-stuck {
    background: color-mix(in srgb, var(--color-off-white) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-top-color: color-mix(in srgb, var(--color-black) 10%, transparent);
  }
  .actions {
    display: grid;
    gap: 8px;
  }
  /* A key: its name, and under it in small print what you get; the arrow at the end opens the formats.
     Download PNG is the one black key on the page. */
  .key {
    position: relative;
    display: flex;
    height: 50px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    color: var(--ink);
    transition: transform 120ms ease-out;
  }
  /* Pressed, Download PNG has a band of light run across it, like light across glass (app.js replays is-flash). */
  .key.dark::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.2) 50%, transparent 62%) 130% 0 / 260% 100% no-repeat;
    opacity: 0;
    pointer-events: none;
  }
  .key.dark.is-flash::after {
    animation: sheen 720ms cubic-bezier(0.35, 0.6, 0.3, 1);
  }
  @keyframes sheen {
    from {
      opacity: 1;
      background-position: 130% 0;
    }
    to {
      opacity: 1;
      background-position: -30% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .key.dark.is-flash::after,
    .seg.is-moving::before,
    .slot.is-rolling canvas {
      animation: none;
    }
    .range:has(input:active) .thumb {
      transform: none;
    }
  }
  .key.dark {
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
  }
  .key > button {
    height: 100%;
    background: none;
    box-shadow: none;
    color: inherit;
    transition: background-color 120ms ease-out;
  }
  /* Not while disabled: Record video keeps its progress fill under the cursor while it records. */
  .key > button:hover:not(:disabled) {
    filter: none;
    background: color-mix(in srgb, var(--color-black) 3%, transparent);
  }
  .key.dark > button:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.07);
  }
  .key > button:active {
    transform: none;
  }
  .key:has(> button:active) {
    transform: scale(0.985);
  }
  .key > button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .key > button:first-child {
    flex: 1;
    width: auto;
    display: grid;
    place-content: center;
    padding: 0 8px 0 16px;
    border-radius: 999px 0 0 999px;
    line-height: 1.25;
  }
  .key small {
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
    white-space: nowrap;
  }
  /* The arrow: its own part of the key, after a hairline. It turns over while its menu is open. */
  .key .opt {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    padding: 0 4px 0 0;
    border-radius: 0 999px 999px 0;
    box-shadow: inset 0.5px 0 0 color-mix(in srgb, var(--color-black) 12%, transparent);
  }
  .key.dark .opt {
    box-shadow: inset 0.5px 0 0 rgb(255 255 255 / 0.16);
  }
  .opt svg {
    opacity: 0.7;
    transition: transform 220ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .opt[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  /* A key dims as a whole, not just its label. */
  .key:has(> button:disabled) {
    opacity: 0.4;
  }
  .key > button:disabled {
    opacity: 1;
    filter: none; /* the page's button:hover brightening would wash out the recording fill */
  }
  .is-recording .opt {
    pointer-events: none;
  }
  /* The formats menu opens over its key and as wide as it (app.js places it). A row is a format with a drawing
     of its framing; the chosen one has a check. Hovering a row lays the tray under it. */
  .menu {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: inset 0 1px 0 #fff, 0 0 0 0.5px color-mix(in srgb, var(--color-black) 10%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-black) 6%, transparent),
      0 16px 32px -12px color-mix(in srgb, var(--color-black) 24%, transparent);
    color: var(--ink);
    font-size: var(--text-meta);
    letter-spacing: -0.04em;
  }
  /* A fieldset is display: flex in this sheet, which would keep a closed menu on screen. */
  .menu:not(:popover-open) {
    display: none;
  }
  /* Without popovers (Safari before 17, Firefox before 125) the menu opens in the dock itself, under the keys,
     when app.js marks it is-open. A browser that can't read :popover-open drops the rule above, so this one hides it. */
  @supports not selector(:popover-open) {
    .menu {
      position: static;
      display: none;
      gap: 2px;
    }
    .menu.is-open {
      display: grid;
    }
  }
  .menu:popover-open {
    display: grid;
    gap: 2px;
    animation: menu-in 220ms cubic-bezier(0.3, 1.2, 0.4, 1);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  .menu label {
    display: block;
  }
  .menu span {
    display: grid;
    grid-template-columns: 16px 1fr 10px;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 12px;
    border-radius: 14px;
    text-align: left;
    white-space: nowrap;
    opacity: 1;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
    transition: background-color 120ms ease-out;
  }
  .menu label:hover span {
    opacity: 1;
    background: var(--tray);
    color: var(--ink);
  }
  .menu input:checked + span {
    color: var(--ink);
  }
  .menu input:checked + span::after {
    content: "";
    width: 9px;
    height: 5px;
    border-left: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(-45deg);
  }
  .menu input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu:popover-open {
      animation: none;
    }
  }
  /* Share is a small link under the buttons, shown after the first save. */
  .share {
    width: auto;
    align-self: center;
    padding: 6px 12px;
    background: none;
    box-shadow: none;
    color: var(--ink);
    animation: share-in 320ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .share:hover {
    filter: none;
    background: var(--tray);
  }
  /* On iPhone it's a full dark button: it's the only way to save the file. */
  .share.is-save {
    width: 100%;
    align-self: stretch;
    padding: 12px 16px;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
  }
  .share.is-save:hover {
    background: var(--btn-dark);
    filter: brightness(1.12);
  }
  .share[hidden] {
    display: none;
  }
  @keyframes share-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  /* While video records, the key fills over the recording and counts the seconds down (app.js), so you can see how long
     to wait: one loop, or longer with sound. The status under the keys then speaks only to screen readers, unless it has
     something of its own to say: with no background, that the video records on light. */
  .is-recording .key:has([data-video]) {
    opacity: 1;
  }
  .is-recording [data-video] .res {
    display: none;
  }
  .is-recording:not([data-background="none"]) .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .is-recording .key > [data-video] {
    opacity: 1;
    background:
      linear-gradient(var(--tray), var(--tray)) left / 0% 100% no-repeat,
      linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    animation: rec var(--rec, 4s) linear forwards;
  }
  @keyframes rec {
    to {
      background-size: 100% 100%, auto;
    }
  }
  /* The sound meter by the word Sound: eight thin bars, ink colour, growing from the baseline.
     The tool adds it from code, so it carries no scope attribute: global. */
  :global(.bars) {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
    margin-left: auto;
  }
  :global(.bars[hidden]) {
    display: none;
  }
  :global(.bars i) {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: color-mix(in srgb, currentColor 55%, transparent);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }
  /* Each preset key shows your own logo in that look: a small glass over the name. */
  .presets label,
  .presets .slot {
    flex: 0 0 var(--key);
  }
  .presets span {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding-block: var(--pad) calc(var(--pad) - 2px); /* the name's own line spacing makes up the 2 px */
    font-size: 12px;
  }
  .presets canvas,
  .slot .well {
    width: var(--thumb);
    height: var(--thumb);
    border-radius: calc(var(--thumb) * 0.24); /* the glass's own corner; it also hides the dark corners of the Night key */
  }
  /* A round look (Lens, or a round roll) gets a round key glass, so its lift and shadow follow the circle. */
  .presets canvas.is-round,
  .slot.is-round .well {
    border-radius: 50%;
  }
  /* The glass stays at full strength on every key; only the names of the unselected ones dim. */
  .presets span {
    opacity: 1;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }
  .presets input:checked + span {
    color: var(--ink);
  }
  /* Under the glass the tray itself is gone: only the selected key is raised. Softer corners than a pill,
     or the selection turns into an oval. */
  .presets .seg {
    border-radius: 22px;
    background: none;
    box-shadow: none;
  }
  .presets .seg::before {
    border-radius: calc(var(--thumb) * 0.24 + var(--pad));
  }
  /* Six keys share the row under the glass: the labels go edge to edge and never wrap. */
  .presets span {
    padding-inline: 0;
    white-space: nowrap;
  }

  /* Advanced: secondary settings are collapsed so the download buttons stay on the first screen.
     Opens smoothly (interpolate-size; instantly where it isn't supported). */
  .glass {
    interpolate-size: allow-keywords;
  }
  /* Advanced closes the panel, under a hairline like the groups: the finer look settings. The formats live on the keys. */
  .advanced {
    margin-top: 16px;
    padding-top: 8px;
    border-top: 0.5px solid color-mix(in srgb, var(--color-black) 10%, transparent);
  }
  .advanced summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 32px;
    list-style: none;
    font-weight: 500;
    cursor: pointer;
  }
  .advanced summary::-webkit-details-marker {
    display: none;
  }
  .advanced summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    opacity: 0.6;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 240ms ease-out;
  }
  .advanced[open] summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .advanced summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .advanced::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 360ms cubic-bezier(0.3, 0.9, 0.4, 1), content-visibility 360ms allow-discrete;
  }
  .advanced[open]::details-content {
    block-size: auto;
  }
  .advanced.instant::details-content {
    transition: none;
  }
  /* Side padding so thumb and tray shadows aren't clipped. */
  .adv-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 -6px;
    padding: 12px 6px 6px;
  }

  /* Footer: the ☺ signature (once per surface) and links. */
  .bottom {
    grid-area: foot;
    display: grid;
    gap: 6px;
    padding: 8px 0 0;
    font-size: var(--text-meta);
  }
  .bottom p {
    margin: 0;
  }
  .made {
    font-size: var(--text-body);
    font-weight: 500;
  }
  /* The name links to X, the line under it to the review form: clearly clickable, but without the blue browser underline. */
  .made a,
  .pitch a {
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--hair);
    transition: text-decoration-color 120ms ease-out;
  }
  .made a:hover,
  .pitch a:hover {
    text-decoration-color: currentColor;
  }
  /* The source link in the caption: the footer's hairline underline. The caption is at 0.6 opacity, so the line is
     darker here to come out the same. */
  .caption a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-black) 37%, transparent);
    transition: text-decoration-color 120ms ease-out;
  }
  .caption a:hover {
    text-decoration-color: currentColor;
  }

  /* Short laptop screen: tighter, so Download PNG stays on the first screen. */
  @media (min-width: 761px) and (max-height: 820px) {
    .intro {
      padding-top: 44px;
    }
    h1 {
      margin-bottom: 8px;
    }
    .glass {
      row-gap: 16px;
    }
    .controls {
      padding-bottom: 16px;
    }
    .dock {
      padding: 10px 0;
    }
    .controls > .hint:not(.caption) {
      display: none;
    }
  }

  /* The narrowest phones: the handle gives way to the review pill (X is in the footer too). */
  @media (max-width: 340px) {
    .top nav [data-link="x-handle"] {
      display: none;
    }
  }

  @media (max-width: 760px) {
    /* Dropping and pasting are desktop gestures; on a phone the hint only takes room from the glass. */
    .drop-hint {
      display: none;
    }
    /* On a phone the dock is under the thumb, edge to edge: Download PNG and Record video side by side, tighter. */
    .dock {
      gap: 8px;
      margin-inline: -24px;
      padding: 10px 24px;
    }
    .dock .actions {
      grid-template-columns: 1fr 1fr;
      margin-top: 0;
    }
    /* Half a screen per key: a narrower arrow, and the small print keeps only what changes, the length. */
    .key > button:first-child {
      padding: 0 6px 0 12px;
    }
    .key .opt {
      width: 34px;
    }
    .key .res {
      display: none;
    }
    .dock .share.is-save {
      margin-top: 0;
    }
    .glass {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "intro" "stage" "controls" "foot";
      grid-template-rows: none;
    }
    .top {
      position: static;
      margin-bottom: 18px;
    }
    /* On a phone the glass is the headline: the name and the line sit in one quiet row over it. */
    .intro {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 7px;
      padding: 0;
    }
    h1 {
