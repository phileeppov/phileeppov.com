---
// Tool: logo → glass icon. Copy: site.md §7.
// Exception: elsewhere heavy effects load as desktop-only islands; here the effect is the page itself, so WebGL runs on phones too.
// The page font is Onest; the rest of the site uses its own stack from tokens.css.
// Custom header and footer: the wordmark in version mode (phil 01 ppov is mini-project #01).
import Base from "../layouts/Base.astro";
import "../styles/onest.css";
---

<Base title="Glass" description="Drop a logo, get it back as a glass app icon. Runs in your browser." image="/glass-og.png" bare>
  <Fragment slot="head">
    <link rel="icon" type="image/png" sizes="64x64" href="/glass-favicon.png" />
    <link rel="apple-touch-icon" href="/glass-touch-icon.png" />
  </Fragment>

  <!-- Author links: wordmark → portfolio, handle → X profile. Every link off this page opens in a new tab,
       so the uploaded logo and settings aren't lost. -->
  <header class="top">
    <a class="mark" href="/" target="_blank" rel="noopener" aria-label="phil01ppov, portfolio" title="Portfolio" data-link="wordmark">phil<i>01</i>ppov</a>
    <nav>
      <a href="https://x.com/phileeppov" target="_blank" rel="noopener" data-link="x-handle">@phileeppov</a>
      <a class="work" href="/" target="_blank" rel="noopener" data-link="portfolio">Portfolio</a>
    </nav>
  </header>

  <main class="glass" data-glass data-sides="two" data-volume="on">
    <div class="intro">
      <h1>Glass</h1>
      <p>Drop a logo, get it back in glass.</p>
    </div>

    <div class="stage-wrap">
      <div class="stage-sticky">
        <div class="stage" data-stage>
          <canvas aria-label="Glass icon preview"></canvas>
          <p class="unsupported">WebGL isn't working in this browser, so the glass can't render.</p>
        </div>
      </div>
    </div>

    <form class="controls" autocomplete="off" onsubmit="return false">
      <label class="upload">
        <span>Upload logo</span>
        <input type="file" accept=".svg,image/svg+xml,image/png,image/jpeg,image/webp" />
      </label>
      <p class="hint">Or drop an SVG or PNG anywhere. From Figma: Copy as SVG, then paste.</p>

      <fieldset class="presets">
        <legend>Presets</legend>
        <div class="seg">
          <label><input type="radio" name="preset" value="studio" checked /><span>Studio</span></label>
          <label><input type="radio" name="preset" value="melt" /><span>Melt</span></label>
          <label><input type="radio" name="preset" value="prism" /><span>Prism</span></label>
          <label><input type="radio" name="preset" value="lens" /><span>Lens</span></label>
          <label><input type="radio" name="preset" value="night" /><span>Night</span></label>
        </div>
      </fieldset>

      <label class="range"><input type="range" name="refraction" min="0" max="1.5" step="any" value="1.5" /><span class="thumb"><span class="name">Refraction</span><span class="val" aria-hidden="true"></span></span></label>
      <label class="range"><input type="range" name="liquid" min="0" max="1" step="any" value="0.75" /><span class="thumb"><span class="name">Blend</span><span class="val" aria-hidden="true"></span></span></label>
      <label class="range"><input type="range" name="size" min="0.3" max="1.2" step="any" value="0.66" /><span class="thumb"><span class="name">Logo size</span><span class="val" aria-hidden="true"></span></span></label>
      <fieldset>
        <legend>Background</legend>
        <div class="seg">
          <label><input type="radio" name="background" value="light" checked /><span>Light</span></label>
          <label><input type="radio" name="background" value="dark" /><span>Dark</span></label>
          <label><input type="radio" name="background" value="none" /><span>None</span></label>
        </div>
      </fieldset>

      <details class="advanced" data-advanced>
        <summary>Advanced</summary>
        <div class="adv-body">
          <label class="range"><input type="range" name="dispersion" min="0" max="1" step="any" value="0.95" /><span class="thumb"><span class="name">Dispersion</span><span class="val" aria-hidden="true"></span></span></label>
          <label class="range"><input type="range" name="edge" min="0.06" max="0.35" step="any" value="0.18" /><span class="thumb"><span class="name">Edge width</span><span class="val" aria-hidden="true"></span></span></label>
          <fieldset>
            <legend>Edges</legend>
            <div class="seg">
              <label><input type="radio" name="sides" value="all" /><span>All</span></label>
              <label><input type="radio" name="sides" value="two" checked /><span>Two</span></label>
              <label><input type="radio" name="sides" value="one" /><span>One</span></label>
            </div>
          </fieldset>
          <label class="range directional"><input type="range" name="angle" min="0" max="360" step="any" value="45" /><span class="thumb"><span class="name">Angle</span><span class="val" aria-hidden="true"></span></span></label>
          <label class="range directional"><input type="range" name="spread" min="0" max="1" step="any" value="0.6" /><span class="thumb"><span class="name">Length</span><span class="val" aria-hidden="true"></span></span></label>
          <label class="check directional"><input type="checkbox" name="spin" /><span>Spin</span></label>
          <label class="range"><input type="range" name="motion" min="0" max="1" step="any" value="0.5" /><span class="thumb"><span class="name">Motion</span><span class="val" aria-hidden="true"></span></span></label>
          <label class="check"><input type="checkbox" name="volume" checked /><span>Depth</span></label>
          <label class="range thick"><input type="range" name="thickness" min="0.05" max="1" step="any" value="0.35" /><span class="thumb"><span class="name">Thickness</span><span class="val" aria-hidden="true"></span></span></label>
          <fieldset>
            <legend>Shape</legend>
            <div class="seg">
              <label><input type="radio" name="shape" value="squircle" checked /><span>Squircle</span></label>
              <label><input type="radio" name="shape" value="circle" /><span>Circle</span></label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Logo color</legend>
            <div class="seg">
              <label><input type="radio" name="color" value="original" checked /><span>Original</span></label>
              <label><input type="radio" name="color" value="black" /><span>Black</span></label>
              <label><input type="radio" name="color" value="white" /><span>White</span></label>
            </div>
          </fieldset>
        </div>
      </details>

      <fieldset>
        <legend>Video</legend>
        <div class="seg">
          <label><input type="radio" name="format" value="square" checked /><span>Square</span></label>
          <label><input type="radio" name="format" value="wide" /><span>Wide 16:9</span></label>
        </div>
      </fieldset>

      <div class="actions">
        <button type="button" data-png>Download PNG</button>
        <button type="button" data-video>Record video</button>
      </div>
      <button type="button" class="share" data-share hidden>Share it on X →</button>
      <p class="status" data-status aria-live="polite"></p>
      <p class="hint caption">PNG 1024 px · MP4 1080p, 4 s · Your logo never leaves your browser.</p>
    </form>
    <footer class="bottom">
      <p class="made">Made by <a href="https://x.com/phileeppov" target="_blank" rel="noopener" data-link="x-name">Nikita Filippov</a> ☺</p>
      <p>
        <a href="mailto:nikita@phileeppov.com" data-link="email">Email</a>{" · "}
        <a href="https://linkedin.com/in/phileeppov" target="_blank" rel="noopener" data-link="linkedin">LinkedIn</a>{" · "}
        <a href="https://github.com/phileeppov" target="_blank" rel="noopener" data-link="github">GitHub</a>
      </p>
    </footer>
  </main>

</Base>

<script>
  import "../scripts/glass/app.ts";
</script>

<style>
  /* All page text is Onest, tracking −4%. Page styles load only on /glass. */
  :global(html) {
    font-family: "Onest", var(--font-base);
    letter-spacing: -0.04em;
  }
  :global(body) {
    padding: 20px 24px;
  }
  .page-links a,
  .top a,
  .bottom a {
    color: inherit;
    text-decoration: none;
  }

  /* Header: wordmark on the left, two links on the right. */
  /* The header sits over the page, not above it: the stage starts at the top of the screen, so the icon is centered from the first frame. */
  .top {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-meta);
  }
  .mark {
    font-size: 17px;
    font-weight: 500;
    transition: opacity 120ms ease-out;
  }
  /* The wordmark leads to the portfolio, so it responds to hover like a link. */
  .mark:hover {
    opacity: 0.6;
  }
  .mark i {
    font-family: var(--font-anomaly);
    letter-spacing: 0;
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  /* Portfolio is a small white pill, like the buttons in the panel: the main path to the portfolio. */
  .top nav .work {
    padding: 6px 14px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    font-weight: 500;
    opacity: 1;
  }
  .top nav .work:hover {
    filter: brightness(0.98);
  }
  .top nav a,
  .bottom a {
    opacity: 0.6;
    transition: opacity 120ms ease-out;
  }
  .top nav a:hover,
  .bottom a:hover {
    opacity: 1;
  }

  .glass {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    /* The stage spans two rows, next to the panel and the footer, so it keeps the icon centered on screen all the way down. */
    grid-template-areas:
      "stage intro"
      "stage controls"
      "stage foot";
    gap: 24px 40px;
    align-items: start;
  }
  /* Title above the panel, in the right column; the top padding makes room for the header links. */
  .intro {
    grid-area: intro;
    padding: 56px 4px 0;
  }
  h1 {
    font-size: clamp(48px, 5vw, 72px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.065em;
    margin: 0 0 12px;
  }
  .intro p {
    margin: 0;
    font-size: var(--text-body);
  }

  /* The stage is pinned: while you adjust settings, the icon is always in view. */
  /* The stage is full viewport height and sticks to the top, so the icon always sits in the middle of the screen. */
  .stage-wrap {
    grid-area: stage;
    align-self: stretch;
    position: relative;
  }
  .stage-sticky {
    position: sticky;
    top: 20px;
    height: calc(100vh - 40px);
    height: calc(100svh - 40px);
    display: grid;
    place-items: center;
    width: 100%;
  }
  .stage {
    position: relative;
    width: min(100%, 720px, calc(100svh - 80px));
    aspect-ratio: 1;
  }
  .caption {
    text-align: center;
    font-size: 12px;
  }
  /* A file is being dragged over the page: highlight the stage, it can be dropped anywhere. */
  :global(.is-over) .stage canvas {
    outline: 2px dashed var(--ink);
    outline-offset: -10px;
  }
  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    /* The checkerboard shows only in no-background mode, to show the PNG is transparent. */
    background: repeating-conic-gradient(var(--color-off-white) 0 25%, color-mix(in srgb, var(--color-black) 6%, var(--color-off-white)) 0 50%) 0 0 / 24px 24px;
  }
  .unsupported {
    display: none;
  }
  :global(.is-unsupported) .unsupported {
    display: block;
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 24px;
  }

  /* All settings in one soft panel: near-white, large radius,
     a light top edge and a wide soft shadow. */
  .controls {
    grid-area: controls;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border-radius: 28px;
    font-size: var(--text-meta);
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    border: 0.5px solid color-mix(in srgb, var(--color-black) 8%, transparent);
    box-shadow:
      inset 0 1px 0 #fff,
      0 1px 2px color-mix(in srgb, var(--color-black) 5%, transparent),
      0 16px 40px -16px color-mix(in srgb, var(--color-black) 22%, transparent);
  }
  .upload input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  /* Black and white, but not flat and sterile: soft black, rounded corners, 0.5px strokes.
     Page styling is a separate task once the tool is finished. */
  /* On body, not .glass: the header and footer use these colors too. */
  :global(body) {
    --ink: color-mix(in srgb, var(--color-black) 88%, var(--color-off-white));
    --hair: color-mix(in srgb, var(--color-black) 22%, transparent);
    --tray: color-mix(in srgb, var(--color-black) 5%, var(--color-off-white));
    --raised: color-mix(in srgb, white 70%, var(--color-off-white));
    --panel: color-mix(in srgb, white 40%, var(--color-off-white));
    --tick: color-mix(in srgb, var(--color-black) 6%, transparent);
    /* Raised white surface: thin edge, highlight on top, short soft shadow. */
    --raise: inset 0 1px 0 #fff, 0 0 0 0.5px color-mix(in srgb, var(--color-black) 10%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-black) 6%, transparent),
      0 3px 8px -3px color-mix(in srgb, var(--color-black) 12%, transparent);
    /* Dark button: slightly lighter than black,
       a thin highlight on top, 0.5px along the edge. */
    --btn-dark: linear-gradient(180deg, #3a3a3a 0%, #2a2a2a 100%);
    --btn-edge: inset 0 0.5px 0 rgb(255 255 255 / 0.16), 0 0 0 0.5px rgb(0 0 0 / 0.5),
      0 1px 2px rgb(0 0 0 / 0.14);
  }
  .upload span,
  button {
    display: block;
    width: 100%;
    padding: 12px 16px;
    font-weight: 500;
    border: 0;
    border-radius: 999px;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform 120ms ease-out, filter 120ms ease-out;
  }
  .upload span:hover,
  button:hover {
    filter: brightness(1.12);
  }
  .upload span:active,
  button:active {
    transform: scale(0.985);
  }
  .upload:focus-within span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .hint,
  .status {
    margin: 0;
    opacity: 0.6;
    text-wrap: pretty;
  }
  .status {
    text-align: center;
  }
  .status:empty {
    display: none;
  }
  /* Slider: a gray pill with ticks, a white pill thumb with a label.
     A transparent native range sits on top: mouse, touch, keyboard and screen readers work as usual.
     The range thumb and the visible thumb share one width (--tw), so their positions match. */
  .range {
    --tw: 104px;
    --p: 0.5;
    position: relative;
    display: block;
    height: 40px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 7%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  /* Ticks: light along the whole length, darker where passed. */
  .range::before,
  .range::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    bottom: 12px;
    background: repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 15px);
    pointer-events: none;
  }
  .range::after {
    --tick: color-mix(in srgb, var(--color-black) 14%, transparent);
    clip-path: inset(0 calc((1 - var(--p)) * 100%) 0 0);
  }
  .range input {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: grab;
  }
  .range input:active {
    cursor: grabbing;
  }
  .range input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: var(--tw);
    height: 40px;
  }
  .range input::-moz-range-thumb {
    width: var(--tw);
    height: 40px;
    border: 0;
  }
  .thumb {
    position: absolute;
    z-index: 1;
    top: 3px;
    bottom: 3px;
    left: calc(3px + var(--p) * (100% - var(--tw) - 6px));
    width: var(--tw);
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    pointer-events: none;
  }
  .thumb > span {
    grid-area: 1 / 1;
    transition: opacity 120ms ease-out;
  }
  .name {
    font-weight: 500;
  }
  .val {
    opacity: 0;
    font-variant-numeric: tabular-nums;
  }
  .val::after {
    content: attr(data-v);
  }
  /* While dragging or adjusting with the keyboard, the number replaces the label. */
  .range:has(input:active) .name,
  .range:has(input:focus-visible) .name {
    opacity: 0;
  }
  .range:has(input:active) .val,
  .range:has(input:focus-visible) .val {
    opacity: 1;
  }
  .range:has(input:focus-visible) .thumb {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  /* Segments: a recessed tray, the selected one is filled. */
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
  }
  /* Group and toggle labels are medium: they are names. */
  legend,
  .check span {
    font-weight: 500;
  }
  legend {
    width: 100%;
    padding: 0;
    margin-bottom: 6px;
  }
  /* One selected pill per tray, sliding to the new option (like iOS segmented controls):
     --n is how many options, --i is which one is selected. */
  .seg {
    --n: 2;
    --i: 0;
    position: relative;
    isolation: isolate;
    display: flex;
    width: 100%;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 7%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  fieldset label {
    flex: 1;
  }
  fieldset input {
    position: absolute;
    opacity: 0;
  }
  fieldset span {
    display: block;
    padding: 8px 6px;
    border-radius: 999px;
    text-align: center;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 160ms ease-out;
  }
  .seg::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px - (var(--n) - 1) * 2px) / var(--n));
    transform: translateX(calc(var(--i) * (100% + 2px)));
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    transition: transform 360ms cubic-bezier(0.3, 1.3, 0.4, 1), opacity 160ms ease-out;
  }
  .seg:has(> label:nth-child(3)) {
    --n: 3;
  }
  .seg:has(> label:nth-child(4)) {
    --n: 4;
  }
  .seg:has(> label:nth-child(5)) {
    --n: 5;
  }
  .seg:has(> label:nth-child(2) input:checked) {
    --i: 1;
  }
  .seg:has(> label:nth-child(3) input:checked) {
    --i: 2;
  }
  .seg:has(> label:nth-child(4) input:checked) {
    --i: 3;
  }
  .seg:has(> label:nth-child(5) input:checked) {
    --i: 4;
  }
  /* Nothing selected (preset cleared by a manual change): no pill. */
  .seg:not(:has(input:checked))::before {
    opacity: 0;
  }
  fieldset label:hover span {
    opacity: 0.85;
  }
  fieldset input:checked + span {
    opacity: 1;
    font-weight: 500;
  }
  fieldset input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  /* Angle and spin only matter when sides are selected; thickness only when volume is on. */
  [data-volume="off"] .thick,
  [data-sides="all"] .directional {
    opacity: 0.35;
    pointer-events: none;
  }
  /* Checkboxes as toggles. */
  .check {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  .check input {
    order: 2;
    -webkit-appearance: none;
    appearance: none;
    position: relative;
    width: 36px;
    height: 22px;
    margin: 0;
    border-radius: 22px;
    background: var(--tray);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--color-black) 10%, transparent),
      inset 0 0 0 0.5px color-mix(in srgb, var(--color-black) 8%, transparent);
    cursor: pointer;
    transition: background-color 160ms ease-out;
  }
  .check input::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    box-shadow: var(--raise);
    transition: transform 200ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .check input:checked {
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
  }
  .check input:checked::before {
    transform: translateX(14px);
  }
  .check input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .actions {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }
  .actions button + button {
    background: linear-gradient(180deg, #fff 0%, var(--panel) 100%);
    color: var(--ink);
    box-shadow: var(--raise);
  }
  .actions button + button:hover {
    filter: brightness(0.98);
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  /* Share is a small link under the buttons, shown after the first save. */
  .share {
    width: auto;
    align-self: center;
    padding: 6px 12px;
    background: none;
    box-shadow: none;
    color: var(--ink);
    animation: share-in 320ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .share:hover {
    filter: none;
    background: var(--tray);
  }
  /* On iPhone it's a full dark button: it's the only way to save the file. */
  .share.is-save {
    width: 100%;
    align-self: stretch;
    /* Close to "Record video", like the buttons in .actions (8px), not with the panel's shared gap. */
    margin-top: -6px;
    padding: 12px 16px;
    background: var(--btn-dark);
    box-shadow: var(--btn-edge);
    color: var(--color-off-white);
  }
  .share.is-save:hover {
