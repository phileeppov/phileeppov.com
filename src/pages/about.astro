---
// About: site.md §4, copy verbatim. The /review style (Site.astro): the title at the left edge, as on every page, then
// one column of short paragraphs. Photo: one shot, an asymmetric crop, mid-size (design notes §4), on the left edge
// beside the text, looking into it, and held there while the text scrolls. It shows once a file is in
// src/assets/about/; until then the text starts at the left edge.
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import Stamp from "../components/Stamp.astro";

const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/about/*.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<Site title="About" description="I design products. I've been doing it for five years." image="/about-og.jpg">
  <main class="page flow about">
    <section class="part intro">
      <h1 class="label caps">ABOUT</h1>
      <p class="page-title">I'm Nikita.</p>
    </section>

    <section class="story">
      {
        photo && (
          <figure class="photo">
            <Image src={photo} alt="Nikita Filippov" widths={[400, 800]} sizes="(min-width: 900px) 336px, 70vw" />
          </figure>
        )
      }
      <!-- The stamp signs off the page: its rim crosses "it" in the last words (off until approved; ?stamp=on to
           review). -->
      <div class="text">
        <Stamp seed={2} prefer={-30} />
        <p class="lead"><span>I design products.</span> <span>I've been doing it for five&nbsp;years.</span></p>
        <p>I studied business, not design. I started designing because of a project of my own: I felt nobody else would get how I wanted it to look. Then came work for friends, then a website for a local repair and tailoring shop. It's still&nbsp;live.</p>
        <p>Then Medal, a desktop app for gamers. I worked on avatars and rewards, then on how you record the thing that just happened. Then crypto: a wallet, an explorer, a set of tools. The wallet launched at ETHDenver 2023. The explorer never shipped. None of it runs now, for reasons that had nothing to do with&nbsp;design.</p>
        <p>I've worked in teams and in a studio. Now I design on my own. The work I'm proudest of came when the decisions were mine to&nbsp;make.</p>

        <hr class="rule" />

        <p>I like to travel, change my surroundings and get deep into a culture I don't know&nbsp;yet.</p>
        <p>I reply to designers on X more than I post. I build my own tools with Claude&nbsp;Code. I'm trying to make design experiments a habit, and to post each&nbsp;one.</p>

        <hr class="rule" />

        <div class="closing">
          <p data-stamp-host>That's about <span data-stamp-at>it</span>.<br />If you want to work together —</p>
          <a class="btn" href="/review/" data-gem>Send a link, get a video review <span class="arw">→</span></a>
        </div>
      </div>
    </section>
  </main>
</Site>

<style>
  .intro {
    gap: 20px;
    padding-top: 40px;
  }
  /* The title and the story are one part: closer than the parts of the home page. */
  .page.about {
    gap: 96px;
  }

  /* The photo on the left edge, the text beside it; the photo holds its place while the text scrolls past. */
  .story {
    display: grid;
    /* 336px: on a full-width page the text starts on the manifesto's line (its 3:9 row), at x=408. */
    grid-template-columns: minmax(0, 336px) minmax(0, var(--measure-body));
    gap: 48px;
    align-items: start;
  }
  .story > .text:only-child {
    grid-column: 1 / -1;
  }
  .photo {
    position: sticky;
    top: 24px;
    margin: 0;
  }
  /* A print, not a button: a small radius, a 0.5px edge, no shadow under it. */
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-black) 16%, transparent);
  }

  .text {
    display: grid;
    gap: 22px;
    max-width: var(--measure-body);
  }
  .text p {
    margin: 0;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .text .lead {
    margin-bottom: 6px;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  /* Each sentence starts its own line. */
  .text .lead span {
    display: block;
  }
  .rule {
    margin: 40px 0;
  }
  .closing {
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .page.about {
      gap: 64px;
    }
    .story {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .photo {
      position: static;
      width: min(300px, 78%);
    }
  }
  @media (max-width: 560px) {
    .intro {
      gap: 16px;
      padding-top: 16px;
    }
    .page.about {
      gap: 48px;
    }
    .text .lead {
      font-size: 24px;
    }
    .rule {
      margin: 24px 0;
    }
  }
</style>
