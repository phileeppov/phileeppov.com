---
// About: site.md §4, copy verbatim, laid out as the wall (site.css). One statement, the name at Display; under it the
// photo on the left edge, held while the text scrolls, and the story as a caption in the caption half. The photo shows
// once a file is in src/assets/about/; until then the caption stands alone.
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import Stamp from "../components/Stamp.astro";

const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/about/*.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<Site passage title="About" description="I design products. I've been doing it for five years." image="/about-og.jpg">
  <main class="wall about">
    <section class="intro grid">
      <h1 class="label">ABOUT</h1>
      <p class="statement">I'm Nikita.</p>
    </section>

    <section class="part story grid">
      {
        photo && (
          <figure class="photo">
            <Image src={photo} alt="Nikita Filippov" widths={[480, 960]} sizes="(min-width: 1200px) 448px, (min-width: 768px) 40vw, 78vw" />
          </figure>
        )
      }
      <!-- The stamp signs off the page: its rim crosses "it" in the last words. -->
      <div class="cap text">
        <Stamp seed={2} prefer={-30} />
        <p class="first"><span>I design products.</span> <span>I've been doing it for five&nbsp;years.</span></p>
        <p>I studied business, not design. I started designing because of a project of my own: I felt nobody else would get how I wanted it to look. Then came work for friends, then a website for a local repair and tailoring shop. It's still&nbsp;live.</p>
        <p>Then Medal, a desktop app for gamers. I worked on avatars and rewards, then on how you record the thing that just happened. Then crypto: a wallet, an explorer, a set of tools. The wallet launched at ETHDenver 2023. The explorer never shipped. None of it runs now, for reasons that had nothing to do with&nbsp;design.</p>
        <p>I've worked in teams and in a studio. Now I design on my own. The work I'm proudest of came when the decisions were mine to&nbsp;make.</p>

        <hr class="rule" />

        <p>I like to travel, change my surroundings and get deep into a culture I don't know&nbsp;yet.</p>
        <p>I reply to designers on X more than I post. I build my own tools with Claude&nbsp;Code. I'm trying to make design experiments a habit, and to post each&nbsp;one.</p>

        <hr class="rule" />

        <div class="closing">
          <p data-stamp-host>That's about <span data-stamp-at>it</span>.<br />If you want to work together —</p>
          <a class="btn" href="/review/" data-gem>Send a link, get a video review <span class="arw">→</span></a>
        </div>
      </div>
    </section>
  </main>
</Site>

<style>
  .intro {
    padding-bottom: 120px;
  }
  .intro .label,
  .intro .statement {
    grid-column: 1 / -1;
  }
  .intro .statement {
    margin-top: 72px;
  }

  .story {
    padding-bottom: 96px;
    align-items: start;
  }
  /* The photo on the left edge, four columns, a print rather than a button: a small radius, a 0.5px edge, no shadow.
     It holds its place while the text scrolls past. */
  .photo {
    grid-column: 1 / span 4;
    position: sticky;
    top: 24px;
    margin: 72px 0 0;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-black) 16%, transparent);
  }

  /* The story: one caption, body size; its first sentences in weight, not size. */
  .text {
    display: grid;
    gap: 22px;
    margin-top: 72px;
  }
  .text p {
    margin: 0;
  }
  .text .first {
    font-weight: 500;
  }
  .text .first span {
    display: block;
  }
  .rule {
    height: 0;
    margin: 32px 0;
    border: 0;
    border-top: 0.5px solid var(--hair);
  }
  .closing {
    display: grid;
    justify-items: start;
    gap: 24px;
    margin-top: 8px;
  }
  .closing p {
    font-weight: 500;
  }

  @media (max-width: 1199px) {
    .photo {
      grid-column: 1 / span 4;
    }
  }
  @media (max-width: 767px) {
    .photo {
      position: static;
      grid-column: 1 / -1;
      width: min(300px, 78%);
    }
    .text {
      margin-top: 40px;
    }
  }
  @media (max-width: 560px) {
    .intro {
      padding-bottom: 72px;
    }
    .intro .statement {
      margin-top: 48px;
    }
    .photo {
      margin-top: 48px;
    }
    .rule {
      margin: 16px 0;
    }
  }
</style>
