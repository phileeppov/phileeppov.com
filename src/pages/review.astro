---
// Video review request, a page of its own. Open before the site launch: the lock in public/_redirects doesn't cover it.
// Copy: who — site.md §1.1; heading, intro and form — §1.6; the promise — §1.4; the limit line and queue states — §8.
// Built like /glass: the stage on the left (the review you'll get, sketched from what you type), the column on the right.
// The first page in the site MVP style (src/layouts/Site.astro): Onest, monochrome, depth in the controls.
import Site from "../layouts/Site.astro";
import ReviewForm from "../components/ReviewForm.astro";
import ReviewStage from "../components/ReviewStage.astro";
---

<Site title="Video review" description="Send me your product. Get a video review in return.">
  <main class="review">
    <div class="intro">
      <p class="who">Nikita Filippov, product designer. I designed Medal.tv's recording flow.</p>
      <h1><span>Send me your product.</span> <span>Get a video review in&nbsp;return.</span></h1>
      <p class="lead">
        A link is enough: a landing page, Notion, Figma, anything that shows what you're working on. No call needed to start.
      </p>
    </div>
    <div class="stage-wrap">
      <div class="stage-sticky">
        <ReviewStage />
        <!-- The promise is the caption of the video above it. Its middle sentence (site.md §1.4) is the chapters on the
             stage; the stage is hidden from screen readers, so they get the sentence here. -->
        <p class="promise">
          I send back a free video review within 48&nbsp;hours.<span class="sr"> What I see, what I'd do, what it would cost.</span><br />
          If we're not aligned, we stop there. You keep the review.
        </p>
      </div>
    </div>
    <div class="form">
      <ReviewForm />
    </div>
  </main>
</Site>

<style>
  /* Like /glass: the stage spans the rows next to the column, so it stays in view while you fill the form in. */
  .review {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "stage intro"
      "stage form";
    align-items: start;
    gap: 24px 56px;
  }
  .intro {
    grid-area: intro;
  }
  .stage-wrap {
    grid-area: stage;
    align-self: stretch;
  }
  /* The stage grows with the column at 16:10, so on wide but short screens its width is capped by the screen height:
     stage and caption stay on the first screen. */
  .stage-sticky {
    position: sticky;
    top: 24px;
    width: min(100%, calc((100vh - 240px) * 1.6 + 28px));
    width: min(100%, calc((100svh - 240px) * 1.6 + 28px));
    min-height: calc(100svh - 120px);
    margin-inline: auto;
    display: grid;
    align-content: center;
    gap: 18px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .form {
    grid-area: form;
  }

  .who {
    margin: 0 0 14px;
    font-size: var(--text-meta);
    opacity: 0.6;
    text-wrap: pretty;
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(34px, 2.8vw, 42px);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }
  /* Each sentence starts its own line and wraps evenly, so no word hangs alone. */
  h1 span {
    display: block;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    line-height: 1.38;
    text-wrap: pretty;
  }
  .promise {
    max-width: 46em;
    margin: 0;
    padding: 0 20px;
    font-size: var(--text-meta);
    line-height: 1.45;
    opacity: 0.6;
    text-wrap: pretty;
  }

  /* Tablets and phones: one column, the stage between the intro and the form. */
  @media (max-width: 900px) {
    .review {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: "intro" "stage" "form";
    }
    .stage-sticky {
      position: static;
      width: auto;
      min-height: 0;
    }
  }
  @media (max-width: 560px) {
    h1 span {
      display: inline;
    }
    .stage-wrap {
      margin-inline: -8px;
    }
  }
</style>
