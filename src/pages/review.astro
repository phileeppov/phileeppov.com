---
// Video review request, a page of its own. Open before the site launch: the lock in public/_redirects doesn't cover it.
// The offer on the left, read first: who, the title, the terms as tokens, what's in a review and what comes after.
// The form on the right is the review itself (ReviewScreen.astro). The header says whether this week is open.
// Copy: who — site.md §1.1; title — §1.6; what's in it and after — §1.4; terms, status and the screen — §8.
// The first page in the site MVP style (src/layouts/Site.astro): Onest, monochrome, depth in the controls.
import Site from "../layouts/Site.astro";
import ReviewScreen from "../components/ReviewScreen.astro";
---

<Site title="Video review" description="Send me your product. Get a video review in return." image="/review-og.png">
  <!-- Preview and icons: the stage and the reviewer's camera from it (the dark ☺ coin), like /glass has its own. -->
  <Fragment slot="head">
    <link rel="icon" type="image/png" sizes="64x64" href="/review-favicon.png" />
    <link rel="apple-touch-icon" href="/review-touch-icon.png" />
  </Fragment>
  <!-- Filled in from /api/review once the page loads: open this week, or the week a request sent now goes into. -->
  <p class="status" slot="aside" data-status hidden></p>

  <main class="review">
    <section class="offer">
      <p class="who">Nikita Filippov, product designer. I designed Medal.tv's recording flow.</p>
      <h1><span>Send me your product.</span> <span>Get a video review in&nbsp;return.</span></h1>
      <ul class="terms">
        <li>Free</li>
        <li data-in-48>Within 48 hours</li>
        <li>5–10 min video</li>
        <li>No call needed</li>
      </ul>
    </section>
    <section class="after">
      <!-- 1 and 2 match the points marked on the screen; the numbers are drawn in CSS, the sentence stays as written. -->
      <p class="contents"><span data-n="1">What I see,</span> <span data-n="2">what I'd do,</span> <span data-n="3">what it would cost.</span></p>
      <p>If we're not aligned, we stop there. You keep the review.</p>
      <p>If we are, we work async. Video updates, shared Figma, decisions in writing. Calls when useful.</p>
    </section>
    <div class="form">
      <ReviewScreen />
    </div>
  </main>
</Site>

<script>
  import { weekLabel } from "../scripts/review-form";

  // This week open, or the week a new request would land in (worker/index.js). While a queue stands, "within 48 hours"
  // isn't true from today, so that token steps aside. Nothing shows if the request fails.
  const status = document.querySelector<HTMLElement>("[data-status]");
  const in48 = document.querySelector<HTMLElement>("[data-in-48]");
  fetch("/api/review", { headers: { Accept: "application/json" } })
    .then((res) => (res.ok ? res.json() : null))
    .then((s: { queue?: number; week?: string } | null) => {
      if (!status || !s) return;
      const queue = Number(s.queue) || 0;
      status.textContent = queue > 0 && s.week ? `Now booking the week of ${weekLabel(s.week)}` : "Open this week";
      status.hidden = false;
      if (queue > 0 && in48) in48.hidden = true;
    })
    .catch(() => {});
</script>

<style>
  /* The offer on the left, read first; the screen-form on the right, as tall as the window allows. */
  .review {
    display: grid;
    grid-template-columns: 430px minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "offer form"
      "after form";
    gap: 28px 64px;
    align-items: start;
  }
  .offer {
    grid-area: offer;
    display: grid;
    gap: 22px;
  }
  .after {
    grid-area: after;
    display: grid;
    gap: 10px;
    padding-top: 6px;
    font-size: var(--text-meta);
    line-height: 1.45;
  }
  .form {
    grid-area: form;
    width: 100%;
    max-width: calc((100vh - 250px) * 1.6 + 36px);
    max-width: calc((100svh - 250px) * 1.6 + 36px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-weight: 500;
  }
  .status[hidden] {
    display: none;
  }
  .status::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-black) 10%, transparent);
  }

  .who {
    margin: 0;
    font-size: var(--text-meta);
    opacity: 0.6;
    text-wrap: pretty;
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 2.9vw, 42px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.062em;
  }
  /* Each sentence starts its own line and wraps evenly, so no word hangs alone. */
  h1 span {
    display: block;
    text-wrap: balance;
  }

  /* The terms as small raised pills: the promise as tokens instead of sentences. */
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .terms li {
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--raise);
    font-size: var(--text-meta);
    font-weight: 500;
    white-space: nowrap;
  }
  .terms li[hidden] {
    display: none;
  }

  .after p {
    margin: 0;
    text-wrap: pretty;
  }
  .after p:not(.contents) {
    opacity: 0.6;
  }
  .contents {
    font-size: 15px;
    font-weight: 500;
  }
  .contents span::before {
    content: attr(data-n);
    display: inline-grid;
    place-items: center;
    width: 19px;
    height: 19px;
    margin-right: 5px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 1px;
  }

  /* Tablets and phones: one column — the offer, the form, what comes after. Below 1100px two columns leave the screen
     too little room. */
  @media (max-width: 1100px) {
    .review {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: "offer" "form" "after";
    }
    .form {
      max-width: 760px;
    }
  }
  @media (max-width: 560px) {
    h1 span {
      display: inline;
    }
  }
</style>
