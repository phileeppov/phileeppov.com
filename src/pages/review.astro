---
// Video review request, a page of its own. Open before the site launch: the lock in public/_redirects doesn't cover it.
// The offer on the left, read first: who, the title, the terms as tags, what's in a review and what comes after.
// The form on the right is the review itself (ReviewScreen.astro). The header says whether this week is open.
// Copy: title — §1.6; what's in it and after — §1.4; who, terms, status and the screen — §8.
// The first page in the site MVP style (src/layouts/Site.astro): Onest, monochrome, depth in the controls.
import Site from "../layouts/Site.astro";
import ReviewScreen from "../components/ReviewScreen.astro";
---

<Site title="Video review" description="Send me what you're building. Get a video review in return." image="/review-og.png">
  <!-- Preview and icons: the screen-form, and the reviewer's camera as a coin with a smile, like /glass has its own. -->
  <Fragment slot="head">
    <link rel="icon" type="image/png" sizes="64x64" href="/review-favicon.png" />
    <link rel="apple-touch-icon" href="/review-touch-icon.png" />
  </Fragment>
  <!-- Filled in from /api/review once the page loads: open this week, with the weekly limit in the same line so "open"
       doesn't read as a sales trick; or the week a request sent now goes into, with the limit under it on hover or tap. -->
  <button type="button" class="status" slot="aside" data-status hidden>
    <span data-status-text></span>
    <!-- Hidden from the button's name; with a queue, screen readers get it once, as its description. -->
    <span class="tip" id="review-weekly" role="tooltip" aria-hidden="true">I do three reviews a week.</span>
  </button>

  <main class="review">
    <section class="offer">
      <p class="who">Nikita Filippov, product designer. I redesigned game recording in Medal.tv, an&nbsp;app with 3M daily users.</p>
      <h1><span>Send me what you're building.</span> <span>Get a video review in&nbsp;return.</span></h1>
      <ul class="terms">
        <li>Free</li>
        <li data-in-48>Within 48 hours</li>
        <li>5–10 min video</li>
        <li>No call needed</li>
      </ul>
    </section>
    <section class="after">
      <!-- 1 and 2 match the points marked on the screen; the numbers are drawn in CSS, the sentence stays as written.
           From scratch (chosen on the screen) the review is about what to make, so the line changes with it. -->
      <p class="contents" data-for="product"><span data-n="1">What I see,</span> <span data-n="2">what I'd do,</span> <span data-n="3">what it would cost.</span></p>
      <p class="contents" data-for="scratch" hidden><span data-n="1">What to build first,</span> <span data-n="2">how it could look,</span> <span data-n="3">what it would cost.</span></p>
      <!-- Where the cost starts, so nobody spends a slot to find out it's out of reach. -->
      <p class="price" data-for="product">Projects from $3,500.</p>
      <p class="price" data-for="scratch" hidden>A brand and first screens from $5,000.</p>
      <p>If we're not aligned, we stop there. You keep the review.</p>
      <p>If we are, we work async. Video updates, shared Figma, decisions in writing. Calls when useful.</p>
    </section>
    <div class="form">
      <ReviewScreen />
    </div>
  </main>
</Site>

<script>
  import { weekLabel } from "../scripts/review-form";
  import { count } from "../scripts/review-count";

  // A visit, counted once (src/scripts/review-count.ts): Web Analytics misses many of them to blockers.
  count("review:view");

  // The screen switched between a product and from scratch (ReviewScreen.astro): the line about the review follows.
  const page = document.querySelector<HTMLElement>("main.review");
  page?.addEventListener("review:mode", (event) => {
    const mode = (event as CustomEvent<string>).detail;
    page.querySelectorAll<HTMLElement>(".after [data-for]").forEach((el) => (el.hidden = el.dataset.for !== mode));
  });

  // This week open, or the week a new request would land in (worker/index.js). While a queue stands, "within 48 hours"
  // isn't true from today, so that token steps aside. Nothing shows if the request fails.
  const status = document.querySelector<HTMLButtonElement>("[data-status]");
  const statusText = status?.querySelector<HTMLElement>("[data-status-text]");
  const in48 = document.querySelector<HTMLElement>("[data-in-48]");
  fetch("/api/review", { headers: { Accept: "application/json" } })
    .then((res) => (res.ok ? res.json() : null))
    // The dev server has no Worker behind /api: there the week shows as open, so the header can be looked at locally.
    .then((s: { queue?: number; week?: string } | null) => s ?? (import.meta.env.DEV ? { queue: 0 } : null))
    .then((s) => {
      if (!status || !statusText || !s) return;
      const queue = Number(s.queue) || 0;
      const ahead = queue > 0 && !!s.week;
      // The limit is its own piece, so the narrowest phones can drop it rather than wrap the header.
      if (ahead) statusText.textContent = `Now booking the week of ${weekLabel(s.week!)}`;
      else statusText.replaceChildren("Open this week", Object.assign(document.createElement("span"), { className: "limit", textContent: " · 3 reviews a week" }));
      status.classList.toggle("is-open", !ahead);
      // Open, the limit is in the words; with a queue it's the tip under the date, and only then the status takes focus.
      status.classList.toggle("has-tip", ahead);
      status.tabIndex = ahead ? 0 : -1;
      if (ahead) status.setAttribute("aria-describedby", "review-weekly");
      else status.removeAttribute("aria-describedby");
      status.hidden = false;
      if (queue > 0 && in48) in48.hidden = true;
    })
    .catch(() => {});
  // On a phone there's no hover: a tap shows the limit for a moment.
  let tipTimer = 0;
  status?.addEventListener("click", () => {
    if (!status.classList.contains("has-tip")) return;
    status.classList.add("is-tip");
    clearTimeout(tipTimer);
    tipTimer = window.setTimeout(() => status.classList.remove("is-tip"), 2600);
  });

  // "What I see, what I'd do, what it would cost" points at the same numbers on the screen: hovering (or tapping) one
  // makes its mark jump. 3 is said in the video, so it's the camera.
  document.querySelectorAll<HTMLElement>(".contents [data-n]").forEach((item) => {
    item.addEventListener("pointerenter", () => {
      const mark = item.dataset.n === "3" ? document.querySelector<HTMLElement>(".cam i") : document.querySelector<HTMLElement>(`[data-pt="${item.dataset.n}"]`);
      if (!mark || mark.hidden) return;
      mark.classList.remove("is-ping");
      void mark.offsetWidth;
      mark.classList.add("is-ping");
    });
  });
</script>

<style>
  /* The offer on the left, read first; the screen-form on the right, as tall as the window allows. The form's column
     is no wider than the form (16 by 10 and the tab strip, about 4% of the width more, and the dock under it), and on a
     window wider than both the pair sits in the middle instead of leaving the right side empty. The page stretches to
     the window's height (Site.astro): the rows stay at the top, the space goes under them. */
  .review {
    display: grid;
    grid-template-columns: 430px minmax(0, calc((100vh - 250px) * 1.5 + 36px));
    grid-template-columns: 430px minmax(0, calc((100svh - 250px) * 1.5 + 36px));
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "offer form"
      "after form";
    gap: 28px 64px;
    justify-content: center;
    align-content: start;
    align-items: start;
  }
  .offer {
    grid-area: offer;
    display: grid;
    gap: 22px;
  }
  .after {
    grid-area: after;
    display: grid;
    gap: 10px;
    padding-top: 6px;
    font-size: var(--text-meta);
    line-height: 1.45;
  }
  .form {
    grid-area: form;
    width: 100%;
  }

  .status {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 500;
    letter-spacing: inherit;
    cursor: default;
  }
  .status:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 4px;
  }
  /* The limit under the status, with a queue: on hover, keyboard focus, or a tap. */
  .tip {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: max-content;
    padding: 6px 10px;
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--raise);
    font-size: 12px;
    opacity: 0;
    translate: 0 -4px;
    pointer-events: none;
    transition: opacity 180ms ease-out, translate 180ms ease-out;
  }
  .status.has-tip:focus-visible .tip,
  .status.has-tip.is-tip .tip {
    opacity: 1;
    translate: 0 0;
  }
  /* Hover only where there is one: on a phone a tap would leave it stuck on. */
  @media (hover: hover) {
    .status.has-tip:hover .tip {
      opacity: 1;
      translate: 0 0;
    }
  }
  .status[hidden] {
    display: none;
  }
  /* Under 360px the line wouldn't fit next to the wordmark: the limit gives way. */
  @media (max-width: 359px) {
    .status :global(.limit) {
      display: none;
    }
  }
  .status::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-black) 10%, transparent);
  }
  /* Open this week: a slow emerald pulse, like a live light. Emerald only moves, so with reduced motion the dot stays
     ink; a week ahead it stays ink too. */
  .status.is-open::before {
    background: var(--emerald);
    animation: live 2.8s ease-out infinite;
  }
  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--emerald) 45%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px color-mix(in srgb, var(--emerald) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status.is-open::before {
      background: var(--ink);
      animation: none;
    }
  }

  .who {
    margin: 0;
    font-size: var(--text-meta);
    opacity: 0.6;
    text-wrap: pretty;
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 2.9vw, 42px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.062em;
  }
  /* Each sentence starts its own line and wraps evenly, so no word hangs alone. */
  h1 span {
    display: block;
    text-wrap: balance;
  }

  /* The terms as flat outlined tokens: the promise as tags instead of sentences. Flat on purpose: a raised white pill
     is a control on these pages (the panel on /glass), and these don't press. */
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .terms li {
    padding: 6px 12px;
    border: 0.5px solid color-mix(in srgb, var(--color-black) 30%, transparent);
    border-radius: 999px;
    font-size: var(--text-meta);
    font-weight: 500;
    white-space: nowrap;
  }
  .terms li[hidden] {
    display: none;
  }

  .after p {
    margin: 0;
    text-wrap: pretty;
  }
  .after p[hidden] {
    display: none;
  }
  .after .price {
    margin-top: -4px;
  }
  .after p:not(.contents) {
    opacity: 0.6;
  }
  .contents {
    font-size: 15px;
    font-weight: 500;
  }
  /* Each number points at its mark on the screen (the script makes it jump); on hover the number fills in. A number
     never ends a line apart from its words: the line breaks between the parts, not inside one. */
  .contents span {
    cursor: default;
    white-space: nowrap;
  }
  @media (hover: hover) {
    .contents span:hover::before {
      background: var(--ink);
      color: var(--color-off-white);
    }
  }
  .contents span::before {
    transition: background-color 150ms ease-out, color 150ms ease-out;
    content: attr(data-n);
    display: inline-grid;
    place-items: center;
    width: 19px;
    height: 19px;
    margin-right: 5px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 1px;
  }

  /* Tablets and phones: one column — the offer, what's in a review and what comes after, then the form, so the price
     at the end is read before sending. Below 1100px two columns leave the screen too little room. The column is as
     wide as the form at most, in the middle of a wider window, so the text and the form share their edges. */
  @media (max-width: 1100px) {
    .review {
      grid-template-columns: minmax(0, 760px);
      grid-template-rows: none;
      grid-template-areas: "offer" "after" "form";
    }
  }
  @media (max-width: 560px) {
    h1 span {
      display: inline;
    }
    /* Two by two on a phone, so no tag is left alone on its own line; the cells share a width, so the words sit in
       the middle. */
    .terms {
      display: grid;
      grid-template-columns: repeat(2, max-content);
    }
    .terms li {
      text-align: center;
    }
    /* With a queue "Within 48 hours" steps aside: the third tag takes the row and sits in the middle. */
    .terms:has([data-in-48][hidden]) li:last-child {
      grid-column: 1 / -1;
      justify-self: center;
    }
  }
</style>
