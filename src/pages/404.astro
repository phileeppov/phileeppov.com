---
// 404: site.md §6, laid out as the wall (site.css): the line is the one statement, the link a caption on its last
// baseline in the caption half. The link has no arrow: under a moving pointer the emerald comes out after its words
// (src/scripts/emerald.js).
import Site from "../layouts/Site.astro";
---

<Site passage title="Not found" description="This page has no author.">
  <main class="wall lost">
    <section class="grid">
      <h1 class="statement"><span>This page has</span> <span>no <em>author</em>.</span></h1>
      <a class="link" href="/" data-gem>Back to the start</a>
    </section>
  </main>
</Site>

<style>
  .grid {
    align-items: last baseline;
    padding-top: 72px;
  }
  h1 {
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .link {
    grid-column: 7 / -1;
    grid-row: 1;
    justify-self: start;
  }
  @media (max-width: 767px) {
    .link {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 32px;
    }
  }
  @media (max-width: 560px) {
    .grid {
      padding-top: 48px;
    }
  }
</style>
