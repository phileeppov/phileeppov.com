---
// Layout for the Onest pages of the site: home, manifesto, about, 404 and /review.
// Onest with −4% tracking, like /glass. Header: the wordmark to the home page; X and the rest are in the footer, so
// "phileeppov" isn't repeated up top. The right side of the header is the "aside" slot (on /review, whether this week
// is open); pages that don't fill it get the X handle and the "Work with me" pill to /review, as on /glass.
// Footer: site.md §1.7. Links marked data-count are counted when followed (src/scripts/review-count.ts).
// The emerald on links and dark buttons (src/scripts/emerald.js) and the emerald cursor (src/scripts/emerald-cursor.js)
// start here for every page that marks its links data-gem; on touch screens only the first, for the press.
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import Passage from "../components/Passage.astro";
import SlotSwitch from "../components/SlotSwitch.astro";
import { person } from "../data/facts";
import "../styles/onest.css";
import "../styles/site.css";

interface Props {
  title?: string;
  description: string;
  image?: string;
  imageSize?: [number, number]; // the preview image's size when it isn't 1200×630 (the case pages)
  passage?: boolean; // the page opens and closes as a disc of glass from the pressed arrow (Passage.astro)
  view?: "story" | "facts"; // a view of the home page: the wordmark's slot holds the switch between the two
}

const { title, description, image, imageSize, passage = false, view } = Astro.props;
const aside = Astro.slots.has("aside");
---

<Base title={title} description={description} image={image} imageSize={imageSize} bare>
  {
    /* Until the stamp gives the site its own icon (site.md, before launch), pages without one use the smile from /review. */
    Astro.slots.has("head") ? (
      <slot name="head" slot="head" />
    ) : (
      <Fragment slot="head">
        <link rel="icon" type="image/png" sizes="64x64" href="/review-favicon.png" />
        <link rel="apple-touch-icon" href="/review-touch-icon.png" />
        {passage && <Passage />}
      </Fragment>
    )
  }
  {
    view ? (
      <Fragment>
        {/* The two views of the home page: the wordmark is split around its slot, and the slot holds the switch. The
            switch is a child of the page rather than of the header, so it can stay pinned while the word scrolls away. */}
        <SlotSwitch current={view} />
        <header class="top2" data-gem-off={view === "facts" ? "" : undefined}>
          <div class="side l">
            {view === "facts" ? <a class="handle" href={person.linkedin} data-count="work:linkedin">LinkedIn</a> : <a class="handle" href="https://x.com/phileeppov" data-count="site:x">@phileeppov</a>}
            <a class="w" href="/" aria-label="phileeppov, home">phil</a>
          </div>
          <span class="gap" aria-hidden="true"></span>
          <div class="side r">
            <a class="w" href="/" tabindex="-1" aria-hidden="true">ppov</a>
            {view === "facts" ? <a class="work" href={person.cv} download data-count="work:cv">Download CV</a> : <a class="work" href="/review/" data-count="site:pill">Work with me</a>}
          </div>
        </header>
      </Fragment>
    ) : (
      <header class="top">
        <a class="mark" href="/" aria-label="phileeppov, home">phil<i>ee</i>ppov</a>
        {
          aside ? (
            <slot name="aside" />
          ) : (
            <nav>
              <a class="handle" href="https://x.com/phileeppov" data-count="site:x">@phileeppov</a>
              <a class="work" href="/review/" data-count="site:pill">Work with me</a>
            </nav>
          )
        }
      </header>
    )
  }
  <slot />
  {view !== "facts" && <Footer />}
  <!-- No one-letter word (and no "an") left hanging at the end of a line: the space after it becomes non-breaking.
       Inline, so it runs as the page is parsed, before the first paint. Only on the wall pages: /review sets its
       breaks by hand. -->
  <script is:inline>
    (() => {
      const main = document.querySelector("body > main.wall");
      if (!main) return;
      const walk = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
      for (let n = walk.nextNode(); n; n = walk.nextNode()) {
        const t = n.nodeValue.replace(/(^|[\s(])(a|an|A|An|I)\s+(?=\S)/g, "$1$2\u00a0");
        if (t !== n.nodeValue) n.nodeValue = t;
      }
    })();
  </script>
</Base>

<script>
  import { count } from "../scripts/review-count";

  // Which way out was taken: each name once a visit, nothing else sent.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.<HTMLElement>("[data-count]");
    if (link?.dataset.count) count(link.dataset.count);
  });

  // The emeralds, on the arrows and as the cursor, where a hand moves a fine pointer over a wide screen; on a touch
  // screen only the stone under the finger while it presses, no cursor. They load after the page, at idle, and build
  // their shaders off the main thread. Pages without data-gem (/review, with its own pointer play) keep the system
  // cursor, and so does anyone who asked the system for less motion, more contrast or forced colours (a large system
  // cursor often comes with them).
  const calm = "(prefers-reduced-motion: no-preference) and (forced-colors: none) and (prefers-contrast: no-preference)";
  const wide = matchMedia(`(min-width: 1024px) and (hover: hover) and (pointer: fine) and ${calm}`);
  const touch = matchMedia(`(hover: none) and (pointer: coarse) and ${calm}`);
  const isWide = wide.matches;
  if ((isWide || touch.matches) && document.querySelector("[data-gem]")) {
    const go = () => {
      if (isWide) {
        import("../scripts/emerald.js").then((m) => m.startEmerald());
        import("../scripts/emerald-cursor.js").then((m) => m.startCursor());
        import("../scripts/glint.js").then((m) => m.startGlint());
      } else import("../scripts/emerald.js").then((m) => m.startEmerald({ touch: true }));
    };
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1500 });
    else setTimeout(go, 300);
  }
</script>

<style is:global>
  /* :root and html body win over the base styles in Base.astro whatever order the bundles load in. */
  :root {
    font-family: var(--font-ui);
    letter-spacing: var(--tracking-ui);
  }
  html body {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 16px 24px 24px;
  }
  body > main {
    flex: 1;
    max-width: none;
  }
</style>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 40px;
    font-size: var(--text-meta);
  }
  /* On a window wider than the wall, the header stops with the wall's grid, 1392px in the middle, as on the home page,
     so the links on the right stand over the grid's edge on every wall page. /review centres its own page and keeps
     the full width. */
  :global(body:has(> main.wall)) .top {
    width: 100%;
    max-width: 1392px;
    margin-inline: auto;
  }
  .top a {
    color: inherit;
    text-decoration: none;
    transition: opacity 120ms ease-out, filter 120ms ease-out;
  }
  .mark {
    font-size: 17px;
    font-weight: 500;
  }
  .mark:hover {
    opacity: 0.6;
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .handle:hover {
    opacity: 0.6;
  }
  /* Under 340px the handle gives way, as on /glass. */
  @media (max-width: 340px) {
    .handle {
      display: none;
    }
  }
  /* The same raised pill as on /glass. */
  .work {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--raise);
    font-weight: 500;
  }
  .work:hover {
    filter: brightness(1.03);
  }
  .work:active {
    transform: scale(0.98);
  }
  .mark i {
    font-family: var(--font-anomaly);
    letter-spacing: 0;
  }
  .top a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 999px;
  }
  @media (max-width: 560px) {
    .top {
      margin-bottom: 32px;
    }
  }

  /* The home page's header: the wordmark split around the slot on the wall's middle, the same height as the header above,
     so the page under it stands where it did. The slot's width comes from the switch (SlotSwitch.astro). */
  .top2 {
    --slot-gap: 44px;
    display: grid;
    grid-template-columns: 1fr var(--slot-gap) 1fr;
    align-items: center;
    width: 100%;
    max-width: 1392px;
    margin-inline: auto;
    height: 29px;
    margin-bottom: 40px;
    font-size: var(--text-meta);
  }
  .top2 a {
    color: inherit;
    text-decoration: none;
    transition: opacity 120ms ease-out, filter 120ms ease-out;
  }
  .side {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
  }
  .w {
    font-size: 22px;
    font-weight: 500;
  }
  .top2 .w {
    transition: opacity 120ms ease-out, transform 240ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  /* The p of "ppov" starts further from its edge than the l of "phil" ends: this evens the two gaps to the switch. */
  .top2 .side.r .w {
    margin-left: -0.7px;
  }
  /* The switch opens under a hand with both names in it: the word parts to let it through and closes after. */
  :global(html[data-slot-open]) .top2 .side.l .w {
    transform: translateX(calc(var(--part, 0px) * -1));
  }
  :global(html[data-slot-open]) .top2 .side.r .w {
    transform: translateX(var(--part, 0px));
  }
  @media (prefers-reduced-motion: reduce) {
    .top2 .w {
      transition: none;
    }
  }
  .top2 .work {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--raise);
    font-weight: 500;
  }
  .top2 .handle:hover,
  .top2 .w:hover {
    opacity: 0.6;
  }
  .top2 .work:hover {
    filter: brightness(1.03);
  }
  .top2 a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 999px;
  }
  /* The halves of the word stand 2px from the switch: their ring sits tight, so it doesn't run over it. */
  .top2 .w:focus-visible {
    outline-offset: 0;
    border-radius: 4px;
  }
  /* On a phone the header holds only the name and the switch: the rest is on the page under it. */
  @media (max-width: 767px) {
    .top2 {
      margin-bottom: 32px;
    }
    .top2 .handle,
    .top2 .work {
      display: none;
    }
    .side.l {
      justify-content: flex-end;
    }
    .side.r {
      justify-content: flex-start;
    }
  }
</style>
